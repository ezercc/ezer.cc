---
import Layout from "../layouts/Layout.astro";
import { premiumPlan } from "../data/pricing";

interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
const isEnglish = lang === "en";
const prefix = isEnglish ? "/en" : "";
const alipaySupportedPlans = premiumPlan.paymentMethods.alipay.supportedPlans;
const isAlipaySupported = (cycleId: string) =>
  alipaySupportedPlans.includes(
    (cycleId === "yearly" ? "annual" : cycleId) as (typeof alipaySupportedPlans)[number],
  );

const copy = isEnglish
  ? {
      title: "Ezer Premium",
      description:
        "Early access for a higher-quota version of Ezer's evidence-linked financial-statement research software.",
      eyebrow: "Paid subscription · early access",
      intro:
        "Premium is being prepared for launch. You can request early access now; the waitlist does not collect payment or create a subscription.",
      featuresTitle: "Premium access",
      features: [
        "Higher monthly financial-statement research quota",
        "Multi-stage review with evidence and source references",
        "Structured digital reports in your Ezer account",
        "Customer support for billing and delivery",
      ],
      deliveryTitle: "Digital delivery",
      deliveryText:
        "After paid launch, access will normally activate immediately after a successful payment.",
      cancelTitle: "Cancel any time",
      cancelText:
        "Monthly subscriptions may be cancelled at any time and remain available through the current paid period.",
      refundTitle: "7-day first-charge window",
      refundText:
        "Eligible first subscription charges may be refunded when requested within seven calendar days.",
      request: "Subscribe",
      loading: "Submitting…",
      signIn: "Sign in to subscribe",
      success: "Your early-access request has been recorded.",
      duplicate: "You are already on the early-access list.",
      error:
        "We could not save the request. Please try again or email support.",
      signedInAs: "Signed in as",
      demo: "Try the free demo",
      legalPrefix: "By requesting access, you acknowledge the",
      terms: "Terms",
      privacy: "Privacy Policy",
      refunds: "Refund and Cancellation Policy",
      delivery: "Digital Delivery Policy",
      support: "Questions? Email joe@ezerlab.org",
      paymentMethodLabel: "Payment method",
      card: "Card",
      alipay: "Alipay",
      alipayUnavailable:
        "Alipay is available for quarterly and yearly plans only.",
      unsupportedPaymentMethod:
        "This payment method is not available for the selected plan.",

      // Billing cycles data
      cycles: [
        {
          id: "monthly",
          title: "Monthly",
          price: "$4.99",
          oldPrice: "$7.99",
          detail: "Billed monthly",
          badge: "",
          classSuffix: "lite",
        },
        {
          id: "quarterly",
          title: "Quarterly",
          price: "$3.66",
          oldPrice: "$6.66",
          detail:
            "Billed quarterly ($10.99)\nsave approx. $4 compared to Monthly",
          badge: "Most Popular",
          classSuffix: "pro",
        },
        {
          id: "yearly",
          title: "Yearly",
          price: "$3.25",
          oldPrice: "$4.99",
          detail: "Billed yearly ($39)\nsave approx. $20 compared to Monthly",
          badge: "Best Value",
          classSuffix: "max",
        },
      ],
    }
  : {
      title: "弈泽专业版",
      description: "申请弈泽证据可追溯财报研究软件高额度版本的早期体验。",
      eyebrow: "付费订阅 · 早期体验",
      intro:
        "专业版正在准备上线。你现在可以申请早期体验；加入名单不会扣款，也不会建立付费订阅。",
      featuresTitle: "专业版能力",
      features: [
        "更高的每月财报研究额度",
        "带证据和来源线索的多阶段复核",
        "在弈泽账户中交付结构化数字报告",
        "账单与数字交付客户支持",
      ],
      deliveryTitle: "数字交付",
      deliveryText: "付费订阅上线后，支付成功通常会立即激活对应账户权限。",
      cancelTitle: "可随时取消",
      cancelText: "月度订阅可随时取消，并可使用至当前已付费周期结束。",
      refundTitle: "首次扣款 7 天窗口",
      refundText: "符合条件的首次订阅扣款可在七个自然日内申请退款。",
      request: "立即订阅",
      loading: "正在提交…",
      signIn: "登录后订阅",
      success: "已记录你的早期体验申请。",
      duplicate: "你已经在早期体验名单中。",
      error: "暂时无法保存申请，请重试或通过邮件联系支持。",
      signedInAs: "当前账户",
      demo: "体验免费演示",
      legalPrefix: "订阅专业版计划即表示你已知悉",
      terms: "服务条款",
      privacy: "隐私政策",
      refunds: "退款与取消政策",
      delivery: "数字交付政策",
      support: "如有疑问，请发送邮件至 joe@ezerlab.org",
      paymentMethodLabel: "支付方式",
      card: "银行卡",
      alipay: "支付宝",
      alipayUnavailable: "支付宝仅支持季度计划及以上。",
      unsupportedPaymentMethod: "所选计划暂不支持此支付方式。",

      // Billing cycles data
      cycles: [
        {
          id: "monthly",
          title: "月付计划",
          price: "￥29.99",
          oldPrice: "￥49.99",
          detail: "按月结算",
          badge: "",
          classSuffix: "lite",
        },
        {
          id: "quarterly",
          title: "季付计划",
          price: "￥23.33",
          oldPrice: "￥39.66",
          detail: "每 3 个月结算 ￥69.99\n较月付计划共省约 ￥20",
          badge: "最受欢迎",
          classSuffix: "pro",
        },
        {
          id: "yearly",
          title: "年付计划",
          price: "￥20.75",
          oldPrice: "￥33.16",
          detail: "每 12 个月结算 ￥249\n较月付计划共省约 ￥110",
          badge: "最划算",
          classSuffix: "max",
        },
      ],
    };

const signInUrl = `https://account.ezer.cc/${isEnglish ? "en/" : ""}login/`;
---

<Layout
  title={copy.title}
  description={copy.description}
  keywords={isEnglish
    ? "Ezer Premium, financial statement research software, digital subscription"
    : "弈泽专业版, 财报研究软件, 数字订阅"}
>
  <section class="premium">
    <canvas id="tubes-cursor-canvas" class="tubes-cursor-canvas"></canvas>
    <!-- Cancel Banner -->
    <div
      id="payment-cancel-banner"
      class="payment-banner payment-banner--error"
      hidden
    >
      <div class="payment-banner__content">
        <span class="payment-banner__text"></span>
        <button
          id="close-cancel-banner-btn"
          class="payment-banner__close"
          type="button"
          aria-label="Close"
        >
          &times;
        </button>
      </div>
    </div>

    <div class="u-container premium__inner">
      <div class="premium__intro">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>

      <!-- Subscription Details Section -->
      <div class="premium__details">
        <h2>{copy.featuresTitle}</h2>
        <div class="details-content-grid">
          <ul class="features">
            {copy.features.map((feature) => <li>{feature}</li>)}
          </ul>

          <div class="policy-grid">
            <a href={`${prefix}/delivery-policy/`}>
              <strong>{copy.deliveryTitle}</strong>
              <span>{copy.deliveryText}</span>
            </a>
            <a href={`${prefix}/refund-and-cancellation/`}>
              <strong>{copy.cancelTitle}</strong>
              <span>{copy.cancelText}</span>
            </a>
            <a href={`${prefix}/refund-and-cancellation/`}>
              <strong>{copy.refundTitle}</strong>
              <span>{copy.refundText}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Active Premium User Container -->
      <div id="active-premium-container" class="active-premium-container" hidden>
        <div class="active-card">
          <div class="active-card__icon"><i class="fa-solid fa-crown"></i></div>
          <p class="active-card__message">
            {
              isEnglish ? (
                <>
                  You currently have active Premium,{" "}
                  <a href={`${prefix}/search/`} class="active-card__link">
                    experience it now
                  </a>
                </>
              ) : (
                <>
                  您当前已开通专业版，{" "}
                  <a href={`${prefix}/search/`} class="active-card__link">
                    立即体验
                  </a>
                </>
              )
            }
          </p>
          <a href={`https://account.ezer.cc/${isEnglish ? "en/" : ""}`} class="active-card__btn">
            {isEnglish ? "Manage Subscription / Search" : "管理订阅/去搜索"}
          </a>
        </div>
      </div>

      <!-- Redesigned Three-Billing-Cycle Cards -->
      <div id="premium-pricing-grid" class="pricing-grid">
        {
          copy.cycles.map((cycle) => (
            <div class={`pricing-card pricing-card--${cycle.classSuffix}`}>
              {cycle.badge && <span class="card-badge">{cycle.badge}</span>}
              <div class="card-header">
                <h3 class="card-title">{cycle.title}</h3>
              </div>

              <div class="price-wrapper">
                <div class="price-row">
                  <span class="price-current">
                    {cycle.id !== "monthly" && (
                      <span class="price-approx">~</span>
                    )}
                    {cycle.price}
                  </span>
                  <span class="price-slash">/ {isEnglish ? "mo" : "月"}</span>
                  {cycle.oldPrice && (
                    <span class="price-original">
                      {cycle.id !== "monthly" && (
                        <span class="price-approx-small">~</span>
                      )}
                      {cycle.oldPrice}/{isEnglish ? "mo" : "月"}
                    </span>
                  )}
                </div>
                <p class="price-billing-detail">
                  {cycle.detail.split("\n").map((line, idx) => (
                    <>
                      {idx > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
              </div>

              <button
                type="button"
                class="subscribe-btn"
                data-cycle={cycle.title}
                data-plan-key={`${isEnglish ? "en" : "zh"}_${cycle.id === "yearly" ? "annual" : cycle.id}`}
                data-default-text={copy.request}
              >
                <span class="btn-text">{copy.request}</span>
                <span class="loader" aria-hidden="true" hidden />
              </button>
              {!isEnglish && (
                <fieldset class="payment-methods">
                  <legend>{copy.paymentMethodLabel}</legend>
                  <label class="payment-method">
                    <input
                      type="radio"
                      name={`payment-method-${cycle.id}`}
                      value="card"
                      data-payment-method="card"
                      checked
                    />
                    <span class="payment-method__label">
                      <span>{copy.card}</span>
                      <span
                        class="payment-method__icons payment-method__icons--cards"
                        aria-label="Visa and Mastercard"
                      >
                        <img src="/payment-icons/visa.svg" alt="Visa" />
                        <img
                          src="/payment-icons/mastercard.svg"
                          alt="Mastercard"
                        />
                      </span>
                    </span>
                  </label>
                  <label
                    class:list={[
                      "payment-method",
                      !isAlipaySupported(cycle.id) &&
                        "payment-method--disabled",
                    ]}
                  >
                    <input
                      type="radio"
                      name={`payment-method-${cycle.id}`}
                      value="alipay"
                      data-payment-method="alipay"
                      disabled={!isAlipaySupported(cycle.id)}
                    />
                    <span class="payment-method__label">
                      <span>{copy.alipay}</span>
                      <span class="payment-method__icons">
                        <img src="/payment-icons/alipay.svg" alt="支付宝" />
                      </span>
                    </span>
                  </label>
                  {!isAlipaySupported(cycle.id) && (
                    <small class="payment-methods__hint">
                      {copy.alipayUnavailable}
                    </small>
                  )}
                </fieldset>
              )}
            </div>
          ))
        }
      </div>

      <!-- Feedback / Messages -->
      <div class="feedback-section" hidden>
        <p id="user-display-email" class="user-email" hidden></p>
        <p id="waitlist-message" class="waitlist-message" hidden></p>
      </div>

      <div>
        <p class="legal-copy">
          {copy.legalPrefix}
          <a href={`${prefix}/terms/`}>{copy.terms}</a>
          {isEnglish ? ", " : "、"}
          <a href={`${prefix}/privacy/`}>{copy.privacy}</a>
          {isEnglish ? ", " : "、"}
          <a href={`${prefix}/refund-and-cancellation/`}>{copy.refunds}</a>
          {isEnglish ? ", and " : "及"}
          <a href={`${prefix}/delivery-policy/`}>{copy.delivery}</a>
          {isEnglish ? "." : "。"}
        </p>
        <div class="secondary-actions">
          <a href={`${prefix}/check/?preview=true`}>{copy.demo}</a>
          <a href="mailto:joe@ezerlab.org">{copy.support}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .premium {
    min-height: 100vh;
    padding: 8rem 0 6rem;
    background:
      radial-gradient(
        circle at 15% 5%,
        rgba(var(--rgb-brand-1), 0.18),
        transparent 35rem
      ),
      radial-gradient(
        circle at 90% 80%,
        rgba(130, 99, 255, 0.12),
        transparent 35rem
      ),
      #090a0f;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .tubes-cursor-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    width: 100% !important;
    height: 100% !important;
  }

  .premium__inner {
    max-width: 60rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .premium__intro {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #a999ff;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }

  .lead {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* Redesigned Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 1.25rem;
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
    border-radius: 1.25rem;
    background: rgba(17, 18, 22, 0.45);
    backdrop-filter: blur(8px) saturate(120%);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.15),
      0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  /* Gradient border strictly drawn only at the edge using mask composite */
  .pricing-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
    padding: 1px; /* border thickness */
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.35),
      rgba(255, 255, 255, 0.02)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 3;
    transition: background 0.3s ease;
  }

  /* Sleek top highlight line (internal glow) */
  .pricing-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.7) 50%,
      transparent
    );
    filter: blur(0.5px);
    z-index: 2;
  }

  /* Card 2: Pro Card Glow & Highlight */
  .pricing-card--pro {
    background:
      linear-gradient(to bottom, rgba(139, 115, 245, 0.15), transparent 38%)
        padding-box,
      rgba(20, 21, 26, 0.5);
  }
  .pricing-card--pro::after {
    background: linear-gradient(
      to bottom,
      rgba(139, 115, 245, 0.4),
      rgba(139, 115, 245, 0.02)
    );
  }
  .pricing-card--pro::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.8) 50%,
      transparent
    );
  }

  /* Card 3: Max Card Glow & Highlight */
  .pricing-card--max {
    background:
      linear-gradient(to bottom, rgba(241, 196, 15, 0.15), transparent 40%)
        padding-box,
      rgba(22, 23, 28, 0.5);
  }
  .pricing-card--max::after {
    background: linear-gradient(
      to bottom,
      rgba(241, 196, 15, 0.4),
      rgba(241, 196, 15, 0.02)
    );
  }
  .pricing-card--max::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(241, 196, 15, 0.8) 50%,
      transparent
    );
  }

  /* Card hovers */
  .pricing-card:hover {
    transform: translateY(-0.25rem);
    background: rgba(17, 18, 22, 0.6);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.25),
      0 16px 48px 0 rgba(0, 0, 0, 0.5);
  }
  .pricing-card:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.45),
      rgba(255, 255, 255, 0.04)
    );
  }
  .pricing-card--pro:hover {
    background:
      linear-gradient(to bottom, rgba(139, 115, 245, 0.3), transparent 38%)
        padding-box,
      rgba(20, 21, 26, 0.65);
  }
  .pricing-card--pro:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(139, 115, 245, 0.55),
      rgba(139, 115, 245, 0.04)
    );
  }
  .pricing-card--max:hover {
    background:
      linear-gradient(to bottom, rgba(241, 196, 15, 0.3), transparent 40%)
        padding-box,
      rgba(22, 23, 28, 0.65);
  }
  .pricing-card--max:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(241, 196, 15, 0.55),
      rgba(241, 196, 15, 0.04)
    );
  }

  .card-header {
    display: flex;
    align-items: center;
    margin-bottom: 2rem;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }

  .card-badge {
    position: absolute;
    top: 16px;
    right: -36px;
    width: 140px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(45deg);
    font-size: 0.65rem;
    font-weight: 800;
    text-align: center;
    pointer-events: none;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .pricing-card--pro .card-badge {
    background: linear-gradient(135deg, #8b73ff, #6f52ff);
    color: #ffffff;
  }

  .pricing-card--max .card-badge {
    background: linear-gradient(135deg, #f1c40f, #e5c158);
    color: #111216;
  }

  .price-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  .price-current {
    font-size: 2.2rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .pricing-card--max .price-current {
    color: #f1c40f;
  }

  .price-slash {
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.95rem;
    font-weight: 400;
  }

  .price-original {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.85rem;
    text-decoration: line-through;
    font-weight: 400;
  }

  .price-approx {
    font-size: 1.5rem;
    color: #fff;
    margin-right: 0.05rem;
    font-weight: 400;
  }

  .price-approx-small {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    margin-right: 0.02rem;
    font-weight: 400;
    text-decoration: none;
    display: inline-block;
  }

  .price-billing-detail {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    line-height: 1.5rem;
    margin-top: 0.5rem;
    white-space: pre-line;
  }

  /* Buttons styling matching the screen design */
  .subscribe-btn {
    width: 100%;
    min-height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 0;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .subscribe-btn:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .payment-methods {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    margin: 0.9rem 0 0;
    padding: 0;
    border: 0;
  }

  .payment-methods legend {
    width: 100%;
    margin-bottom: 0.15rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.72rem;
  }

  .payment-method {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .payment-method__label,
  .payment-method__icons {
    display: inline-flex;
    align-items: center;
  }

  .payment-method__label {
    gap: 0.35rem;
  }

  .payment-method__icons {
    gap: 0.2rem;
  }

  .payment-method__icons img {
    box-sizing: border-box;
    width: 1.7rem;
    height: 1.1rem;
    padding: 0.1rem 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 0.2rem;
    background: #fff;
    object-fit: contain;
  }

  .payment-method__icons--cards {
