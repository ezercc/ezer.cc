---
import Layout from "../layouts/Layout.astro";
import { premiumPlan } from "../data/pricing";

interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
const isEnglish = lang === "en";
const prefix = isEnglish ? "/en" : "";
const alipaySupportedPlans = premiumPlan.paymentMethods.alipay.supportedPlans;
const isAlipaySupported = (cycleId: string) =>
  alipaySupportedPlans.includes(
    (cycleId === "yearly" ? "annual" : cycleId) as (typeof alipaySupportedPlans)[number],
  );

const copy = isEnglish
  ? {
      title: "Ezer Premium",
      description:
        "Subscribe Ezer Premium for a higher-quota version of evidence-linked financial-statement research software.",
      eyebrow: "Paid Subscription · Limited-Time Offer",
      featuresTitle: "Premium access",
      features: [
        "Higher monthly financial-statement research quota",
        "Multi-stage review with evidence and source references",
        "Structured digital reports in your Ezer account",
        "Customer support for billing and delivery",
      ],
      deliveryTitle: "Digital delivery",
      deliveryText:
        "After paid launch, access will normally activate immediately after a successful payment.",
      cancelTitle: "Cancel any time",
      cancelText:
        "Monthly subscriptions may be cancelled at any time and remain available through the current paid period.",
      refundTitle: "7-day first-charge window",
      refundText:
        "Eligible first subscription charges may be refunded when requested within seven calendar days.",
      request: "Subscribe",
      loading: "Submitting…",
      signIn: "Sign in to subscribe",
      success: "Your early-access request has been recorded.",
      duplicate: "You are already on the early-access list.",
      error:
        "We could not save the request. Please try again or email support.",
      signedInAs: "Signed in as",
      demo: "Try the free demo",
      legalPrefix: "By requesting access, you acknowledge the",
      terms: "Terms",
      privacy: "Privacy Policy",
      refunds: "Refund and Cancellation Policy",
      delivery: "Digital Delivery Policy",
      support: "Questions? Email contact@ezer.cc",
      paymentMethodLabel: "Payment method",
      card: "Card",
      alipay: "Alipay",
      alipayUnavailable:
        "Alipay is available for quarterly and yearly plans only.",
      unsupportedPaymentMethod:
        "This payment method is not available for the selected plan.",

      freePlan: {
        tag: "Basic Access",
        title: "Free",
        description:
          "Experience audit-grade financial statement analysis at zero cost with open evidence tracing.",
        price: "$0",
        period: "mo",
        actionText: "Try Free Demo",
        features: [
          { text: "3 comprehensive report analyses per month", included: true },
          { text: "Basic audit-chain workflow and metrics overview", included: true },
          { text: "Fully open evidence chains line-by-line verified", included: true },
          { text: "High-value multi-model deep verification pipeline", included: false },
          { text: "Historical report archive & persistent tracking", included: false },
          { text: "Export professional audit PDF reports", included: false },
        ],
      },
      proPlan: {
        tag: "In-Depth Research",
        badge: "Limited Offer",
        title: "Premium",
        description:
          "Built for analysts and investors requiring higher quotas, multi-stage audit review, and structured reports.",
        pricePrefix: "From",
        price: "$3.25",
        period: "mo",
        priceNote: "Save up to $20 on annual plans",
        actionText: "Select Billing Cycle",
        features: [
          { text: "Substantially higher monthly research quotas", included: true },
          { text: "High-value top-tier model chain cross-review", included: true },
          { text: "Multi-stage audit review & rigorous reasoning check", included: true },
          { text: "Structured digital reports delivered in your account", included: true },
          { text: "Dedicated priority customer support & service channel", included: true },
          { text: "Early access to upcoming PDF exports and advanced tools", included: true },
        ],
      },
      enterprisePlan: {
        tag: "Institutional",
        title: "Enterprise",
        description:
          "Customized multi-seat research pipeline and bespoke financial data intelligence for teams and institutions.",
        pricePrefix: "",
        price: "Custom",
        period: "bespoke",
        actionText: "Contact Us",
        actionUrl: `${prefix}/contact/`,
        features: [
          { text: "Everything in Premium plan included", included: true },
          { text: "Unlimited research quota & custom concurrency", included: true },
          { text: "Proprietary research integration with internal knowledge bases", included: true },
          { text: "Dedicated API access or private on-premise deployment", included: true },
          { text: "Enterprise SSO single sign-on & financial data compliance", included: true },
          { text: "1-on-1 dedicated technical advisor & strict enterprise SLA", included: true },
        ],
      },

      // Billing cycles data
      cycles: [
        {
          id: "monthly",
          title: "Monthly",
          price: "$4.99",
          oldPrice: "$7.99",
          detail: "Billed monthly",
          badge: "",
          classSuffix: "lite",
        },
        {
          id: "quarterly",
          title: "Quarterly",
          price: "$3.66",
          oldPrice: "$6.66",
          detail:
            "Billed quarterly ($10.99)\nsave approx. $4 compared to Monthly",
          badge: "Most Popular",
          classSuffix: "pro",
        },
        {
          id: "yearly",
          title: "Yearly",
          price: "$3.25",
          oldPrice: "$4.99",
          detail: "Billed yearly ($39)\nsave approx. $20 compared to Monthly",
          badge: "Best Value",
          classSuffix: "max",
        },
      ],
    }
  : {
      title: "弈泽专业版",
      description: "开通弈泽专业版，享受证据可追溯财报研究软件的高额度体验。",
      eyebrow: "付费订阅 · 限时优惠",
      featuresTitle: "专业版能力",
      features: [
        "更高的每月财报研究额度",
        "带证据和来源线索的多阶段复核",
        "在弈泽账户中交付结构化数字报告",
        "账单与数字交付客户支持",
      ],
      deliveryTitle: "数字交付",
      deliveryText: "付费订阅上线后，支付成功通常会立即激活对应账户权限。",
      cancelTitle: "可随时取消",
      cancelText: "月度订阅可随时取消，并可使用至当前已付费周期结束。",
      refundTitle: "首次扣款 7 天窗口",
      refundText: "符合条件的首次订阅扣款可在七个自然日内申请退款。",
      request: "立即订阅",
      loading: "正在提交…",
      signIn: "登录后订阅",
      success: "已记录你的早期体验申请。",
      duplicate: "你已经在早期体验名单中。",
      error: "暂时无法保存申请，请重试或通过邮件联系支持。",
      signedInAs: "当前账户",
      demo: "体验免费演示",
      legalPrefix: "订阅专业版计划即表示你已知悉",
      terms: "服务条款",
      privacy: "隐私政策",
      refunds: "退款与取消政策",
      delivery: "数字交付政策",
      support: "如有疑问，请发送邮件至 contact@ezer.cc",
      paymentMethodLabel: "支付方式",
      card: "银行卡",
      alipay: "支付宝",
      alipayUnavailable: "支付宝仅支持季度计划及以上。",
      unsupportedPaymentMethod: "所选计划暂不支持此支付方式。",

      freePlan: {
        tag: "基础体验",
        title: "免费版",
        description: "零门槛体验审计级财报分析，结论与证据链完全公开透明",
        price: "￥0",
        period: "月",
        actionText: "免费开始体验",
        features: [
          { text: "每月 3 次财报深度分析额度", included: true },
          { text: "基础审计链路与核心财务指标总览", included: true },
          { text: "公开透明证据链，结论逐行溯源原文", included: true },
          { text: "高价值大模型多阶深度复核链路", included: false },
          { text: "历史分析记录云端归档与管理", included: false },
          { text: "导出专业级 PDF 深度分析报告", included: false },
        ],
      },
      proPlan: {
        tag: "深度研究",
        badge: "限时优惠",
        title: "专业版",
        description: "专为需要高频研读、多阶深度复核与完整数字报告的专业研究者打造",
        pricePrefix: "低至",
        price: "￥20.75",
        period: "月",
        priceNote: "年付较月付共省 ￥110",
        actionText: "选择订阅周期",
        features: [
          { text: "更高额度深度分析，满足高频研读", included: true },
          { text: "高价值行业顶级大模型全链路协同复核", included: true },
          { text: "多阶审计式深度复核，交叉验证推演链路", included: true },
          { text: "在弈泽账户中交付与沉淀结构化数字报告", included: true },
          { text: "专属客户支持通道与优先服务响应", included: true },
          { text: "优先体验后续上线的专业 PDF 导出等功能", included: true },
        ],
      },
      enterprisePlan: {
        tag: "机构定制",
        title: "企业版",
        description: "为投资机构、投行、审计事务所及深度投研团队量身定制的专属财报分析平台与私有化方案",
        pricePrefix: "",
        price: "定制咨询",
        period: "专属方案",
        actionText: "联系商务",
        actionUrl: `${prefix}/contact/`,
        features: [
          { text: "包含专业版全部能力与专属权益", included: true },
          { text: "不设限额度与高并发专属分析通道", included: true },
          { text: "机构专有研报与内部知识库深度融合", included: true },
          { text: "提供专有 API 接口或支持本地私有化部署", included: true },
          { text: "支持企业级 SSO 单点登录与数据安全合规", included: true },
          { text: "1对1 专属技术顾问与严苛企业级 SLA 保障", included: true },
        ],
      },

      // Billing cycles data
      cycles: [
        {
          id: "monthly",
          title: "月付计划",
          price: "￥29.99",
          oldPrice: "￥49.99",
          detail: "按月结算",
          badge: "",
          classSuffix: "lite",
        },
        {
          id: "quarterly",
          title: "季付计划",
          price: "￥23.33",
          oldPrice: "￥39.66",
          detail: "每 3 个月结算 ￥69.99\n较月付计划共省约 ￥20",
          badge: "最受欢迎",
          classSuffix: "pro",
        },
        {
          id: "yearly",
          title: "年付计划",
          price: "￥20.75",
          oldPrice: "￥33.16",
          detail: "每 12 个月结算 ￥249\n较月付计划共省约 ￥110",
          badge: "最划算",
          classSuffix: "max",
        },
      ],
    };

const signInUrl = `https://account.ezer.cc/${isEnglish ? "en/" : ""}login/`;
---

<Layout
  title={copy.title}
  description={copy.description}
  keywords={isEnglish
    ? "Ezer Premium, financial statement research software, digital subscription"
    : "弈泽专业版, 财报研究软件, 数字订阅"}
>
  <section class="premium">
    <canvas id="tubes-cursor-canvas" class="tubes-cursor-canvas"></canvas>
    <!-- Cancel Banner -->
    <div
      id="payment-cancel-banner"
      class="payment-banner payment-banner--error"
      hidden
    >
      <div class="payment-banner__content">
        <span class="payment-banner__text"></span>
        <button
          id="close-cancel-banner-btn"
          class="payment-banner__close"
          type="button"
          aria-label="Close"
        >
          &times;
        </button>
      </div>
    </div>

    <div class="u-container premium__inner">
      <div class="premium__intro">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>

      <!-- Plans Comparison Section (Free vs Pro) -->
      <div class="premium__compare" id="premium-compare-section">
        <!-- Free Plan Card -->
        <div class="compare-card compare-card--free">
          <div class="compare-card__header">
            <span class="compare-card__tag">{copy.freePlan.tag}</span>
            <h2 class="compare-card__title">{copy.freePlan.title}</h2>
            <p class="compare-card__desc">{copy.freePlan.description}</p>
          </div>

          <div class="compare-card__price-box">
            <span class="compare-card__amount">{copy.freePlan.price}</span>
            <span class="compare-card__period">/ {copy.freePlan.period}</span>
          </div>

          <ul class="compare-card__features">
            {
              copy.freePlan.features.map((feat) => (
                <li class={feat.included ? "is-included" : "is-excluded"}>
                  <span class="feature-icon" aria-hidden="true">
                    {feat.included ? (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                    ) : (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                    )}
                  </span>
                  <span class="feature-text">{feat.text}</span>
                </li>
              ))
            }
          </ul>

          <div class="compare-card__footer">
            <a href={`${prefix}/check/?preview=true`} class="compare-btn compare-btn--ghost">
              <span>{copy.freePlan.actionText}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
            </a>
          </div>
        </div>

        <!-- Pro Plan Card -->
        <div class="compare-card compare-card--pro" id="pro-compare-card" role="button" tabindex="0" aria-expanded="false" aria-controls="billing-cycles-section">
          {copy.proPlan.badge && <span class="compare-card__badge">{copy.proPlan.badge}</span>}
          <div class="compare-card__header">
            <span class="compare-card__tag">{copy.proPlan.tag}</span>
            <h2 class="compare-card__title">{copy.proPlan.title}</h2>
            <p class="compare-card__desc">{copy.proPlan.description}</p>
          </div>

          <div class="compare-card__price-box">
            <span class="compare-card__prefix">{copy.proPlan.pricePrefix}</span>
            <span class="compare-card__amount">{copy.proPlan.price}</span>
            <span class="compare-card__period">/ {copy.proPlan.period}</span>
            {copy.proPlan.priceNote && (
              <span class="compare-card__note">{copy.proPlan.priceNote}</span>
            )}
          </div>

          <ul class="compare-card__features">
            {
              copy.proPlan.features.map((feat) => (
                <li class="is-included is-pro">
                  <span class="feature-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                  </span>
                  <span class="feature-text">{feat.text}</span>
                </li>
              ))
            }
          </ul>

          <div class="compare-card__footer">
            <button type="button" id="trigger-pro-cycles-btn" class="compare-btn compare-btn--primary">
              <span class="btn-text">{copy.proPlan.actionText}</span>
              <svg class="btn-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" /></svg>
            </button>
          </div>
        </div>

        <!-- Enterprise Plan Card -->
        <div class="compare-card compare-card--enterprise">
          <div class="compare-card__header">
            <span class="compare-card__tag">{copy.enterprisePlan.tag}</span>
            <h2 class="compare-card__title">{copy.enterprisePlan.title}</h2>
            <p class="compare-card__desc">{copy.enterprisePlan.description}</p>
          </div>

          <div class="compare-card__price-box">
            <span class="compare-card__amount">{copy.enterprisePlan.price}</span>
            <span class="compare-card__period">/ {copy.enterprisePlan.period}</span>
          </div>

          <ul class="compare-card__features">
            {
              copy.enterprisePlan.features.map((feat) => (
                <li class="is-included is-enterprise">
                  <span class="feature-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                  </span>
                  <span class="feature-text">{feat.text}</span>
                </li>
              ))
            }
          </ul>

          <div class="compare-card__footer">
            <a href={copy.enterprisePlan.actionUrl} class="compare-btn compare-btn--enterprise">
              <span>{copy.enterprisePlan.actionText}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Active Premium User Container -->
      <div id="active-premium-container" class="active-premium-container" hidden>
        <div class="active-premium-content">
          <a id="active-premium-btn" href={`${prefix}/search/`} class="active-premium-btn">
            {isEnglish ? "You have activated Premium! Click to experience ➔" : "您当前已开通专业版，立即体验 ➔"}
          </a>
          <div class="active-premium-manage">
            <a id="active-premium-secondary-link" href={`https://account.ezer.cc/${isEnglish ? "en/" : ""}`}>
              {isEnglish ? "Manage Subscription" : "管理订阅"}
            </a>
          </div>
        </div>
      </div>

      <!-- Billing Cycles Section (Default Hidden, Revealed on Clicking Pro) -->
      <div id="billing-cycles-section" class="billing-cycles-section" hidden>
        <div class="billing-cycles-header">
          <div class="billing-cycles-tag">{isEnglish ? "SELECT CYCLE" : "选择方案"}</div>
          <h2 class="billing-cycles-title">{isEnglish ? "Choose Your Billing Cycle" : "选择专业版付费周期"}</h2>
          <p class="billing-cycles-desc">{isEnglish ? "Select the billing frequency that best fits your workflow. Cancel anytime." : "选择适合您的结算周期，所有方案均包含全部专业版权益，支持随时灵活管理"}</p>
        </div>

        <!-- Redesigned Three-Billing-Cycle Cards -->
        <div id="premium-pricing-grid" class="pricing-grid">
          {
            copy.cycles.map((cycle) => (
              <div class={`pricing-card pricing-card--${cycle.classSuffix}`}>
                {cycle.badge && <span class="card-badge">{cycle.badge}</span>}
                <div class="card-header">
                  <h3 class="card-title">{cycle.title}</h3>
                </div>

                <div class="price-wrapper">
                  <div class="price-row">
                    <span class="price-current">
                      {cycle.id !== "monthly" && (
                        <span class="price-approx">~</span>
                      )}
                      {cycle.price}
                    </span>
                    <span class="price-slash">/ {isEnglish ? "mo" : "月"}</span>
                    {cycle.oldPrice && (
                      <span class="price-original">
                        {cycle.id !== "monthly" && (
                          <span class="price-approx-small">~</span>
                        )}
                        {cycle.oldPrice}/{isEnglish ? "mo" : "月"}
                      </span>
                    )}
                  </div>
                  <p class="price-billing-detail">
                    {cycle.detail.split("\n").map((line, idx) => (
                      <>
                        {idx > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </p>
                </div>

                <button
                  type="button"
                  class="subscribe-btn"
                  data-cycle={cycle.title}
                  data-plan-key={`${isEnglish ? "en" : "zh"}_${cycle.id === "yearly" ? "annual" : cycle.id}`}
                  data-default-text={copy.request}
                >
                  <span class="btn-text">{copy.request}</span>
                  <span class="loader" aria-hidden="true" hidden />
                </button>
                {!isEnglish && (
                  <fieldset class="payment-methods">
                    <legend>{copy.paymentMethodLabel}</legend>
                    <label class="payment-method">
                      <input
                        type="radio"
                        name={`payment-method-${cycle.id}`}
                        value="card"
                        data-payment-method="card"
                        checked
                      />
                      <span class="payment-method__label">
                        <span>{copy.card}</span>
                        <span
                          class="payment-method__icons payment-method__icons--cards"
                          aria-label="Visa and Mastercard"
                        >
                          <img src="/payment-icons/visa.svg" alt="Visa" />
                          <img
                            src="/payment-icons/mastercard.svg"
                            alt="Mastercard"
                          />
                        </span>
                      </span>
                    </label>
                    <label
                      class:list={[
                        "payment-method",
                        !isAlipaySupported(cycle.id) &&
                          "payment-method--disabled",
                      ]}
                    >
                      <input
                        type="radio"
                        name={`payment-method-${cycle.id}`}
                        value="alipay"
                        data-payment-method="alipay"
                        disabled={!isAlipaySupported(cycle.id)}
                      />
                      <span class="payment-method__label">
                        <span>{copy.alipay}</span>
                        <span class="payment-method__icons">
                          <img src="/payment-icons/alipay.svg" alt="支付宝" />
                        </span>
                      </span>
                    </label>
                    {!isAlipaySupported(cycle.id) && (
                      <small class="payment-methods__hint">
                        {copy.alipayUnavailable}
                      </small>
                    )}
                  </fieldset>
                )}
              </div>
            ))
          }
        </div>

      </div>

      <!-- Feedback / Messages -->
      <div class="feedback-section" hidden>
        <p id="user-display-email" class="user-email" hidden></p>
        <p id="waitlist-message" class="waitlist-message" hidden></p>
      </div>

      <div>
        <p class="legal-copy">
          {copy.legalPrefix}
          <a href={`${prefix}/terms/`}>{copy.terms}</a>
          {isEnglish ? ", " : "、"}
          <a href={`${prefix}/privacy/`}>{copy.privacy}</a>
          {isEnglish ? ", " : "、"}
          <a href={`${prefix}/refund-and-cancellation/`}>{copy.refunds}</a>
          {isEnglish ? ", and " : "及"}
          <a href={`${prefix}/delivery-policy/`}>{copy.delivery}</a>
          {isEnglish ? "." : "。"}
        </p>
        <div class="secondary-actions">
          <a href={`${prefix}/check/?preview=true`}>{copy.demo}</a>
          <a href="mailto:contact@ezer.cc">{copy.support}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .premium {
    min-height: 100vh;
    padding: 8rem 0 6rem;
    background:
      radial-gradient(
        circle at 15% 5%,
        rgba(var(--rgb-brand-1), 0.18),
        transparent 35rem
      ),
      radial-gradient(
        circle at 90% 80%,
        rgba(130, 99, 255, 0.12),
        transparent 35rem
      ),
      #090a0f;
    background-attachment: fixed;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .tubes-cursor-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 0;
    pointer-events: none;
  }

  .premium__inner {
    max-width: 68rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    z-index: 1;
  }

  .premium__intro {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #a999ff;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
