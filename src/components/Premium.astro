  /* Force dark mode variables for the header and body when viewing premium page */
  :global(body:has(.premium)) {
    --rgb-text: 255, 255, 255;
    --rgb-text-alt: 153, 161, 179;
    --rgb-brand-1: 162, 142, 247;
    --rgb-brand-2: 43, 49, 29;
    --rgb-brand-3: 31, 26, 61;
    --rgb-brand-4: 46, 54, 34;
    --rgb-brand-5: 172, 214, 60;
    --color-bg: #0d1117;
    --color-surface: #1e1e24;
    --color-surface-translucent: rgba(30, 30, 36, 0.95);

    --color-text: rgb(var(--rgb-text));
    --color-text-alt: rgb(var(--rgb-text-alt));
    --color-brand-1: rgb(var(--rgb-brand-1));
    --color-brand-2: rgb(var(--rgb-brand-2));
    --color-brand-3: rgb(var(--rgb-brand-3));
    --color-brand-4: rgb(var(--rgb-brand-4));
