  /* ============================================================
     Comparison Section (Free vs Pro)
     ============================================================ */
  .premium .premium__compare {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0 0.5rem;
    align-items: stretch;
  }

  .premium .compare-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
    border-radius: 1.25rem;
    background: rgba(17, 18, 22, 0.45);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    backdrop-filter: blur(10px) saturate(120%);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12),
      0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease;
    overflow: hidden;
  }

  .premium .compare-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
    padding: 1px;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.22),
      rgba(255, 255, 255, 0.02)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 3;
    transition: background 0.3s ease;
  }

  .premium .compare-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.5) 50%,
      transparent
    );
    filter: blur(0.5px);
    z-index: 2;
  }

  .premium .compare-card--free {
    background: rgba(15, 16, 20, 0.4);
  }

  .premium .compare-card--free:hover {
    transform: translateY(-2px);
    background: rgba(17, 18, 23, 0.55);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.18),
      0 12px 36px 0 rgba(0, 0, 0, 0.4);
  }

  .premium .compare-card--pro {
    cursor: pointer;
    background:
      linear-gradient(to bottom, rgba(139, 115, 245, 0.14), transparent 45%) padding-box,
      rgba(18, 19, 25, 0.55);
  }

  .premium .compare-card--pro::after {
    background: linear-gradient(
      to bottom,
      rgba(139, 115, 245, 0.45),
      rgba(139, 115, 245, 0.05)
    );
  }

  .premium .compare-card--pro::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(169, 153, 255, 0.8) 50%,
      transparent
    );
  }

  .premium .compare-card--pro:hover,
  .premium .compare-card--pro.is-selected {
    transform: translateY(-3px);
    background:
      linear-gradient(to bottom, rgba(139, 115, 245, 0.22), transparent 45%) padding-box,
      rgba(20, 21, 28, 0.7);
    box-shadow:
      inset 0 1px 0 0 rgba(169, 153, 255, 0.35),
      0 16px 48px 0 rgba(139, 115, 245, 0.18),
      0 8px 32px 0 rgba(0, 0, 0, 0.5);
  }

  .premium .compare-card--pro:hover::after,
  .premium .compare-card--pro.is-selected::after {
    background: linear-gradient(
      to bottom,
      rgba(169, 153, 255, 0.7),
      rgba(139, 115, 245, 0.15)
    );
  }

  .premium .compare-card__badge {
