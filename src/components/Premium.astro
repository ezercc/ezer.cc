<script
  is:inline
  define:vars={{
    requestLabel: copy.request,
    loadingLabel: copy.loading,
    signInLabel: copy.signIn,
    successMessage: premiumPlan.checkoutLive
      ? isEnglish
        ? "Redirecting to Stripe Checkout. Your Premium access will activate after payment is confirmed."
        : "正在跳转至 Stripe 结账页。付款确认后将开通专业版权限。"
      : copy.success,
    duplicateMessage: copy.duplicate,
    errorMessage: copy.error,
    signedInAs: copy.signedInAs,
    signInUrl,
    checkoutLive: premiumPlan.checkoutLive,
    checkoutFunctionUrl: premiumPlan.checkoutFunctionUrl,
    locale: lang,
    supportedAlipayPlans: premiumPlan.paymentMethods.alipay.supportedPlans,
    paymentMethodUnsupportedMessage: copy.unsupportedPaymentMethod,
    paymentSuccessMessage: isEnglish
      ? "Payment successful! Your Premium access has been activated."
      : "支付成功！您的专业版权限已开通。",
    paymentCancelMessage: isEnglish
      ? "Payment cancelled. You can try subscribing again when you are ready."
      : "支付已取消。您可以随时重新尝试订阅。",
    prefix,
  }}
>
  async function initPremiumEarlyAccess() {
    const buttons = document.querySelectorAll(".subscribe-btn");
    const emailHint = document.getElementById("user-display-email");
    const message = document.getElementById("waitlist-message");
    const feedbackSection = document.querySelector(".feedback-section");

    if (!buttons.length || !message) return;

    function updateFeedbackVisibility() {
      if (!feedbackSection) return;
      const isEmailVisible = emailHint && !emailHint.hidden;
      const isMessageVisible = message && !message.hidden;
      if (isEmailVisible || isMessageVisible) {
        feedbackSection.hidden = false;
      } else {
        feedbackSection.hidden = true;
      }
    }

    // Set initial visibility
    updateFeedbackVisibility();

    // Close banner handler
    const closeBannerBtn = document.getElementById("close-cancel-banner-btn");
    if (closeBannerBtn) {
      closeBannerBtn.addEventListener("click", () => {
        const cancelBanner = document.getElementById("payment-cancel-banner");
        if (cancelBanner) {
          cancelBanner.hidden = true;
        }
      });
    }

    // Check payment status from URL query parameters
    const urlParams = new URLSearchParams(window.location.search);
    const status = urlParams.get("status");
    const isSuccessRedirect = status === "success";

    if (status === "cancel") {
      // Show top cancel banner
      const cancelBanner = document.getElementById("payment-cancel-banner");
      const cancelBannerText = cancelBanner?.querySelector(
        ".payment-banner__text",
      );
      if (cancelBanner && cancelBannerText) {
        cancelBannerText.textContent = paymentCancelMessage;
        cancelBanner.hidden = false;
      }
    }

    // Clean URL query parameters immediately to avoid blocking by async network calls
    if (status === "success" || status === "cancel") {
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, document.title, cleanUrl);
    }

    const session = await window.auth?.getSession();
    let hasActivePremium = false;

    if (session) {
      if (emailHint) {
        emailHint.textContent = `${signedInAs}: ${session.user.email}`;
        emailHint.hidden = false;
        updateFeedbackVisibility();
      }

      try {
        const { data: plan, error } = await window.auth.client
          .from("user_plans")
          .select("plan_type, paid_through, premium_until")
          .eq("uid", session.user.id)
          .single();

        if (!error && plan) {
          const entitlementEnd = plan.paid_through || plan.premium_until;
          const endDate = entitlementEnd ? new Date(entitlementEnd) : null;
          hasActivePremium =
            plan.plan_type === "premium" &&
            endDate &&
            !Number.isNaN(endDate.getTime()) &&
            endDate > new Date();
        }
      } catch (err) {
        console.error("[Premium] Failed to check user plans:", err);
      }
    } else {
      buttons.forEach((btn) => {
        const btnText = btn.querySelector(".btn-text");
        if (btnText) btnText.textContent = signInLabel;
      });
      updateFeedbackVisibility();
    }

    const triggerProBtn = document.getElementById("trigger-pro-cycles-btn");
    const proCard = document.getElementById("pro-compare-card");
    const billingSection = document.getElementById("billing-cycles-section");

    function revealBillingCycles(shouldScroll = true) {
      if (!billingSection) return;
      billingSection.hidden = false;
      billingSection.classList.add("is-visible");
      if (proCard) {
        proCard.classList.add("is-selected");
        proCard.setAttribute("aria-expanded", "true");
      }
      if (shouldScroll) {
        setTimeout(() => {
          billingSection.scrollIntoView({ behavior: "smooth", block: "start" });
        }, 80);
      }
    }

    if (triggerProBtn) {
      triggerProBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        revealBillingCycles(true);
      });
    }

    if (proCard) {
      proCard.addEventListener("click", (e) => {
        if (!e.target.closest("a")) {
          revealBillingCycles(true);
        }
      });
      proCard.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          revealBillingCycles(true);
        }
      });
    }

    // Default: billing cycles section remains hidden until user clicks '选择订阅周期' (triggerProBtn)

    const isPremium = hasActivePremium || isSuccessRedirect;
    if (isPremium) {
      // Hide the billing cycles section
      if (billingSection) {
        billingSection.hidden = true;
        billingSection.style.display = "none";
      }

      // Hide the pricing grid
      const pricingGrid = document.getElementById("premium-pricing-grid");
      if (pricingGrid) {
        pricingGrid.hidden = true;
        pricingGrid.style.display = "none";
      }

      // Update pro card trigger button text
      if (triggerProBtn) {
        const btnText = triggerProBtn.querySelector(".btn-text");
        if (btnText) {
          btnText.textContent = locale === "en" ? "Premium Active" : "已开通专业版";
        }
        triggerProBtn.disabled = true;
        triggerProBtn.style.opacity = "0.8";
        triggerProBtn.style.cursor = "default";
      }

      // Show active premium container
      const activePremiumContainer = document.getElementById("active-premium-container");
      if (activePremiumContainer) {
        activePremiumContainer.hidden = false;

        // Customise texts if redirected on successful payment
        if (isSuccessRedirect) {
          const mainBtn = document.getElementById("active-premium-btn");
          const secondaryLink = document.getElementById("active-premium-secondary-link");

          if (mainBtn) {
            mainBtn.textContent = locale === "en"
              ? "Thank you for subscribing to Ezer Premium! Your entitlements will be credited within 5 minutes."
              : "感谢您订阅弈泽专业版，您的权益将在5分钟内到账。";
            mainBtn.removeAttribute("href");
            mainBtn.style.cursor = "default";
            mainBtn.style.pointerEvents = "none";
          }
          if (secondaryLink) {
            secondaryLink.textContent = locale === "en" ? "Experience Now" : "立即体验";
            secondaryLink.href = `${prefix}/search/`;
          }
        }
      }

      // Hide waitlist feedback section
      if (feedbackSection) {
        feedbackSection.hidden = true;
        feedbackSection.style.display = "none";
      }
    }

    buttons.forEach((button) => {
      button.addEventListener("click", async () => {
        const activeSession = await window.auth?.getSession();
        if (!activeSession) {
          window.location.href = signInUrl;
          return;
        }

        const currentBtnText = button.querySelector(".btn-text");
        const currentLoader = button.querySelector(".loader");
        const selectedCycleName = button.getAttribute("data-cycle");
        const planKey = button.getAttribute("data-plan-key");
        const planId = planKey?.replace(/^\w+_/, "");
        const card = button.closest(".pricing-card");
        const selectedPaymentMethod =
          card
            ?.querySelector("input[data-payment-method]:checked")
            ?.getAttribute("data-payment-method") || "card";

        if (
          selectedPaymentMethod === "alipay" &&
          (!planId || !supportedAlipayPlans.includes(planId))
        ) {
          message.textContent = paymentMethodUnsupportedMessage;
          message.hidden = false;
          updateFeedbackVisibility();
          return;
        }

        // Disable all buttons during submission
        buttons.forEach((btn) => (btn.disabled = true));
        if (currentBtnText) currentBtnText.textContent = loadingLabel;
        if (currentLoader) currentLoader.hidden = false;
        message.hidden = true;
        updateFeedbackVisibility();

        try {
          const planKey = button.getAttribute("data-plan-key");
          if (checkoutLive) {
            if (!planKey) throw new Error("Missing checkout plan");
            const response = await fetch(checkoutFunctionUrl, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${activeSession.access_token}`,
              },
              body: JSON.stringify({
                plan_key: planKey,
                payment_method: selectedPaymentMethod,
                locale,
              }),
            });
            const checkout = await response.json().catch(() => null);
            if (!response.ok || !checkout?.url)
              throw new Error("Could not start checkout");
            window.location.assign(checkout.url);
            return;
          }

          const { error } = await window.auth.client.from("waitlist").insert({
            uid: activeSession.user.id,
            email: activeSession.user.email,
          });

          if (error && error.code !== "23505") throw error;

          let cycleSuccessMessage = successMessage;
          if (error?.code === "23505") {
            cycleSuccessMessage = duplicateMessage;
          } else {
            cycleSuccessMessage = `${successMessage} [${selectedCycleName}]`;
          }
          message.textContent = cycleSuccessMessage;
          message.hidden = false;
          updateFeedbackVisibility();
        } catch (error) {
          message.textContent = errorMessage;
          message.hidden = false;
          updateFeedbackVisibility();
        } finally {
          buttons.forEach((btn) => {
            btn.disabled = false;
            const btnText = btn.querySelector(".btn-text");
            if (btnText)
              btnText.textContent = activeSession
                ? btn.getAttribute("data-default-text")
                : signInLabel;
            const loader = btn.querySelector(".loader");
            if (loader) loader.hidden = true;
          });
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPremiumEarlyAccess, {
      once: true,
    });
  } else {
    initPremiumEarlyAccess();
  }
</script>

<script is:inline type="module">
  import TubesCursor from "https://cdn.jsdelivr.net/npm/threejs-components@0.0.19/build/cursors/tubes1.min.js";

  function initTubes() {
    const el = document.getElementById("tubes-cursor-canvas");
    if (!el) return;

    const app = TubesCursor(el, {
      tubes: {
        colors: ["#f967fb", "#53bc28", "#6958d5"],
        lights: {
          intensity: 200,
          colors: ["#83f36e", "#fe8a2e", "#ff008a", "#60aed5"],
        },
      },
    });

    el.addEventListener("click", () => {
      const colors = randomColors(3);
      const lightsColors = randomColors(4);
      app.tubes.setColors(colors);
      app.tubes.setLightsColors(lightsColors);
    });
  }

  function randomColors(count) {
    return new Array(count).fill(0).map(
      () =>
        "#" +
        Math.floor(Math.random() * 16777215)
          .toString(16)
          .padStart(6, "0"),
    );
  }

  if (document.readyState === "complete") {
    initTubes();
  } else {
    window.addEventListener("load", initTubes);
  }

  document.addEventListener("astro:after-swap", initTubes);
</script>
