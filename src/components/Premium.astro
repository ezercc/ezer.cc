  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }

  .lead {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  /* Redesigned Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 1.25rem;
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
    border-radius: 1.25rem;
    background: rgba(17, 18, 22, 0.45);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    backdrop-filter: blur(8px) saturate(120%);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.15),
      0 8px 32px 0 rgba(0, 0, 0, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  /* Gradient border strictly drawn only at the edge using mask composite */
  .pricing-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
    padding: 1px; /* border thickness */
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.35),
      rgba(255, 255, 255, 0.02)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 3;
    transition: background 0.3s ease;
  }

  /* Sleek top highlight line (internal glow) */
  .pricing-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.7) 50%,
      transparent
    );
    filter: blur(0.5px);
    z-index: 2;
  }

  /* Card 2: Pro Card Glow & Highlight */
  .pricing-card--pro {
    background:
      linear-gradient(to bottom, rgba(139, 115, 245, 0.15), transparent 38%)
        padding-box,
      rgba(20, 21, 26, 0.5);
  }
  .pricing-card--pro::after {
    background: linear-gradient(
      to bottom,
      rgba(139, 115, 245, 0.4),
      rgba(139, 115, 245, 0.02)
    );
  }
  .pricing-card--pro::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.8) 50%,
      transparent
    );
  }

  /* Card 3: Max Card Glow & Highlight */
  .pricing-card--max {
    background:
      linear-gradient(to bottom, rgba(241, 196, 15, 0.15), transparent 40%)
        padding-box,
      rgba(22, 23, 28, 0.5);
  }
  .pricing-card--max::after {
    background: linear-gradient(
      to bottom,
      rgba(241, 196, 15, 0.4),
      rgba(241, 196, 15, 0.02)
    );
  }
  .pricing-card--max::before {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(241, 196, 15, 0.8) 50%,
      transparent
    );
  }

  /* Card hovers */
  .pricing-card:hover {
    transform: translateY(-0.25rem);
    background: rgba(17, 18, 22, 0.6);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.25),
      0 16px 48px 0 rgba(0, 0, 0, 0.5);
  }
  .pricing-card:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.45),
      rgba(255, 255, 255, 0.04)
    );
  }
  .pricing-card--pro:hover {
    background:
      linear-gradient(to bottom, rgba(139, 115, 245, 0.3), transparent 38%)
        padding-box,
      rgba(20, 21, 26, 0.65);
  }
  .pricing-card--pro:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(139, 115, 245, 0.55),
      rgba(139, 115, 245, 0.04)
    );
  }
  .pricing-card--max:hover {
    background:
      linear-gradient(to bottom, rgba(241, 196, 15, 0.3), transparent 40%)
        padding-box,
      rgba(22, 23, 28, 0.65);
  }
  .pricing-card--max:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(241, 196, 15, 0.55),
      rgba(241, 196, 15, 0.04)
    );
  }

  .card-header {
    display: flex;
    align-items: center;
    margin-bottom: 2rem;
  }

