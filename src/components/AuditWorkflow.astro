---
interface Props {
  lang?: "zh" | "en";
  class?: string;
}

const { lang = "zh", class: className = "" } = Astro.props;
const isEn = lang === "en";

const t = {
  mainTitle: isEn ? "Ezer Audit Workflow" : "Ezer 审计工作流",
  subTitle: isEn
    ? "Structured financial data ingestion, evidence-bound analysis, audit challenge & verifier-hardened pipeline"
    : "结构化金融数据接入、证据绑定分析、审计挑战与验证器加固的交付链路",
  zoomHint: isEn ? "Click to view full architecture" : "点击查看高清全景架构",
  closeModal: isEn ? "Close" : "关闭",
  replayHint: isEn ? "Replay workflow sequence" : "重新演示执行时序",
  replayLabel: isEn ? "Replay" : "重播",
  
  // Nodes
  node1Title: isEn ? "1. Frontend Trigger" : "1. 前端触发",
  node1Items: isEn
    ? ["Input: code / period / year / lang", "Single SSE stream throughout analysis", "Underlying model keys never exposed"]
    : ["输入：code / period / year / lang", "单条 SSE 贯穿整次分析", "前端不暴露底层模型密钥"],
  node1Sub: isEn ? "Public Structured Sources" : "公开结构化数据源",

  node2Title: isEn ? "2. Data Layer" : "2. 数据层",
  node2Items: isEn
    ? ["Eastmoney structured reports", "12-quarter historical series", "MX market & business context", "Readable field mapping & anchors"]
    : ["东方财富结构化财报", "近 12 个季度历史序列", "MX 市场与业务补充上下文", "可读字段映射与来源锚点"],

  node3Title: isEn ? "3. Orchestration" : "3. 编排层",
  node3Items: isEn
    ? ["Request validation & ticker parsing", "Evidence dossier assembly", "Task state machine & SSE dispatch", "Artifact persistence for replay"]
    : ["请求校验与证券代码解析", "证据材料包组装", "任务状态机与 SSE 事件分发", "产物落盘，支持复盘与回放"],

  roleHint: isEn ? "Dynamically switch analyst roles by market context" : "根据公司与市场上文动态切换分析角色",

  node4Title: isEn ? "4. Analysis Model B" : "4. 分析模型 B",
  node4Items: isEn
    ? ["7 chapterized analysis cards", "Trend / correlation / mapping check", "Investor-oriented core findings", "Evidence & counter-evidence per card"]
    : ["七张章节化分析卡", "趋势 / 关联 / 映射检查", "面向投资者的核心结论", "每张卡都附证据与反证点"],

  node5Title: isEn ? "5. Audit Model C" : "5. 审计模型 C",
  node5Items: isEn
    ? ["Actively challenge fragile claims", "Reject unwarranted extrapolations", "PASS / WARNINGS / REJECTED rules", "Final summary & issue tracking"]
    : ["专门挑战脆弱结论", "拒绝证据不足的外推", "PASS / WARNINGS / REJECTED 规则", "输出最终摘要与问题追踪"],

  guardrailsTitle: isEn ? "Runtime Guardrails" : "运行护栏",
  guardrailsItems: isEn
    ? ["Bearer auth & datasource whitelist", "Task artifact logging for replay", "Auto-fallback on sparse evidence"]
    : ["Bearer 鉴权与数据源白名单", "任务产物落盘，支持审计与回放", "证据不足时自动降级"],

  verifierTitle: isEn ? "Verifier Quality Layer" : "Verifier 质量层",
  verifierItems: isEn
    ? ["Independent QA capability showcase", "Output consistency & schema checks", "Enterprise commercial trustworthiness"]
    : ["独立质量控制能力展示", "输出一致性与契约检查", "支撑商业化可信度"],

  node6Title: isEn ? "6. Frontend Delivery" : "6. 前端交付",
  node6Items: isEn
    ? ["Streaming progress, cards & audit", "Final verdict covers summary area", "Unified API for live demo & replay"]
    : ["流式展示进度、分析卡与审计结果", "最终结论覆盖前端摘要区", "同一 API 既能演示也能复盘"],

  // Badges & labels
  reqBadge: isEn ? "Request" : "请求",
  dossierBadge: isEn ? "Dossier" : "材料包",
  analysisInputBadge: isEn ? "Input" : "分析输入",
  cardsBadge: isEn ? "Cards" : "分析卡",
  jsonlCards: isEn ? "JSONL Cards" : "JSONL 分析卡",
  sseBadge: isEn ? "SSE Stream" : "SSE 流",
  stdDossier: isEn ? "Standardized Evidence Dossier" : "标准化证据材料包",
  qualityCheck: isEn ? "Quality Check" : "质量校验",
  ruleGate: isEn ? "Rule Gate" : "规则门控",
  auditResult: isEn ? "Audit Output" : "审计结果",
};
---

<div class={`ezer-workflow-wrapper ${className}`} id="ezer-workflow-root">
  <div class="workflow-card" id="ezer-workflow-trigger" title={t.zoomHint} role="button" tabindex="0">
    <div class="workflow-header-bar">
      <div class="flow-pill-tag">
        <span class="pulse-dot"></span>
        <span>{isEn ? "LIVE ARCHITECTURE" : "实装交付架构"}</span>
      </div>
      <div class="header-actions">
        <button type="button" class="ctrl-btn replay-btn" id="ezer-workflow-replay-btn" title={t.replayHint} aria-label={t.replayHint}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          <span class="ctrl-btn-label">{t.replayLabel}</span>
        </button>
        <button type="button" class="ctrl-btn zoom-btn" aria-label={t.zoomHint}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
          <span class="ctrl-btn-label">{isEn ? "Expand" : "放大"}</span>
        </button>
      </div>
    </div>

    <div class="svg-container">
      <svg
        viewBox="0 0 1180 460"
        xmlns="http://www.w3.org/2000/svg"
        class="workflow-svg"
      >
        <defs>
          <!-- Grid Background Pattern -->
          <pattern id="wf-grid" width="24" height="24" patternUnits="userSpaceOnUse">
            <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(40, 44, 52, 0.065)" stroke-width="0.8" />
          </pattern>

          <!-- Marker Arrow Heads - userSpaceOnUse ensures fixed sharp 8px arrows -->
          <marker id="wf-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="8.5" markerHeight="8.5" orient="auto">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#24262b" />
          </marker>
          <marker id="wf-arrow-dashed" viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="8.5" markerHeight="8.5" orient="auto">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#4b5563" />
          </marker>
        </defs>

        <!-- Canvas Background (Transparent so container 0.3 opacity + blur 4px takes effect) -->
        <rect x="0" y="0" width="1180" height="460" rx="14" fill="url(#wf-grid)" />

        <!-- Title Section (Static) -->
        <text x="40" y="34" class="svg-main-title">{t.mainTitle}</text>
        <text x="40" y="54" class="svg-sub-title">{t.subTitle}</text>


        <!-- ======================= SEQUENTIAL PIPELINE LAYERS ======================= -->

        <!-- STEP 1: 前端触发 (Col 1 Top, x: 40, w: 190, y: 72, h: 115) -->
        <g class="wf-step step-1">
          <g class="wf-node">
            <rect x="43" y="75" width="190" height="115" rx="9" fill="#24262b" />
            <rect x="40" y="72" width="190" height="115" rx="8" fill="#f6ba43" stroke="#24262b" stroke-width="1.8" />
            <text x="52" y="98" font-size="13.5" font-weight="700" fill="#1b1d22">{t.node1Title}</text>
            <text x="52" y="119" font-size="10.5" fill="#23262d">{t.node1Items[0]}</text>
            <text x="52" y="138" font-size="10.5" fill="#23262d">{t.node1Items[1]}</text>
            <text x="52" y="157" font-size="10.5" fill="#23262d">{t.node1Items[2]}</text>
            <text x="40" y="201" font-size="10.5" fill="#717886" font-weight="500">{t.node1Sub}</text>
          </g>
        </g>

        <!-- STEP 2: 发起请求 (Col 1 -> Col 2, x: 230 -> 320, Gap: 90px) -->
        <g class="wf-step step-2">
          <!-- Line reaches x: 317 (leaving 3px margin to node 2 border) -->
          <path d="M 230 128 L 317 128" stroke="#24262b" stroke-width="1.8" marker-end="url(#wf-arrow)" class="flow-draw-line" />
          <path d="M 230 128 L 317 128" stroke="#e09b13" stroke-width="1.8" class="stream-line" />
          <g class="badge-pill">
            <rect x="257" y="117" width="38" height="22" rx="11" fill="#ffffff" stroke="#24262b" stroke-width="1.3" filter="drop-shadow(1.5px 1.5px 0px #24262b)" />
            <text x="276" y="132" text-anchor="middle" font-size="10.2" font-weight="600" fill="#24262b">{t.reqBadge}</text>
          </g>
        </g>

        <!-- STEP 3: 数据层就绪 (Col 2 Top, x: 320, w: 195, y: 72, h: 122) -->
        <g class="wf-step step-3">
          <g class="wf-node">
            <rect x="323" y="75" width="195" height="122" rx="9" fill="#24262b" />
            <rect x="320" y="72" width="195" height="122" rx="8" fill="#84b8f5" stroke="#24262b" stroke-width="1.8" />
            <text x="333" y="96" font-size="13.5" font-weight="700" fill="#1b1d22">{t.node2Title}</text>
            <text x="333" y="117" font-size="10.5" fill="#23262d">{t.node2Items[0]}</text>
            <text x="333" y="135" font-size="10.5" fill="#23262d">{t.node2Items[1]}</text>
            <text x="333" y="153" font-size="10.5" fill="#23262d">{t.node2Items[2]}</text>
            <text x="333" y="171" font-size="10.5" fill="#23262d">{t.node2Items[3]}</text>
          </g>
        </g>

        <!-- STEP 4: 组装材料包 (Col 2 -> Col 3, x: 515 -> 605, Gap: 90px) -->
        <g class="wf-step step-4">
          <!-- Line reaches x: 602 (leaving 3px margin to node 3 border) -->
          <path d="M 515 128 L 602 128" stroke="#24262b" stroke-width="1.8" marker-end="url(#wf-arrow)" class="flow-draw-line" />
          <path d="M 515 128 L 602 128" stroke="#3b82f6" stroke-width="1.8" class="stream-line" />
          <g class="badge-pill">
            <rect x="538" y="117" width={isEn ? "52" : "44"} height="22" rx="11" fill="#ffffff" stroke="#24262b" stroke-width="1.3" filter="drop-shadow(1.5px 1.5px 0px #24262b)" />
            <text x={isEn ? "564" : "560"} y="132" text-anchor="middle" font-size="10.2" font-weight="600" fill="#24262b">{t.dossierBadge}</text>
          </g>
        </g>

        <!-- STEP 5: 编排层启动 (Col 3 Top, x: 605, w: 195, y: 72, h: 122) -->
        <g class="wf-step step-5">
          <g class="wf-node">
            <rect x="608" y="75" width="195" height="122" rx="9" fill="#24262b" />
            <rect x="605" y="72" width="195" height="122" rx="8" fill="#ef9365" stroke="#24262b" stroke-width="1.8" />
            <text x="618" y="96" font-size="13.5" font-weight="700" fill="#1b1d22">{t.node3Title}</text>
            <text x="618" y="117" font-size="10.5" fill="#23262d">{t.node3Items[0]}</text>
            <text x="618" y="135" font-size="10.5" fill="#23262d">{t.node3Items[1]}</text>
            <text x="618" y="153" font-size="10.5" fill="#23262d">{t.node3Items[2]}</text>
            <text x="618" y="171" font-size="10.5" fill="#23262d">{t.node3Items[3]}</text>
          </g>
        </g>

        <!-- STEP 6: 规则门控与运行护栏 (Col 3 Bottom, x: 605, w: 195, y: 326) -->
        <g class="wf-step step-6">
          <!-- Line reaches y: 323 (leaving 3px margin to guardrails top border) -->
          <path d="M 702 194 L 702 323" stroke="#4b5563" stroke-width="1.8" stroke-dasharray="6,5" marker-end="url(#wf-arrow-dashed)" class="flow-draw-line" />
          <g class="flow-label">
            <rect x={isEn ? "670" : "674"} y="246" width={isEn ? "66" : "56"} height="20" rx="4" fill="rgba(255, 255, 255, 0.8)" />
            <text x="702" y="260" text-anchor="middle" font-size="10.2" fill="#606674" font-weight="500">{t.ruleGate}</text>
          </g>
          <g class="wf-node">
            <rect x="608" y="329" width="195" height="115" rx="9" fill="#24262b" />
            <rect x="605" y="326" width="195" height="115" rx="8" fill="#edd0b0" stroke="#24262b" stroke-width="1.8" />
            <text x="618" y="352" font-size="13.5" font-weight="700" fill="#1b1d22">{t.guardrailsTitle}</text>
            <text x="618" y="374" font-size="10.5" fill="#23262d">{t.guardrailsItems[0]}</text>
            <text x="618" y="393" font-size="10.5" fill="#23262d">{t.guardrailsItems[1]}</text>
            <text x="618" y="412" font-size="10.5" fill="#23262d">{t.guardrailsItems[2]}</text>
          </g>
        </g>

        <!-- STEP 7: 动态角色与分析输入派发 (Col 3 -> Col 4, x: 800 -> 890, Gap: 90px) -->
        <g class="wf-step step-7">
          <g class="role-bubble">
            <rect x={isEn ? "865" : "875"} y="26" width={isEn ? "275" : "255"} height="28" rx="7" fill="#ffffff" stroke="#24262b" stroke-width="1.5" filter="drop-shadow(2px 2px 0px #24262b)" />
            <text x={isEn ? "1002" : "1002"} y="44" text-anchor="middle" font-size={isEn ? "9.6" : "10.5"} fill="#333740" font-weight="500">{t.roleHint}</text>
            <line x1={isEn ? "1002" : "1002"} y1="54" x2={isEn ? "1002" : "1002"} y2="68" stroke="#24262b" stroke-width="1.5" stroke-dasharray="3,3" marker-end="url(#wf-arrow)" />
          </g>
          <!-- Line reaches x: 887 (leaving 3px margin to node 4 border) -->
          <path d="M 800 128 L 887 128" stroke="#24262b" stroke-width="1.8" marker-end="url(#wf-arrow)" class="flow-draw-line" />
          <path d="M 800 128 L 887 128" stroke="#e28a58" stroke-width="1.8" class="stream-line" />
          <g class="badge-pill">
            <rect x="822" y="117" width="56" height="22" rx="11" fill="#ffffff" stroke="#24262b" stroke-width="1.3" filter="drop-shadow(1.5px 1.5px 0px #24262b)" />
            <text x="850" y="132" text-anchor="middle" font-size="10.2" font-weight="600" fill="#24262b">{t.analysisInputBadge}</text>
          </g>
        </g>

        <!-- STEP 8: 分析模型 B 展开 (Col 4 Top, x: 890, w: 240, y: 72, h: 124) -->
        <g class="wf-step step-8">
          <g class="wf-node">
            <rect x="893" y="75" width="240" height="124" rx="9" fill="#24262b" />
            <rect x="890" y="72" width="240" height="124" rx="8" fill="#78c593" stroke="#24262b" stroke-width="1.8" />
            <text x="904" y="96" font-size="13.5" font-weight="700" fill="#1b1d22">{t.node4Title}</text>
            <text x="904" y="117" font-size="10.5" fill="#23262d">{t.node4Items[0]}</text>
            <text x="904" y="135" font-size="10.5" fill="#23262d">{t.node4Items[1]}</text>
            <text x="904" y="153" font-size="10.5" fill="#23262d">{t.node4Items[2]}</text>
            <text x="904" y="171" font-size="10.5" fill="#23262d">{t.node4Items[3]}</text>
          </g>
        </g>

        <!-- STEP 9: 产出分析卡并下行 (Node 4 -> Node 5, y: 196 -> 235) -->
        <g class="wf-step step-9">
          <!-- Line reaches y: 235 (leaving 3px margin to node 5 top border) -->
          <path d="M 1010 196 L 1010 235" stroke="#24262b" stroke-width="1.8" marker-end="url(#wf-arrow)" class="flow-draw-line" />
          <path d="M 1010 196 L 1010 235" stroke="#3e8f5b" stroke-width="1.8" class="stream-line-vert" />
          <g class="badge-pill">
            <rect x={isEn ? "960" : "956"} y="207" width={isEn ? "100" : "108"} height="22" rx="11" fill="#ffffff" stroke="#24262b" stroke-width="1.3" filter="drop-shadow(1.5px 1.5px 0px #24262b)" />
            <text x="1010" y="222" text-anchor="middle" font-size="10.2" font-weight="600" fill="#24262b">{t.jsonlCards}</text>
          </g>
        </g>

        <!-- STEP 10: 审计模型 C 挑战复核 (Col 4 Bottom, x: 890, w: 240, y: 238, h: 146) -->
        <g class="wf-step step-10">
          <g class="wf-node">
            <rect x="893" y="241" width="240" height="146" rx="9" fill="#24262b" />
            <rect x="890" y="238" width="240" height="146" rx="8" fill="#ea7a88" stroke="#24262b" stroke-width="1.8" />
            <text x="904" y="264" font-size="13.5" font-weight="700" fill="#1b1d22">{t.node5Title}</text>
            <text x="904" y="285" font-size="10.5" fill="#23262d">{t.node5Items[0]}</text>
            <text x="904" y="303" font-size="10.5" fill="#23262d">{t.node5Items[1]}</text>
            <text x="904" y="321" font-size="10.5" font-weight="600" fill="#1b1d22">{t.node5Items[2]}</text>
            <text x="904" y="339" font-size="10.5" fill="#23262d">{t.node5Items[3]}</text>
          </g>
        </g>

        <!-- STEP 11: 审计结果与证据包汇入 Verifier 质量层 -->
        <g class="wf-step step-11">
          <!-- 审计结果斜线：从 5 的左边缘 (890, 286) 接入 Verifier 右侧 (518, 332) -->
          <path d="M 890 286 L 518 332" stroke="#24262b" stroke-width="1.8" marker-end="url(#wf-arrow)" class="flow-draw-line" />
          <path d="M 890 286 L 518 332" stroke="#bd4754" stroke-width="1.8" class="stream-line" />
          <g class="flow-label">
            <rect x={isEn ? "715" : "730"} y="295" width={isEn ? "82" : "56"} height="20" rx="4" fill="rgba(255, 255, 255, 0.8)" />
            <text x={isEn ? "756" : "758"} y="309" text-anchor="middle" font-size="10.2" fill="#555c68" font-weight="500">{t.auditResult}</text>
          </g>
          
          <!-- 标准化证据材料包连线 (Col 2 内部纵向)：从数据层底部到 Verifier 顶部 (417, 301) -->
          <path d="M 417 194 L 417 218" stroke="#24262b" stroke-width="1.8" class="flow-draw-line" />
          <path d="M 417 218 L 417 301" stroke="#4b5563" stroke-width="1.8" stroke-dasharray="6,5" marker-end="url(#wf-arrow-dashed)" class="flow-draw-line" />
          <g class="flow-label">
            <text x="417" y="228" text-anchor="middle" font-size="10.5" fill="#555c68" font-weight="500">{t.stdDossier}</text>
            <rect x={isEn ? "377" : "389"} y="246" width={isEn ? "86" : "56"} height="20" rx="4" fill="rgba(255, 255, 255, 0.8)" />
            <text x={isEn ? "420" : "417"} y="260" text-anchor="middle" font-size="10.2" fill="#606674" font-weight="500">{t.qualityCheck}</text>
          </g>
        </g>

        <!-- STEP 12: Verifier 质量层就绪 (Col 2 Bottom, x: 320, w: 195, y: 304, h: 122) -->
        <g class="wf-step step-12">
          <g class="wf-node">
            <rect x="323" y="307" width="195" height="122" rx="9" fill="#24262b" />
            <rect x="320" y="304" width="195" height="122" rx="8" fill="#64c4b6" stroke="#24262b" stroke-width="1.8" />
            <text x="333" y="330" font-size="13.5" font-weight="700" fill="#1b1d22">{t.verifierTitle}</text>
            <text x="333" y="351" font-size="10.5" fill="#23262d">{t.verifierItems[0]}</text>
            <text x="333" y="370" font-size="10.5" fill="#23262d">{t.verifierItems[1]}</text>
            <text x="333" y="389" font-size="10.5" fill="#23262d">{t.verifierItems[2]}</text>
          </g>
        </g>

        <!-- STEP 13: 建立 SSE 流向前端交付传输 (Col 2 -> Col 1, x: 320 -> 230, Gap: 90px) -->
        <!-- SSE 药丸端正悬浮在两卡片之间的交付通道中央（x: 251~301），距左右卡片各有 21px 呼吸边距，绝对不压在任何卡片或边框上！ -->
        <g class="wf-step step-13">
          <!-- Line reaches x: 233 (leaving 3px margin to node 6 border) -->
          <path d="M 320 365 L 233 365" stroke="#24262b" stroke-width="1.8" marker-end="url(#wf-arrow)" class="flow-draw-line" />
          <path d="M 320 365 L 233 365" stroke="#6b5ec7" stroke-width="1.8" class="stream-line" />
          <g class="badge-pill">
            <rect x={isEn ? "245" : "251"} y="354" width={isEn ? "64" : "50"} height="22" rx="11" fill="#ffffff" stroke="#24262b" stroke-width="1.3" filter="drop-shadow(1.5px 1.5px 0px #24262b)" />
            <text x={isEn ? "277" : "276"} y="369" text-anchor="middle" font-size="10.2" font-weight="600" fill="#24262b">{t.sseBadge}</text>
          </g>
        </g>

        <!-- STEP 14: 6. 前端交付完整呈现 (Col 1 Bottom, x: 40, w: 190, y: 304, h: 122) -->
        <g class="wf-step step-14">
          <g class="wf-node">
            <rect x="43" y="307" width="190" height="122" rx="9" fill="#24262b" />
            <rect x="40" y="304" width="190" height="122" rx="8" fill="#9d91e6" stroke="#24262b" stroke-width="1.8" />
            <text x="52" y="330" font-size="13.5" font-weight="700" fill="#1b1d22">{t.node6Title}</text>
            <text x="52" y="351" font-size="10.5" fill="#23262d">{t.node6Items[0]}</text>
