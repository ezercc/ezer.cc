<script>
  class WorkflowPipelinePlayer {
    private container: HTMLElement;
    private abortController: AbortController | null = null;
    private textCache = new Map<SVGTextElement, string>();

    constructor(container: HTMLElement) {
      this.container = container;
      this.cacheOriginalTexts();
    }

    private cacheOriginalTexts() {
      const textEls = this.container.querySelectorAll<SVGTextElement>(".wf-node text");
      textEls.forEach((el) => {
        if (!this.textCache.has(el)) {
          this.textCache.set(el, (el.textContent || "").trim());
        }
      });
    }

    public resetAll() {
      if (this.abortController) {
        this.abortController.abort();
      }
      this.abortController = new AbortController();

      // Reset all cards
      this.container.querySelectorAll(".wf-node").forEach((node) => {
        node.classList.remove("is-node-active");
      });

      // Clear texts for typewriter effect
      this.textCache.forEach((origText, el) => {
        el.textContent = "";
      });

      // Reset connecting lines with zero length
      this.container.querySelectorAll<SVGPathElement>(".flow-draw-line").forEach((path) => {
        path.classList.remove("is-line-active");
        try {
          const len = Math.ceil(path.getTotalLength()) || 120;
          path.style.transition = "none";
          path.style.strokeDasharray = `${len} ${len}`;
          path.style.strokeDashoffset = `${len}`;
        } catch (_) {}
      });

      // Reset stream lines, pills and labels
      this.container.querySelectorAll(".stream-line, .stream-line-vert").forEach((line) => {
        line.classList.remove("is-stream-active");
      });
      this.container.querySelectorAll(".badge-pill").forEach((pill) => {
        pill.classList.remove("is-pill-active");
      });
      this.container.querySelectorAll(".flow-label").forEach((lbl) => {
        lbl.classList.remove("is-label-active");
      });
      this.container.querySelectorAll(".role-bubble").forEach((b) => {
        b.classList.remove("is-bubble-active");
      });
    }

    public async play() {
      this.resetAll();
      const signal = this.abortController!.signal;

      const wait = (ms: number) =>
        new Promise<void>((resolve, reject) => {
          const timer = setTimeout(() => resolve(), ms);
          signal.addEventListener("abort", () => {
            clearTimeout(timer);
            reject(new Error("Aborted"));
          });
        });

      // Typewriter effect on a card's text items sequentially
      const showAndTypeNode = async (stepSelector: string, charDelay = 14) => {
        if (signal.aborted) return;
        const stepEl = this.container.querySelector(stepSelector);
        if (!stepEl) return;
        const nodeEl = stepEl.querySelector(".wf-node");
        if (nodeEl) {
          nodeEl.classList.add("is-node-active");
        }
        await wait(100);

        const texts = Array.from(stepEl.querySelectorAll<SVGTextElement>(".wf-node text"));
        for (const textEl of texts) {
          if (signal.aborted) return;
          const fullStr = this.textCache.get(textEl) || textEl.textContent || "";
          textEl.textContent = "";
          for (let i = 1; i <= fullStr.length; i++) {
            if (signal.aborted) return;
            textEl.textContent = fullStr.slice(0, i) + (i < fullStr.length ? " ▍" : "");
            await wait(charDelay);
          }
          textEl.textContent = fullStr;
          await wait(30);
        }
      };

      // Draw connecting arrow line from predecessor to successor
      const drawLine = async (stepSelector: string, duration = 250) => {
        if (signal.aborted) return;
        const stepEl = this.container.querySelector(stepSelector);
        if (!stepEl) return;

        const paths = Array.from(stepEl.querySelectorAll<SVGPathElement>(".flow-draw-line"));
        paths.forEach((path) => {
          path.classList.add("is-line-active");
          try {
            const len = Math.ceil(path.getTotalLength()) || 120;
            path.style.strokeDasharray = `${len} ${len}`;
            path.style.strokeDashoffset = `${len}`;
            void path.getBoundingClientRect(); // force layout reflow
            path.style.transition = `stroke-dashoffset ${duration}ms cubic-bezier(0.2, 0.8, 0.3, 1)`;
            path.style.strokeDashoffset = "0";
          } catch (_) {}
        });

        // Pill badge pops up halfway through the line drawing
        setTimeout(() => {
          if (signal.aborted) return;
          stepEl.querySelectorAll(".badge-pill").forEach((p) => p.classList.add("is-pill-active"));
          stepEl.querySelectorAll(".flow-label").forEach((l) => l.classList.add("is-label-active"));
          stepEl.querySelectorAll(".stream-line, .stream-line-vert").forEach((s) => s.classList.add("is-stream-active"));
        }, duration * 0.45);

        await wait(duration + 35);
      };

      try {
        // 1. 卡片 1 (前端触发) 上浮出现 + 打字机
        await showAndTypeNode(".step-1");

        // 2. 箭头从 1 出发画向 2，携带 [请求] 药丸
        await drawLine(".step-2", 250);

        // 3. 卡片 2 (数据层) 顺势上浮出现 + 打字机
        await showAndTypeNode(".step-3");

        // 4. 箭头从 2 出发画向 3，携带 [材料包] 药丸
        await drawLine(".step-4", 250);

        // 5. 卡片 3 (编排层) 顺势上浮出现 + 打字机
        await showAndTypeNode(".step-5");

        // 6. 编排层规则门控下发 -> 运行护栏顺势上浮 + 动态分析角色气泡
        drawLine(".step-6", 230);
        await wait(80);
        await showAndTypeNode(".step-6");

        const roleBubble = this.container.querySelector(".role-bubble");
        if (roleBubble) roleBubble.classList.add("is-bubble-active");

        // 7. 箭头从 3 出发画向 4，携带 [分析输入] 药丸
        await drawLine(".step-7", 250);

        // 8. 卡片 4 (分析模型 B) 顺势上浮出现 + 打字机
        await showAndTypeNode(".step-8");

        // 9. 垂直箭头从 4 出发画向 5，携带 [JSONL 分析卡]
        await drawLine(".step-9", 190);

        // 10. 卡片 5 (审计模型 C) 顺势上浮出现 + 打字机
        await showAndTypeNode(".step-10");

        // 11. 审计结果斜线 (5 -> Verifier) 与 材料包校验垂线同时接入 Verifier
        drawLine(".step-11", 280);
        await wait(260);

        // 12. 卡片 Verifier 质量层 顺势上浮出现 + 打字机
        await showAndTypeNode(".step-12");

        // 13. SSE 流连线从 Verifier 出发画向左侧，携带 [SSE 流] 药丸
        await drawLine(".step-13", 250);

        // 14. 卡片 6 (前端交付) 顺势上浮出现 + 打字机，全链路贯通！
        await showAndTypeNode(".step-14");

      } catch (_) {
        // Aborted on reset or navigation
      }
    }
  }

  function initWorkflowInteractions() {
    const card = document.getElementById("ezer-workflow-trigger");
    const modal = document.getElementById("ezer-workflow-modal");
    const closeBtn = document.getElementById("ezer-workflow-close-btn");
    const modalContent = document.getElementById("ezer-workflow-modal-content");
    const replayBtn = document.getElementById("ezer-workflow-replay-btn");

    if (!card) return;

    // Teleport Modal directly to document.body to break free from any ancestor containing block
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const player = new WorkflowPipelinePlayer(card);

    // Trigger sequential playback when scrolled into view
    let hasPlayed = false;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasPlayed) {
            hasPlayed = true;
            card.classList.add("is-container-visible");
            player.play();
            observer.unobserve(card);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -40px 0px",
      }
    );

    observer.observe(card);

    // Replay interaction
    if (replayBtn) {
      replayBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        player.play();
      });
    }

    // Modal Zoom Open / Close & Mobile Landscape Management
    if (modal && closeBtn && modalContent) {
      const rotateBtn = document.getElementById("ezer-workflow-rotate-btn");

      function isMobilePortrait() {
        return window.innerWidth <= 768 && window.innerHeight >= window.innerWidth;
      }

      function updateRotateBtnState(isLandscape: boolean) {
        if (!rotateBtn) return;
        const textSpan = rotateBtn.querySelector(".rotate-btn-text");
        if (textSpan) {
          const portraitText = rotateBtn.getAttribute("data-text-portrait") || "转为竖屏";
          const landscapeText = rotateBtn.getAttribute("data-text-landscape") || "旋转横屏";
          textSpan.textContent = isLandscape ? portraitText : landscapeText;
        }
      }

      function openModal() {
        if (modalContent && modalContent.children.length === 0) {
          const svg = card?.querySelector(".workflow-svg");
          if (svg) {
            const clone = svg.cloneNode(true) as SVGElement;
            // Restore all full texts in cloned modal view
            clone.querySelectorAll(".wf-node text").forEach((t) => {
              const fullStr = t.getAttribute("data-full-text");
              if (fullStr) t.textContent = fullStr;
            });
            modalContent.appendChild(clone);
          }
        }

        // 手机竖屏状态下，放大直接自动切入横屏大图视角
        if (isMobilePortrait()) {
          modal?.classList.add("is-mobile-landscape");
          updateRotateBtnState(true);
          // 针对支持原生方向锁定的设备尝试硬件锁横屏
          try {
            if (screen.orientation && "lock" in screen.orientation) {
              (screen.orientation as any).lock("landscape").catch(() => {});
            }
          } catch (_) {}
        } else {
          modal?.classList.remove("is-mobile-landscape");
          updateRotateBtnState(false);
        }

        modal?.classList.add("is-open");
        modal?.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        modal?.classList.remove("is-open");
        modal?.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";

        // 解除硬件方向锁定
        try {
          if (screen.orientation && "unlock" in screen.orientation) {
            screen.orientation.unlock();
          }
        } catch (_) {}
      }

      // 手动切换横/竖屏按钮
      if (rotateBtn) {
        rotateBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const willBeLandscape = !modal.classList.contains("is-mobile-landscape");
          modal.classList.toggle("is-mobile-landscape", willBeLandscape);
          updateRotateBtnState(willBeLandscape);
        });
      }

      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("#ezer-workflow-replay-btn")) {
          return;
        }
        openModal();
      });

      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openModal();
        }
      });

      closeBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        closeModal();
      });

      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal?.classList.contains("is-open")) {
          closeModal();
        }
      });
    }
  }

  initWorkflowInteractions();
  document.addEventListener("astro:page-load", initWorkflowInteractions);
</script>
