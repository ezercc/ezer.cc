---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { pwaInfo } from "virtual:pwa-info";

const { title, description, keywords, ogImage } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const metaDescription = description || t("seo.default_description");
const metaKeywords = keywords || t("seo.default_keywords");

const links = [
  { title: t("nav.home"), url: lang === "zh" ? "/" : "/en/" },
  { title: t("nav.about"), url: lang === "zh" ? "/about/" : "/en/about/" },
  {
    title: t("nav.changelog"),
    url: lang === "zh" ? "/changelog/" : "/en/changelog/",
  },
  { title: t("nav.search"), url: lang === "zh" ? "/search/" : "/en/search/" },
];

const legalLinks = [
  { title: t("nav.terms"), url: lang === "zh" ? "/terms/" : "/en/terms/" },
  {
    title: t("nav.privacy"),
    url: lang === "zh" ? "/privacy/" : "/en/privacy/",
  },
  {
    title: t("nav.refunds"),
    url:
      lang === "zh"
        ? "/refund-and-cancellation/"
        : "/en/refund-and-cancellation/",
  },
  {
    title: t("nav.delivery"),
    url: lang === "zh" ? "/delivery-policy/" : "/en/delivery-policy/",
  },
  {
    title: t("nav.disclaimer"),
    url:
      lang === "zh"
        ? "/financial-research-disclaimer/"
        : "/en/financial-research-disclaimer/",
  },
  {
    title: t("nav.cookies"),
    url: lang === "zh" ? "/cookie-policy/" : "/en/cookie-policy/",
  },
  {
    title: t("nav.contact"),
    url: lang === "zh" ? "/contact/" : "/en/contact/",
  },
];

const isHome =
  Astro.url.pathname === "/" ||
  Astro.url.pathname === "/en" ||
  Astro.url.pathname === "/en/";

// Generate canonical and alternate lang URLs for SEO
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://www.ezer.cc",
);

const pathname = Astro.url.pathname;
const isEn = lang === "en";
let alternatePath = "";
if (isEn) {
  alternatePath = pathname.replace(/^\/en/, "") || "/";
} else {
  alternatePath = pathname === "/" ? "/en/" : `/en${pathname}`;
}
// Normalize duplicate slashes
alternatePath = alternatePath.replace(/\/+/g, "/");
const alternateURL = new URL(
  alternatePath,
  Astro.site || "https://www.ezer.cc",
);

const ogImageURL = new URL(
  ogImage || "/pwa-512x512.png",
  Astro.site || "https://www.ezer.cc",
).toString();

const displayTitle = isHome
  ? title || t("site.name")
  : title
    ? `${title} - ${t("site.name")}`
    : t("site.name");
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={isEn ? "zh" : "en"} href={alternateURL} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={isEn ? alternateURL : canonicalURL}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={displayTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={ogImageURL} />

    <link
      href="https://fonts.cat.net/css2?family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&family=Roboto+Slab:wght@100..900&family=Roboto:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    {
      lang === "en" ? (
        <link rel="manifest" href="/manifest-en.webmanifest" />
      ) : (
        pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />
      )
    }
    <title>{displayTitle}</title>
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      if (theme === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.setAttribute("data-theme", "light");
      }
      window.localStorage.setItem("theme", theme);
    </script>
    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;
        try {
          // If already logged in, do not track affiliate code
          const cookies = document.cookie || "";
          const hasSession = cookies.includes(
            "sb-msufgvqofnihylcnxyac-auth-token",
          );
          if (hasSession) {
            localStorage.removeItem("ezer_aff");
            return;
          }

          const params = new URLSearchParams(window.location.search);
          const affCode = params.get("aff");
          if (affCode) {
            localStorage.setItem("ezer_aff", affCode);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t("accessibility.skip-to-content")}</a>
    <Header
      logoUrl={lang === "zh" ? "/" : "/en/"}
      logoAlt={t("site.name")}
      links={links}
      link2={{ title: t("nav.signin"), url: "#" }}
    >
      <div
        slot="after-nav"
        style="display: flex; align-items: center; gap: 0.8rem;"
      >
        <LanguageSwitcher />
        <ThemeToggle />
      </div>
    </Header>
    <main id="main">
      <slot />
    </main>
    <Footer
      logoUrl={lang === "zh" ? "/" : "/en/"}
      logoAlt={t("footer.logoAlt")}
      copyright={t("footer.copyright")}
      links={links}
      legalLinks={legalLinks}
      entityDisclosure={t("footer.entity")}
      disclaimer={t("footer.disclaimer")}
      supportLabel={t("footer.support")}
      cookieSettingsLabel={t("footer.cookie_settings")}
      supportEmail="joe@ezerlab.org"
    />
    <CookieConsent />
    <SmoothScroll />
  </body>
</html>

<style>
  .skip-link {
    background: var(--color-brand-1);
    left: 0;
    right: 0;
    margin: auto;
    width: min-content;
    white-space: nowrap;
    padding: 0.5rem;
    position: absolute;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
    z-index: 100;
  }

  .skip-link:focus {
    transform: translateY(0%);
  }
</style>

<script>
  import "../utils/reveals";
  import "../scripts/auth.js";

  // Persist affiliate state across client-side page views/transitions
  async function handleAffiliateState() {
    try {
      // @ts-ignore
      if (window.auth) {
        // @ts-ignore
        const session = await window.auth.getSession();
        if (session) {
          localStorage.removeItem("ezer_aff");
          return;
        }
      }
      const params = new URLSearchParams(window.location.search);
      const affCode = params.get("aff");
      if (affCode) {
        localStorage.setItem("ezer_aff", affCode);
      }
    } catch (e) {
      console.warn("Failed to handle affiliate state:", e);
    }
  }

  handleAffiliateState();
  document.addEventListener("astro:after-swap", handleAffiliateState);
  document.addEventListener("astro:page-load", handleAffiliateState);
</script>
