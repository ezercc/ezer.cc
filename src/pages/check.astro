<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  // ── i18n strings passed from Astro ──
  const metaEl = document.querySelector('meta[name="check-i18n"]');
  const i18n = metaEl ? JSON.parse(metaEl.getAttribute('content') || '{}') : {};

  // ── Helper: get lang from URL ──
  const isEn = window.location.pathname.startsWith('/en');
  const lang = isEn ? 'en' : 'zh';

  // ── Grab URL params ──
  const params = new URLSearchParams(window.location.search);
  const code = params.get('code');
  const year = params.get('year');
  const period = params.get('period');
  const preview = params.get('preview');

  let shouldRun = true;
  // 1. No parameters -> Redirect to search
  if (!code && !year && !period && !preview) {
    window.location.href = lang === 'zh' ? '/search/' : '/en/search/';
    shouldRun = false;
  }

  // 2. Auth check if not preview
  if (shouldRun && preview !== 'true') {
    const cookies = document.cookie || '';
    const hasSession = cookies.includes('sb-msufgvqofnihylcnxyac-auth-token');
    
    if (!hasSession) {
      const storedAff = localStorage.getItem('ezer_aff');
      let loginUrl;
      if (storedAff) {
        loginUrl = `https://account.ezer.cc/${lang === 'en' ? 'en/' : ''}login/?aff=${storedAff}&step=register&redirect=${encodeURIComponent(window.location.href)}`;
      } else {
        loginUrl = `https://account.ezer.cc/${lang === 'en' ? 'en/' : ''}login/?redirect=${encodeURIComponent(window.location.href)}`;
      }
      window.location.href = loginUrl;
      shouldRun = false;
    } else {
      localStorage.removeItem('ezer_aff');
    }
  }

  // DOM refs
  const loadingEl = document.getElementById('loading-container')!;
  const errorEl = document.getElementById('error-container')!;
  const resultsEl = document.getElementById('results-container')!;
  const pageTitleEl = document.getElementById('page-title')!;
  const loadingTextEl = document.getElementById('loading-text')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressLabel = document.getElementById('progress-label')!;
  const errorTextEl = document.getElementById('error-text')!;

  const thoughtContainer = document.getElementById('thought-container')!;
  const thoughtToggle = document.getElementById('thought-toggle')!;
  const textB = document.getElementById('text-b') as HTMLElement;
  const textC = document.getElementById('text-c') as HTMLElement;
  const summaryText = document.getElementById('summary-text')!;
  const finalResultText = document.getElementById('final-result-text')!;

  // ── Placeholder Manager for B & C ──
  class PlaceholderManager {
    private interval: any = null;
    private messages: string[] = [];
    private currentIndex = 0;

    constructor(private element: HTMLElement, messages: string[]) {
      this.messages = messages;
    }

    start() {
      if (this.messages.length === 0) return;
      this.element.classList.add('is-placeholder');
      this.element.textContent = this.messages[0];
      this.interval = setInterval(() => {
        this.currentIndex = (this.currentIndex + 1) % this.messages.length;
        this.element.textContent = this.messages[this.currentIndex];
      }, 3000);
    }

    stop() {
      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
        this.element.textContent = '';
        this.element.classList.remove('is-placeholder');
      }
    }

    isActive() {
      return this.interval !== null;
    }
  }

  const bcMessages = lang === 'zh' ? [
    '正在多维核对财报钩稽关系...',
    '正在执行收入截止性测试...',
    '正在分析营运资金周转效率...',
    '正在评估资产减值准备计提...',
    '正在核算加权平均资本成本...',
    '正在比对历史趋势异常波动...',
    '正在检验研发投入资本化比例...',
    '正在审计关联方交易公允性...',
    '正在验证存货周转率合理性...',
    '正在解析财报附注深度内涵...',
    '正在扫描潜在表外融资风险...'
  ] : [
    'Cross-checking financial statement integrity...',
    'Performing revenue cutoff tests...',
    'Analyzing working capital efficiency...',
    'Evaluating asset impairment provisions...',
    'Calculating Weighted Average Cost of Capital...',
    'Inspecting historical trend anomalies...',
    'Verifying R&D capitalization ratios...',
    'Auditing related-party transaction fairness...',
    'Validating inventory turnover logic...',
    'Parsing deep insights from footnotes...',
    'Scanning for off-balance sheet risks...'
  ];

  const placeholderB = new PlaceholderManager(textB, bcMessages);
  const placeholderC = new PlaceholderManager(textC, bcMessages);

  // Initialize Summary Placeholder
  summaryText.textContent = lang === 'zh' ? '正在等待分析完成...' : 'Waiting for analysis to complete...';
  summaryText.classList.add('is-placeholder');

  // Toggle thought process
  thoughtToggle.addEventListener('click', () => {
    thoughtContainer.classList.toggle('is-collapsed');
    thoughtToggle.setAttribute('aria-expanded', String(!thoughtContainer.classList.contains('is-collapsed')));
  });

  // ── Chart Manager ──
  class ChartManager {
    private charts: Record<string, any> = {};

    private getOptions(suffix: string, isRate: boolean) {
      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#94a3b8' : '#64748b';
      const gridColor = isDark ? 'rgba(148, 163, 184, 0.1)' : 'rgba(100, 116, 139, 0.1)';
      const growthSuffix = '%';

      return {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            mode: 'index',
            intersect: false,
            itemSort: (a: any, b: any) => a.datasetIndex - b.datasetIndex,
            usePointStyle: true,
            boxWidth: 8,
            boxHeight: 8,
            callbacks: {
              label: (context: any) => {
                let l = context.dataset.label || '';
                if (l) l += ': ';
                const val = context.parsed.y;
                if (val !== null) {
                  if (context.datasetIndex === 0) {
                    l += val.toLocaleString() + suffix;
                  } else {
                    l += (val >= 0 ? '+' : '') + val.toFixed(2) + growthSuffix;
                  }
                }
                return l;
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: textColor, font: { size: 10 } }
          },
          y: {
            position: 'left',
            grid: { color: gridColor },
            ticks: { 
              color: textColor, 
              font: { size: 10 },
              callback: (value: any) => {
                if (suffix === '%') return value + '%';
                if (value >= 100000000) return (value / 100000000).toFixed(1) + (lang === 'zh' ? '亿' : 'B');
                if (value >= 10000) return (value / 10000).toFixed(0) + (lang === 'zh' ? '万' : 'k');
                return value;
              }
            }
          },
          y1: {
            position: 'right',
            grid: { display: false },
            ticks: {
              color: textColor,
              font: { size: 10 },
              callback: (value: any) => value + growthSuffix
            }
          }
        }
      };
    }

    render(id: string, data: any[], label: string, suffix: string = '') {
      const ctx = document.getElementById(id) as HTMLCanvasElement;
      if (!ctx) return;

      const container = ctx.closest('.chart-item') as HTMLElement;
      if (container) {
        container.style.display = 'flex';
        setTimeout(() => container.classList.add('is-visible'), 10);
      }

      const sectionA = document.querySelector('.section-a');
      if (sectionA) sectionA.classList.remove('hidden');

      if (this.charts[id]) {
        this.charts[id].destroy();
      }

      const isRate = label.includes('Revenue') || label.includes('营业收入') || 
                     label.includes('Net Profit') || label.includes('净利润');
      
      const growthData = data.map((d, i) => {
        if (i === 0) return null;
        const prev = data[i-1].value;
        const curr = d.value;
        if (prev === null || curr === null) return null;
        return isRate ? (prev === 0 ? 0 : ((curr - prev) / Math.abs(prev)) * 100) : (curr - prev);
      });

      // @ts-ignore
      this.charts[id] = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: data.map(d => d.period),
          datasets: [
            {
              label: label,
              data: data.map(d => d.value),
              backgroundColor: 'rgba(124, 58, 237, 0.2)',
              borderColor: 'rgba(124, 58, 237, 0.8)',
              borderWidth: 1,
              borderRadius: 4,
              yAxisID: 'y',
              order: 2,
              pointStyle: 'rect',
            },
            {
              label: lang === 'zh' ? (isRate ? '环比增长率' : '环比增长量') : (isRate ? 'Growth Rate' : 'Growth Amt'),
              data: growthData,
              type: 'line',
              borderColor: '#f59e0b',
              backgroundColor: '#f59e0b',
              borderWidth: 2,
              pointRadius: 3,
              pointBackgroundColor: '#f59e0b',
              tension: 0.4,
              yAxisID: 'y1',
              order: 1,
              pointStyle: 'rect',
            }
          ]
        },
        options: this.getOptions(suffix, isRate)
      });
    }
  }

  const chartManager = new ChartManager();

  /**
   * Simple Typewriter effect for streaming feel
   */
  class Typewriter {
    private queue: { text?: string; html?: string }[] = [];
    private isRunning = false;
    private speed = 15; // ms per char
    private scrollParent: HTMLElement | null = null;

    constructor(private element: HTMLElement) {
      this.scrollParent = element.closest('.scroll-wrapper-b') || element.closest('.text-output');
    }

    write(text: string) {
      if (!text) return;
      this.queue.push({ text });
      if (!this.isRunning) this.run();
    }

    writeHTML(html: string) {
      if (!html) return;
      this.queue.push({ html });
      if (!this.isRunning) this.run();
    }

    private async run() {
      this.isRunning = true;
      this.element.classList.remove('is-done');
      while (this.queue.length > 0) {
        const item = this.queue.shift();
        if (!item) continue;

        if (item.html) {
          this.element.insertAdjacentHTML('beforeend', item.html);
          this.autoScroll();
          await new Promise(r => setTimeout(r, 200));
        } else if (item.text) {
          const chars = item.text.split('');
          for (const char of chars) {
            this.element.insertAdjacentText('beforeend', char);
            if (char === '\n') this.autoScroll();
            await new Promise(r => setTimeout(r, this.speed));
          }
        }
        this.autoScroll();
      }
      this.isRunning = false;
      this.element.classList.add('is-done');
    }

    private autoScroll() {
      if (this.scrollParent) {
        this.scrollParent.scrollTo({
          top: this.scrollParent.scrollHeight,
          behavior: 'smooth'
        });
      }
    }

    done() {
      this.element.classList.add('is-done');
    }
  }

  const writers = {
    b: new Typewriter(textB),
    c: new Typewriter(textC),
    summary: new Typewriter(summaryText),
  };

  async function renderCharts(history: any[]) {
    if (!history || history.length === 0) return;
    
    // Sort to show chronological order
    const sorted = [...history].sort((a, b) => {
        return a.reporting_period.localeCompare(b.reporting_period);
    });

    const revenueData = sorted.map(h => ({ period: h.reporting_period, value: h.revenue }));
    const profitData = sorted.map(h => ({ period: h.reporting_period, value: h.net_profit }));
    const marginData = sorted.map(h => ({ period: h.reporting_period, value: h.gross_margin }));
    const debtData = sorted.map(h => ({ period: h.reporting_period, value: h.debt_to_asset }));

    const chartConfigs = [
      { id: 'chart-revenue', data: revenueData, label: formatKey('revenue'), suffix: '' },
      { id: 'chart-profit', data: profitData, label: formatKey('net_profit'), suffix: '' },
      { id: 'chart-margin', data: marginData, label: formatKey('gross_margin'), suffix: '%' },
      { id: 'chart-debt', data: debtData, label: formatKey('debt_to_asset'), suffix: '%' },
    ];

    for (const config of chartConfigs) {
      if (config.data.some(d => d.value !== null && d.value !== undefined)) {
        chartManager.render(config.id, config.data, config.label, config.suffix);
        await new Promise(r => setTimeout(r, 600)); // Sequential delay for streaming feel
      }
    }
  }

  function formatSymbol(codeParam: string | null): string {
    if (!codeParam) return '';
    if (codeParam.includes('.')) return codeParam;
    const match = codeParam.match(/^([a-z]+)(\d+)$/i);
    if (match) {
      return `${match[2]}.${match[1].toUpperCase()}`;
    }
    return codeParam;
  }

  function formatKey(key: string): string {
    const map: Record<string, string> = {
      'name': lang === 'zh' ? '公司名称' : 'Company Name',
      'ticker': lang === 'zh' ? '股票代码' : 'Ticker',
      'reporting_period': lang === 'zh' ? '报告期' : 'Period',
      'release_date': lang === 'zh' ? '发布日期' : 'Release Date',
      'revenue': lang === 'zh' ? '营业收入' : 'Revenue',
      'net_profit': lang === 'zh' ? '净利润' : 'Net Profit',
      'gross_margin': lang === 'zh' ? '毛利率' : 'Gross Margin',
      'roe': lang === 'zh' ? 'ROE' : 'ROE',
      'total_assets': lang === 'zh' ? '总资产' : 'Total Assets',
      'total_liabilities': lang === 'zh' ? '总负债' : 'Total Liabs',
      'debt_to_asset': lang === 'zh' ? '资产负债率' : 'Debt Ratio',
    };
    return map[key] || key;
  }

  function showError(msg?: string) {
    if (msg) console.error('[Analysis Error Detail]:', msg);
    loadingEl.classList.add('hidden');
    errorEl.classList.remove('hidden');

    const backLink = document.getElementById('back-link');
    const upgradeLink = document.getElementById('upgrade-link');

    // If it's a quota error, swap buttons
    if (msg && msg.toLowerCase().includes('quota exceeded')) {
      errorTextEl.innerHTML = i18n['quota.limit_reached'];
      if (backLink) backLink.classList.add('hidden');
      if (upgradeLink) upgradeLink.classList.remove('hidden');
    } else if (msg && (msg.toLowerCase().includes('unauthorized') || msg.toLowerCase().includes('401'))) {
      errorTextEl.innerHTML = i18n['auth.unauthorized'];
      if (backLink) backLink.classList.remove('hidden');
      if (upgradeLink) upgradeLink.classList.add('hidden');
    } else {
      // Normal error
      if (backLink) backLink.classList.remove('hidden');
      if (upgradeLink) upgradeLink.classList.add('hidden');
    }
  }

  async function typeText(el: HTMLElement, text: string, speed = 20) {
    if (!el || !text) return;
    const chars = text.split('');
    for (const char of chars) {
      el.textContent += char;
      if (char === '\n' || char === '。' || char === '.') {
        const scrollParent = el.closest('.scroll-wrapper-b') || el.closest('.text-output');
        if (scrollParent) scrollParent.scrollTo({ top: scrollParent.scrollHeight, behavior: 'smooth' });
      }
      await new Promise(r => setTimeout(r, speed));
    }
    // Final scroll
    const scrollParent = el.closest('.scroll-wrapper-b') || el.closest('.text-output');
    if (scrollParent) scrollParent.scrollTo({ top: scrollParent.scrollHeight, behavior: 'smooth' });
  }

  function setProgress(pct: number, label?: string) {
    progressBar.style.width = pct + '%';
    progressLabel.textContent = pct + '%';
    if (label) loadingTextEl.textContent = label;
  }

  function formatDetailValue(value: unknown): string {
    if (typeof value === 'string') return value.trim();

    if (Array.isArray(value)) {
      return value
        .map(formatDetailValue)
        .filter(Boolean)
        .join(', ');
    }

    if (value && typeof value === 'object') {
      const record = value as Record<string, unknown>;
      for (const key of ['text', 'content', 'detail', 'summary', 'message', 'description']) {
        const text = formatDetailValue(record[key]);
        if (text) return text;
      }

      try {
        return JSON.stringify(value);
      } catch {
        return '';
      }
    }

    if (typeof value === 'number') return Number.isFinite(value) ? String(value) : '';
    if (typeof value === 'boolean') return String(value);
    return '';
  }

  /**
   * Process a single event from the stream
   */
  async function processEvent(item: any) {
    if (!item) return;
    console.log('[Stream Event]', item);
    const { producer, event, data } = item;
    const value = item.value || data; // Handle alternate field names

    if (event === 'a_data') {
      const { label, data: chartData, type, suffix } = value;
      if (label && chartData) {
        const idMap: Record<string, string> = {
          'Revenue': 'chart-revenue',
          '营业收入': 'chart-revenue',
          'Net Profit': 'chart-profit',
          '净利润': 'chart-profit',
          'Gross Margin': 'chart-margin',
          '毛利率': 'chart-margin',
          'Debt Ratio': 'chart-debt',
          '资产负债率': 'chart-debt'
        };
        const id = idMap[label] || `chart-${label.toLowerCase()}`;
        chartManager.render(id, chartData.map((d:any) => typeof d === 'object' ? d : {period: '', value: d}), label, suffix || '');
        await new Promise(r => setTimeout(r, 400));
      }
      return;
    }

    // Normalize producer name (A, B, C or normalizer, analyzer, auditor)
    const p = (producer || '').toUpperCase();

    // Industry News Event (Section I)
    if (event === 'i_industry_wordsea' || event === 'industry_wordsea' || event === 'i_industry_word_cloud' || (p === 'I' && (event === 'data' || event === 'wordsea' || event === 'i_industry_wordsea'))) {
      const industryGrid = document.querySelector('.industry-grid');
      if (industryGrid) industryGrid.classList.remove('hidden');
      
      let d = data || item.data || item;
      if (typeof d === 'string') {
        try {
          d = JSON.parse(d);
        } catch (e) {}
      }
      
      const rows = d && (d.rows || d.items || d.list || (Array.isArray(d) ? d : null));
      if (rows && Array.isArray(rows)) {
        const keywords = rows.map((row: any) => {
          const keyword = Array.isArray(row) ? row[0] : (row.keyword || row.word || '');
          const count = Array.isArray(row) ? row[1] : (row.count || row.weight || 1);
          return [keyword, count];
        });
        const newsMap = new Map();
        rows.forEach((row: any) => {
          const keyword = Array.isArray(row) ? row[0] : (row.keyword || row.word || '');
          const count = Array.isArray(row) ? row[1] : (row.count || row.weight || 1);
          const articles = Array.isArray(row) ? row[2] : (row.links || row.articles || []);
          newsMap.set(keyword, { articles, totalCount: count });
        });
        renderWordCloud(keywords, newsMap);
      }
      return;
    }

    if ((p === 'A' || p === 'NORMALIZER') && (event === 'a_normalized' || event === 'data')) {
      const d = data || item.data;
      if (!d) return;
      
      const { company, report, income_statement, balance_sheet, key_ratios, history_12q } = d;
      
      if (history_12q) {
        await renderCharts(history_12q);
      }

      if (company) {
        const companyName = company.name || '';
        let periodText = company.reporting_period || '';
        if (lang === 'zh' && periodText.toLowerCase().includes('fy')) {
          periodText = periodText.replace(/fy/i, '年度');
        }

        if (companyName) {
          const titleSuffix = lang === 'zh' ? '财报分析' : 'Financial Report Analysis';
          pageTitleEl.textContent = `${companyName} (${periodText}) ${titleSuffix}`;
          document.title = `${companyName} (${periodText}) ${titleSuffix} - 弈泽`;
        }
      }
    }

    if ((p === 'B' || p === 'ANALYZER')) {
      if (placeholderB.isActive()) placeholderB.stop();
      const d = data || item.data;
      if (!d) return;

      if (event === 'b_progress') {
        const stepPrefix = lang === 'zh' ? '正在' : 'Analyzing';
        writers.b.writeHTML(`<div class="progress-update"><i>› ${stepPrefix} ${d.task || d.step || (lang === 'zh' ? '执行分析' : 'Performing Analysis')}...</i></div>`);
        return;
      }

      if (event === 'b_card' || event === 'analysis') {
        const cardId = d.card_id || 'unknown';
        
        // Find if this card is already rendered (self-healing / merge logic)
        let card = writers.b.element.querySelector(`.analysis-card[data-card-id="${cardId}"]`) as HTMLElement;
        const isNewCard = !card;
        
        if (isNewCard) {
          card = document.createElement('div');
          card.className = 'analysis-card';
          card.dataset.cardId = cardId;
          writers.b.element.appendChild(card);
        } else {
          // Reset card content for reload
          card.innerHTML = '';
        }

        // Title fallback logic
        const CARD_TITLES: Record<string, Record<string, string>> = {
          business_outlook: {
            zh: "经营展望",
            en: "Business Outlook",
          },
        };
        const titleText = (d.title && d.title.trim())
          || CARD_TITLES[cardId]?.[lang]
          || cardId;
        
        const h3 = document.createElement('h3');
        h3.textContent = titleText;
        card.appendChild(h3);
        
        // Skip typewriter animation for business_outlook or long text paragraphs
        const skipAnimation = cardId === 'business_outlook' || (d.conclusion && d.conclusion.length > 150);
        
        const conclusion = document.createElement('p');
        conclusion.className = 'conclusion';
        card.appendChild(conclusion);
        
        if (d.conclusion) {
          if (skipAnimation) {
            conclusion.textContent = d.conclusion;
          } else {
            await typeText(conclusion, d.conclusion, 15);
          }
        }

        const detailsList = document.createElement('ul');
        detailsList.className = 'details-list';
        card.appendChild(detailsList);

        const fields = [
          { key: 'evidence', label: lang === 'zh' ? '依据' : 'Evidence' },
          { key: 'cross_checks', label: lang === 'zh' ? '交叉验证' : 'Cross-checks' },
          { key: 'counterpoints', label: lang === 'zh' ? '反向观点' : 'Counterpoints' }
        ];

        for (const field of fields) {
          const text = formatDetailValue(d[field.key]);
          if (text) {
            const li = document.createElement('li');
            li.innerHTML = `<span class="label">${field.label}:</span> `;
            const textSpan = document.createElement('span');
            li.appendChild(textSpan);
            detailsList.appendChild(li);
            if (skipAnimation) {
              textSpan.textContent = text;
            } else {
              await typeText(textSpan, text, 10);
            }
          }
        }

        if (d.investor_implication) {
          const implication = document.createElement('p');
          implication.className = 'implication';
          const labelImplication = lang === 'zh' ? '投资启示' : 'Investor Implication';
          implication.innerHTML = `<span class="label">${labelImplication}:</span> `;
          const textSpan = document.createElement('span');
          implication.appendChild(textSpan);
          card.appendChild(implication);
          if (skipAnimation) {
            textSpan.textContent = d.investor_implication;
          } else {
            await typeText(textSpan, d.investor_implication, 15);
          }
        }

        // Render sources (source_refs) with deduplication
        if (d.source_refs && Array.isArray(d.source_refs) && d.source_refs.length > 0) {
          const sourceContainer = document.createElement('div');
          sourceContainer.className = 'source-refs-container';
          sourceContainer.style.marginTop = '14px';
          sourceContainer.style.paddingTop = '10px';
          sourceContainer.style.borderTop = '1px dashed rgba(255,255,255,0.08)';
          sourceContainer.style.fontSize = '0.85em';
          sourceContainer.style.opacity = '0.8';
          
          const labelSources = lang === 'zh' ? '数据来源: ' : 'Sources: ';
          sourceContainer.innerHTML = `<span class="label" style="font-weight:600;color:var(--color-brand-1);margin-right:6px;">${labelSources}</span>`;
          
          const sourceListSpan = document.createElement('span');
          
          // Deduplicate refs by source_url + section_id
          const seen = new Set();
          const uniqueRefs = d.source_refs.filter((ref: any) => {
            if (!ref) return false;
            const key = `${ref.source_url || ''}_${ref.section_id || ''}`;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });
          
          uniqueRefs.forEach((ref: any, idx: number) => {
            const periodText = ref.report_period ? `[${ref.report_period}] ` : '';
            const nameText = ref.source_name || '';
            const locatorText = ref.source_locator ? ` (${ref.source_locator})` : '';
            const displayText = `${periodText}${nameText}${locatorText}`;
            
            const refSpan = document.createElement('span');
            refSpan.style.display = 'inline-block';
            refSpan.style.marginRight = '10px';
            
            if (ref.source_url && ref.source_url.trim()) {
              const a = document.createElement('a');
              a.href = ref.source_url.trim();
              a.target = '_blank';
              a.rel = 'noreferrer';
              a.textContent = displayText;
              a.style.color = 'var(--color-brand-1)';
              a.style.textDecoration = 'underline';
              refSpan.appendChild(a);
            } else {
              refSpan.textContent = displayText;
            }
            
            if (idx > 0) {
              sourceListSpan.appendChild(document.createTextNode(', '));
            }
            sourceListSpan.appendChild(refSpan);
          });
          
          sourceContainer.appendChild(sourceListSpan);
          card.appendChild(sourceContainer);
        }
      }
    }

    if ((p === 'C' || p === 'AUDITOR')) {
      if (placeholderC.isActive()) placeholderC.stop();
      const d = data || item.data;
      if (!d) return;

      if (event === 'c_progress') {
        const stepPrefix = lang === 'zh' ? '正在' : 'Analyzing';
        writers.c.writeHTML(`<div class="progress-update"><i>› ${stepPrefix} ${d.task || d.step || (lang === 'zh' ? '执行审计' : 'Performing Audit')}...</i></div>`);
        return;
      }

      if (event === 'c_challenge') {
        const challengeKey = d.target_card_id || d.issue || '';
        let div = writers.c.element.querySelector(`.audit-item.challenge[data-challenge-key="${challengeKey}"]`) as HTMLElement;
        const isNew = !div;
        
        if (isNew) {
          div = document.createElement('div');
          div.className = 'audit-item challenge';
          div.dataset.challengeKey = challengeKey;
          writers.c.element.appendChild(div);
        } else {
          div.innerHTML = '';
        }

        const labelChallenge = lang === 'zh' ? '审计挑战' : 'Audit Challenge';
        div.innerHTML = `<div class="audit-icon-text"><i class="fa-solid fa-triangle-exclamation"></i> ${labelChallenge} (${d.severity || 'MEDIUM'})</div>`;
        const content = document.createElement('div');
        content.className = 'audit-content';
        div.appendChild(content);
        if (d.target_card_id) {
          const meta = document.createElement('div');
          meta.className = 'audit-meta';
          const labelTarget = lang === 'zh' ? '针对' : 'Target';
          meta.textContent = `${labelTarget}: ${d.target_card_id}`;
          div.appendChild(meta);
        }
        if (d.issue) await typeText(content, d.issue, 15);
      }

      if (event === 'c_resolved' || event === 'audit') {
        const resolvedKey = d.target_card_id || d.rationale || d.content || d.text || '';
        let div = writers.c.element.querySelector(`.audit-item.resolved[data-resolved-key="${resolvedKey}"]`) as HTMLElement;
        const isNew = !div;
        
        if (isNew) {
          div = document.createElement('div');
          div.className = 'audit-item resolved';
          div.dataset.resolvedKey = resolvedKey;
          writers.c.element.appendChild(div);
        } else {
          div.innerHTML = '';
        }

        const labelResolved = lang === 'zh' ? '审计通过' : 'Audit Resolved';
        div.innerHTML = `<div class="audit-icon-text"><i class="fa-solid fa-circle-check"></i> ${labelResolved}</div>`;
        const content = document.createElement('div');
        content.className = 'audit-content';
        div.appendChild(content);
        if (d.target_card_id) {
          const meta = document.createElement('div');
          meta.className = 'audit-meta';
          const labelFix = lang === 'zh' ? '解决项' : 'Fixed';
          meta.textContent = `${labelFix}: ${d.target_card_id}`;
          div.appendChild(meta);
        }
        const textToType = d.rationale || d.content || d.text || '';
        if (textToType) await typeText(content, textToType, 15);
      }
    }


    if (event === 'final_summary' || event === 'summary') {
      if (summaryText.classList.contains('is-placeholder')) {
        summaryText.textContent = '';
        summaryText.classList.remove('is-placeholder');
      }
      const d = data || item.data;
      if (d) {
        const text = d.summary || d.content || d.text || '';
        await typeText(summaryText, text, 15);
      }
    }

    if (event === 'final_result' || event === 'result') {
      const d = data || item.data;
      if (d) {
        finalResultText.classList.remove('hidden');
        const prefix = lang === 'zh' ? '最终结果：' : 'Final Result: ';
        finalResultText.textContent = prefix + (d.final_status || d.status || d.result || '');
      }
    }

    if (event === 'error' || event === 'task_failed') {
      const d = data || item.data;
      const msg = d?.message || d?.error || 'Unknown error occurred';
      showError(msg);
      return;
    }
  }

  /**
   * Main logic to handle simulated stream
   */
  async function processStream(stream: any[]) {
    loadingEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    // Start placeholders
    placeholderB.start();
    placeholderC.start();

    for (const item of stream) {
      processEvent(item);
      await new Promise(r => setTimeout(r, 200));
    }
    window.dispatchEvent(new CustomEvent('analysis-complete'));
  }

  // ── Main entry point ──
  async function main() {
    let collectedData: any[] = [];

    try {


      const apiParams = new URLSearchParams(window.location.search);
      apiParams.set('lang', lang);

      console.log('--- Initiating Audit (Locally checking cache first) ---');
      
      let currentProgress = 5;
      const startTime = Date.now();
      const progressTimer = setInterval(() => {
        const elapsed = Date.now() - startTime;
        if (elapsed < 1200) {
          currentProgress = 5 + (45 * (elapsed / 1200));
        } else if (elapsed < 10000) {
          currentProgress = 50 + (45 * ((elapsed - 1200) / 8800));
        } else {
          currentProgress = 95;
        }
        const label = currentProgress < 50 
          ? (lang === 'zh' ? '正在连接安全审计服务器...' : 'Connecting to audit server...')
          : (lang === 'zh' ? '正在深度穿透财务数据...' : 'Deeply analyzing financial data...');
        setProgress(Math.floor(currentProgress), label);
      }, 50);

      const cleanup = () => clearInterval(progressTimer);

      try {
        const localResp = await fetch(`/api/check?${apiParams.toString()}`);
        if (localResp.status === 401) {
          cleanup();
          showError('unauthorized');
          return;
        }
        // BUG1 Fix: Explicitly intercept 403 (Quota Exceeded) for a clean UI path.
        if (localResp.status === 403) {
          cleanup();
          showError('Quota exceeded');
          return;
        }

        const contentType = localResp.headers.get('content-type');

      // (A) Cache Hit Case: Process as a stream as before
      if (contentType && contentType.includes('application/x-ndjson')) {
        console.log('Cache Hit: Streaming from local API...');
        cleanup(); 
        await handleResponseStream(localResp);
        return;
      }

      // (B) Cache Miss or Error Case: Handle JSON response
      const serverResult = await localResp.json();
      
      if (serverResult.error) {
        throw new Error(serverResult.error);
      }

      // (C) Direct Stream Case: Bypassing Vercel timeouts using pre-initialized task from server
      if (serverResult.action === 'direct_stream') {
        const taskId = serverResult.task_id;
        const tempToken = serverResult.token;

        const streamUrl = serverResult.stream_url;
        const resultUrl = serverResult.result_url;
        const resultBrUrl = serverResult.result_br_url;
        const resultBrRawUrl = serverResult.result_br_raw_url;

        if (!streamUrl) throw new Error('No stream_url from backend');

        // Step 2: Stream from backend with a 5-minute initial connection timeout
        const controller = new AbortController();
        let isSuccessfullyCompleted = false;
        let timeoutId = setTimeout(() => {
          controller.abort();
          showError(lang === 'zh' ? '分析连接超时，请稍后刷新重试' : 'Connection timeout, please refresh later');
        }, 300000);

        console.log('Connecting to direct stream:', streamUrl);
        const streamResp = await fetch(streamUrl, {
            headers: tempToken ? { 'Authorization': `Bearer ${tempToken}`, 'Accept': 'text/event-stream' } : { 'Accept': 'text/event-stream' },
            signal: controller.signal
        });

        if (!streamResp.ok) {
            clearTimeout(timeoutId);
            throw new Error(`Stream download failed: ${streamResp.status}`);
        }
        
        cleanup(); 
        // Handle SSE stream using the pattern from public/examples/frontend_call_example_v1.md
        await handleResponseStream(
            streamResp, 
            (item) => {
                collectedData.push(item);
                // Check if this is a completion event
                if (item.event === 'final_result' || item.event === 'result') {
                    isSuccessfullyCompleted = true;
                }
            }, 
            true, // isSSE
            () => {
                // Each chunk extends the 5-minute inactivity timeout.
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => {
                    controller.abort();
                    showError(lang === 'zh' ? '报告生成超时，请稍后刷新重试' : 'Report generation timeout, please refresh later');
                }, 300000);
            }
        );

        clearTimeout(timeoutId);
        if (!isSuccessfullyCompleted) {
            showError();
            return;
        }

        // Step 3: Fetch Final Result from auto-decoding Brotli endpoint if available, otherwise fallback to resultUrl
        const finalFetchUrl = resultBrUrl || resultUrl;
        if (finalFetchUrl && collectedData.length > 0) {
            console.log('Fetching final result for data verification from:', finalFetchUrl);
            try {
                const finalResp = await fetch(finalFetchUrl, {
                    headers: tempToken ? { 'Authorization': `Bearer ${tempToken}` } : {}
                });
                if (finalResp.ok) {
                    const finalData = await finalResp.json();
                    console.log('Final Result Data:', finalData);
                    
                    // Self-healing merge logic: Re-run all event processors from full backend stream
                    const finalStream = finalData.stream || finalData;
                    if (Array.isArray(finalStream)) {
                        console.log(`[Self-healing] Merging final stream. Total items: ${finalStream.length}`);
                        for (const item of finalStream) {
                            await processEvent(item);
                        }
                    }
                }
            } catch (e) {
                console.error('Failed to fetch final result:', e);
            }
        }

        // Step 4: Request BFF to verify and store cache securely.
        // The BFF resolves the result endpoint from the task binding; the browser
        // only needs to provide the task ID for either Brotli or JSON results.
        if (isSuccessfullyCompleted && collectedData.length > 0 && taskId) {
            console.log('Analysis complete and verified. Requesting BFF cache backfill...');
            
            const backfillCache = async () => {
              // BUG2 companion fix: Do not send token; BFF must always use its env BACKEND_TOKEN.
              const backfillPayload = {
                taskId
              };

              console.log('Sending backfill request to BFF:', backfillPayload);
              const postResp = await fetch('/api/check', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(backfillPayload)
              });
              console.log('BFF cache backfill response code:', postResp.status);
            };
            
            backfillCache().catch(err => console.error('Cache backfill failed:', err));
        }
      }
    } finally {
      cleanup();
    }
  } catch (err: any) {
    cleanup();
    if (err.name === 'AbortError') {
      // Already handled by timer above, but safety catch
    } else {
      showError(err.message);
    }
  }
}

  /**
   * Render Industry WordCloud
   */
  let wcInitialized = false;
  function renderWordCloud(list: any[], newsMap: Map<string, any>) {
    const canvas = document.getElementById('industry-wordcloud') as HTMLCanvasElement;
    const newsPlaceholder = document.getElementById('news-placeholder');
    const newsList = document.getElementById('news-list');

    if (!canvas) return;

    // Load WordCloud2.js if not already loaded
    if (!wcInitialized) {
      const script = document.createElement('script');
      script.src = "https://cdnjs.cloudflare.com/ajax/libs/wordcloud2.js/1.2.2/wordcloud2.min.js";
      script.onload = () => {
        wcInitialized = true;
        doRender();
      };
      document.head.appendChild(script);
    } else {
      doRender();
    }

    function doRender() {
      // Calculate responsive sizing
      const containerWidth = (canvas.parentElement?.clientWidth || 500) - 40;
      canvas.width = containerWidth;
      canvas.height = 460;

      // @ts-ignore
      const maxCount = list.length > 0 ? Math.max(...list.map(i => i[1])) : 1;
      console.log('Rendering WordCloud with maxCount:', maxCount, 'List length:', list.length);

      (window as any).WordCloud(canvas, {
        list: list.slice(0, 100),
        gridSize: 10,
        weightFactor: function (size: number) {
          // Dynamic scaling: largest word around 105px, smallest around 16px
          return size * 0.6 + 12;
        },
        fontWeight: 300,
        fontFamily: 'Outfit, "PingFang SC", sans-serif',
        minSize: 10,
        drawOutOfBound: false,
        ellipticity: 1,
        color: function() {
          const colors = ['#967041ff', '#2f804eff', '#7649c0ff', '#b22f2fff', '#4d70ceff', '#98487fff'];
          return colors[Math.floor(Math.random() * colors.length)];
        },
        rotateRatio: 0,
        backgroundColor: 'transparent',
        click: (item: any) => {
          const keyword = item[0];
          const data = newsMap.get(keyword);
          if (data) {
            renderNews(data.articles, keyword, data.totalCount);
          }
        }
      });
    }
  }

  function renderNews(articles: any[], keyword: string, totalCount?: number) {
    const newsPlaceholder = document.getElementById('news-placeholder');
    const newsList = document.getElementById('news-list');
    const newsHeader = document.getElementById('news-header');
    const newsDisplay = document.querySelector('.news-display');
    if (!newsPlaceholder || !newsList || !newsHeader || !newsDisplay) return;

    newsPlaceholder.classList.add('hidden');
    newsList.classList.remove('hidden');
    newsHeader.classList.remove('hidden');
    newsDisplay.classList.remove('is-collapsed');

    // Ensure collapse toggle listener is set up for mobile
    if (!newsDisplay.classList.contains('has-toggle-listener')) {
      newsDisplay.classList.add('has-toggle-listener');
      newsHeader.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          newsDisplay.classList.toggle('is-collapsed');
        }
      });
    }

    const count = totalCount !== undefined ? totalCount : articles.length;
    if (lang === 'zh') {
      newsHeader.innerHTML = `<span>共找到 <b>${count}</b> 条与 <span style="color:var(--color-brand-1);font-weight:600;">${keyword}</span> 相关的行业资讯</span>`;
    } else {
      newsHeader.innerHTML = `<span>Found <b>${count}</b> news articles related to <span style="color:var(--color-brand-1);font-weight:600;">${keyword}</span></span>`;
    }

    newsList.innerHTML = '';

    const arr = Array.isArray(articles) ? articles : [];
    arr.forEach((article, index) => {
      if (!article) return;
      
      let itemObj = article;
      if (typeof itemObj === 'string') {
        try {
          itemObj = JSON.parse(itemObj);
        } catch (e) {
          itemObj = [article, '', 'Choice金融数据库', ''];
        }
      }
      
      const title = Array.isArray(itemObj) ? itemObj[0] : (itemObj.title || '');
      const rawDate = Array.isArray(itemObj) ? itemObj[1] : (itemObj.date || itemObj.generated_at || '');
      const source = Array.isArray(itemObj) ? itemObj[2] : (itemObj.source || '');
      const url = Array.isArray(itemObj) ? itemObj[3] : (itemObj.source_url || itemObj.url || '');
      
      // Format date: 2024-05-01 12:00 -> 24/05/01
      const formattedDate = String(rawDate).substring(2, 10).replace(/-/g, '/');
      
      const isUrlValid = url && url.trim();
      const sourceDisplay = (!source || source === 'UNKNOWN') ? (lang === 'zh' ? '行业资讯' : 'Industry News') : source;
      
      const item = document.createElement('div');
      item.className = 'news-item';
      item.style.animationDelay = `${index * 0.05}s`;

      const linkHtml = url 
        ? `<a href="${url}" target="_blank" rel="noreferrer" class="meta-pill source">${sourceDisplay}</a>`
        : `<span class="meta-pill source">${sourceDisplay}</span>`;

      item.innerHTML = `
        <span class="news-bullet">•</span>
        <div class="news-title-wrapper">
          <span class="news-title">${title}</span>
          <span class="news-date">${formattedDate}</span>
          ${linkHtml}
        </div>
      `;
      newsList.appendChild(item);
    });
    
    // Scroll to top of list
    newsList.parentElement?.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /**
   * Helper to handle stream decoding and line processing
   * Supports both NDR-JSON and SSE (with data: prefix and \n\n separator)
   */
  async function handleResponseStream(
    response: Response, 
    onEachItem?: (item: any) => void, 
    isSSE = false,
    onChunk?: () => void
  ) {
    if (preview === 'true') {
      // Hijack and speed up to 99%
      const startPct = parseInt(progressLabel.textContent || '50');
      const duration = 3000;
      const startTime = Date.now();
      
      const previewTimer = setInterval(() => {
        const elapsed = Date.now() - startTime;
        const p = Math.min(1, elapsed / duration);
        const currentPct = Math.floor(startPct + (99 - startPct) * p);
        
        const labels = lang === 'zh' 
          ? ['数据链路验证成功...', '正在构建归一化大模型...', '正在执行交叉审计穿透...', '财务诊断报告生成中...']
          : ['Link verified...', 'Building AI model...', 'Executing cross-audit...', 'Generating report...'];
        const labelIdx = Math.min(labels.length - 1, Math.floor(p * labels.length));
        
        setProgress(currentPct, labels[labelIdx]);
        if (p >= 1) clearInterval(previewTimer);
      }, 50);

      await new Promise(r => setTimeout(r, duration));
      clearInterval(previewTimer);
    }

    loadingEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');
    // Ensure all timers are truly gone when we show results
    if (window.loadingInterval) clearInterval(window.loadingInterval);

    placeholderB.start();
    placeholderC.start();

    if (!response.body) throw new Error('Response body is empty');
    
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      if (onChunk) onChunk();

      buffer += decoder.decode(value, { stream: true });

      if (isSSE) {
        // SSE Logic (Uses \n\n as boundary)
        while (true) {
          const boundary = buffer.indexOf('\n\n');
          if (boundary === -1) break;

          const rawEvent = buffer.slice(0, boundary);
          buffer = buffer.slice(boundary + 2);

          for (const line of rawEvent.split('\n')) {
            if (!line.startsWith('data: ')) continue;
            const dataStr = line.slice(6).trim();
            if (!dataStr || dataStr === '[DONE]') continue;

            try {
              const item = JSON.parse(dataStr);
              if (onEachItem) onEachItem(item);
              await processEvent(item);
            } catch (e) {
              console.error('SSE Line parse error:', dataStr, e);
            }
          }
        }
      } else {
        // Standard NDR-JSON Logic (Uses \n as boundary)
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || trimmed.startsWith(':')) continue;
          let dataStr = trimmed;
          if (dataStr.startsWith('data: ')) dataStr = dataStr.substring(6).trim();
          if (!dataStr || dataStr === '[DONE]') continue;

          try {
            const item = JSON.parse(dataStr);
            if (onEachItem) onEachItem(item);
            await processEvent(item);
          } catch (e) { 
            console.error('NDR JSON Line parse error:', dataStr, e); 
          }
        }
      }
    }

    // Process leftover buffer
    if (buffer.trim()) {
        const trimmed = buffer.trim();
        let dataStr = trimmed;
        if (dataStr.startsWith('data: ')) dataStr = dataStr.substring(6).trim();
        if (dataStr && dataStr !== '[DONE]') {
            try {
                const item = JSON.parse(dataStr);
                if (onEachItem) onEachItem(item);
                await processEvent(item);
            } catch (e) {}
        }
    }
    window.dispatchEvent(new CustomEvent('analysis-complete'));
  }

  // ── Scroll Behavior for Area B/C (Desktop) ──
  const setupAreaScroll = () => {
    const wrappers = document.querySelectorAll('.scroll-wrapper-b, .news-display');
    wrappers.forEach(wrapper => {
      wrapper.addEventListener('wheel', (e: any) => {
        if (window.innerWidth > 640) {
          const el = e.currentTarget as HTMLElement;
          const isScrollable = el.scrollHeight > el.clientHeight;
          
          if (!isScrollable) return;

          const isAtTop = el.scrollTop <= 0;
          const isAtBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 1;
          
          // If scrolling down at the bottom or up at the top, let the page scroll
          if (e.deltaY > 0 && isAtBottom) return;
          if (e.deltaY < 0 && isAtTop) return;

          // Otherwise, stop propagation to isolate scroll to the panel
          e.stopPropagation();
        }
      }, { passive: true });
    });
  };
  setupAreaScroll();

  if (shouldRun) {
    main();
  }
</script>
