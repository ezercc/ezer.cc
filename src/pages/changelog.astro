---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { changelogData } from "../data/changelog";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Format date based on locale
const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  if (lang === 'zh') {
    return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
  }
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<Layout
  title={t('nav.changelog')}
  description={t('changelog.subtitle')}
  keywords="ezer audit changelog, ezer updates, 弈泽更新日志, 弈泽版本记录, AI财报审计"
>
  <div class="changelog-container">
    <div class="header-section text-center">
      <h1 class="page-title fade-in-up">{t('changelog.title')}</h1>
      <p class="subtitle fade-in-up delay-1">{t('changelog.subtitle')}</p>
    </div>

    <div class="timeline fade-in-up delay-2">
      {changelogData.map((item, idx) => {
        const content = item[lang];
        return (
          <details class="timeline-item" open={idx === 0}>
            <summary class="timeline-summary">
              <div class="summary-left">
                <span class="version-badge">{item.version}</span>
                <time class="version-date">{formatDate(item.date)}</time>
                <h2 class="version-title">{content.title}</h2>
              </div>
              <div class="summary-right">
                <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
            </summary>
            
            <div class="timeline-details">
              {content.features && content.features.length > 0 && (
                <div class="change-group">
                  <h3 class="group-title feat">
                    <span class="dot"></span>
                    {t('changelog.feat')}
                  </h3>
                  <ul class="change-list">
                    {content.features.map(feat => (
                      <li>{feat}</li>
                    ))}
                  </ul>
                </div>
              )}

              {content.improvements && content.improvements.length > 0 && (
                <div class="change-group">
                  <h3 class="group-title imp">
                    <span class="dot"></span>
                    {t('changelog.imp')}
                  </h3>
                  <ul class="change-list">
                    {content.improvements.map(imp => (
                      <li>{imp}</li>
                    ))}
                  </ul>
                </div>
              )}

              {content.fixes && content.fixes.length > 0 && (
                <div class="change-group">
                  <h3 class="group-title fix">
                    <span class="dot"></span>
                    {t('changelog.fix')}
                  </h3>
                  <ul class="change-list">
                    {content.fixes.map(fix => (
                      <li>{fix}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </details>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .changelog-container {
    font-family: 'Roboto', 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 10rem var(--container-offset) 6rem;
    min-height: 100vh;
  }

  .header-section {
    text-align: center;
    margin-bottom: 5rem;
  }

  .page-title {
    font-family: 'Roboto Slab', 'Noto Serif SC', serif;
    font-weight: 300;
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-alt);
    max-width: 32rem;
    margin: 0 auto;
  }

  /* Timeline styling */
  .timeline {
    position: relative;
    max-width: 50rem;
    margin: 0 auto;
    padding-left: 2.5rem;
  }

  /* Vertical line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 1.5rem;
    bottom: 2rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-brand-1) 0%,
      rgba(var(--rgb-brand-1), 0.2) 70%,
      transparent 100%
    );
  }

  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  /* Summary styling */
  .timeline-summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    outline: none;
    user-select: none;
    padding: 0.8rem 0;
    cursor: pointer;
  }

  .timeline-summary::-webkit-details-marker {
    display: none;
  }

  /* Timeline Dot perfectly centered vertically on the summary row */
  .timeline-summary::before {
    content: '';
    position: absolute;
    left: -2.45rem;
    top: 50%;
    transform: translateY(-50%);
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-brand-1);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 4px rgba(var(--rgb-brand-1), 0.15);
    z-index: 1;
    transition: transform 0.3s var(--ease-out-expo), background-color 0.3s, box-shadow 0.3s;
  }

  .timeline-item:hover .timeline-summary::before {
    transform: translateY(-50%) scale(1.25);
    background-color: var(--color-white);
    box-shadow: 0 0 0 6px rgba(var(--rgb-brand-1), 0.25);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    flex-grow: 1;
  }

  .version-badge {
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: var(--font-size-sm);
    color: var(--color-brand-1);
    background: rgba(var(--rgb-brand-1), 0.08);
    padding: 0.2rem 0.8rem;
    border-radius: 2rem;
    letter-spacing: 0.05em;
    border: 1px solid rgba(var(--rgb-brand-1), 0.15);
    flex-shrink: 0;
    transition: background-color 0.3s, border-color 0.3s;
  }

  :global([data-theme="dark"]) .version-badge {
    background: rgba(var(--rgb-brand-1), 0.15);
    border-color: rgba(var(--rgb-brand-1), 0.3);
  }

  .timeline-item:hover .version-badge {
    background: rgba(var(--rgb-brand-1), 0.18);
    border-color: rgba(var(--rgb-brand-1), 0.35);
  }

  .version-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-alt);
    font-weight: 500;
    flex-shrink: 0;
  }

  .version-title {
    font-family: inherit;
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
    transition: color 0.3s;
  }

  .timeline-item:hover .version-title {
    color: var(--color-brand-1);
  }

  .summary-right {
    display: flex;
    align-items: center;
    padding-left: 1rem;
  }

  .chevron-icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-text-alt);
    transition: transform 0.3s var(--ease-out-expo), color 0.3s;
    flex-shrink: 0;
  }

  .timeline-item[open] .chevron-icon {
    transform: rotate(180deg);
    color: var(--color-brand-1);
  }

  /* Details container styled as a premium glassmorphic card */
  .timeline-details {
    margin-top: 0.4rem;
    margin-left: 0.2rem;
    padding: 1.8rem 2.2rem;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(var(--rgb-brand-1), 0.08);
    border-radius: 0.8rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.01);
    cursor: default;
    animation: slideDown 0.35s var(--ease-out-expo) forwards;
  }

  :global([data-theme="dark"]) .timeline-details {
    background: rgba(30, 30, 36, 0.45);
    border-color: rgba(var(--rgb-brand-1), 0.15);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .change-group {
    margin-bottom: 1.5rem;
  }

  .change-group:last-child {
    margin-bottom: 0;
  }

  .group-title {
    font-family: 'Roboto', 'Noto Sans SC', sans-serif;
    font-weight: 600;
    font-size: var(--font-size-md);
    margin-bottom: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .group-title .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .group-title.feat {
    color: var(--color-brand-1);
  }
  .group-title.feat .dot {
    background: var(--color-brand-1);
  }

  .group-title.imp {
    color: var(--color-brand-5);
  }
  .group-title.imp .dot {
    background: var(--color-brand-5);
  }

  .group-title.fix {
    color: #ef4444;
  }
  .group-title.fix .dot {
    background: #ef4444;
  }

  .change-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .change-list li {
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.85;
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .change-list li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-text-alt);
  }

  .change-list li:last-child {
    margin-bottom: 0;
  }

  /* Animations */
  .fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s var(--ease-out-expo) forwards;
  }

  .delay-1 { animation-delay: 0.15s; }
  .delay-2 { animation-delay: 0.3s; }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .changelog-container {
      padding-top: 8rem;
    }

    .header-section {
      margin-bottom: 3rem;
    }

    .timeline {
      padding-left: 1.8rem;
    }

    .timeline::before {
      left: 0.15rem;
    }

    .timeline-summary::before {
      left: -1.75rem; /* adjusted for mobile padding */
    }

    .timeline-details {
      padding: 1.2rem 1.5rem;
      border-radius: 0.6rem;
    }

    .summary-left {
      gap: 0.8rem;
    }

    .version-title {
      font-size: 1.05rem;
      width: 100%;
    }
  }
</style>
