  .news-display {
    background: var(--color-bg-alt);
    border: 1px solid rgba(var(--rgb-brand-1), 0.08);
    border-radius: 12px;
    padding: 1rem;
    overflow-y: auto;
    height: 500px;
    box-sizing: border-box;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--rgb-brand-1), 0.2) transparent;
  }

  .news-display::-webkit-scrollbar { width: 4px; }
  .news-display::-webkit-scrollbar-thumb { background: rgba(var(--rgb-brand-1), 0.2); border-radius: 4px; }

  .news-header {
    position: sticky;
    top: -1rem;
    margin: -1rem -1rem 0.8rem -1rem;
    padding: 0.8rem 1rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid rgba(var(--rgb-brand-1), 0.12);
    font-size: 0.85rem;
    color: var(--color-text-alt);
    z-index: 3;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05);
  }

  .news-header b {
    color: var(--color-brand-1);
    font-weight: 700;
  }

  .news-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--color-text-alt);
    opacity: 0.6;
    text-align: center;
  }

  .placeholder-icon {
    font-size: 2rem;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.news-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.4rem 0.2rem;
    border-bottom: 1px solid rgba(var(--rgb-brand-1), 0.04);
    animation: news-slide-in 0.3s ease-out forwards;
    transition: background 0.2s;
    border-radius: 6px;
  }

  :global(.news-item:hover) {
    background: rgba(var(--rgb-brand-1), 0.03);
  }

  :global(.news-bullet) {
    color: var(--color-brand-1);
    font-size: 1rem;
    line-height: 1.4;
    opacity: 0.6;
    flex-shrink: 0;
  }

  :global(.news-title-wrapper) {
    flex: 1;
    line-height: 1.5;
  }

  :global(.news-title) {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-text);
    margin-right: 0.4rem;
    line-height: 1.4;
  }

  :global(.news-date) {
    font-size: 0.75rem;
    color: var(--color-text-alt);
    opacity: 0.7;
    margin-right: 0.4rem;
    font-family: var(--font-mono, monospace);
  }

  :global(.meta-pill) {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    background: #3c3c3c;
    color: #fff;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
    vertical-align: middle;
    margin-bottom: 2px;
  }

  :global(.meta-pill:hover) {
    background: #000;
    color: #fff;
  }

  .meta-pill:hover {
    background: var(--color-brand-1);
    transform: translateY(-1px);
  }

  @keyframes news-slide-in {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .industry-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .wordcloud-container {
      height: 380px;
    }

    #industry-wordcloud {
      height: 350px;
    }

    .news-display {
      height: auto;
      min-height: 0;
      overflow: visible;
      background: transparent;
      border: none;
      padding: 0;
      margin-top: 1rem;
    }

    .news-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      position: sticky;
      top: 60px;
      z-index: 9;
      background: var(--color-surface);
      border: 1px solid rgba(var(--rgb-brand-1), 0.15);
      border-radius: 12px;
      margin: 0;
      padding: 0.8rem 1rem;
      box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.08);
      backdrop-filter: blur(12px);
      transition: top 0.3s ease;
    }

    :global(body.is-nav-hidden) .news-header {
      top: 10px;
    }

    .news-header::after {
      content: "";
      width: 8px;
      height: 8px;
      border-right: 2px solid var(--color-brand-1);
      border-bottom: 2px solid var(--color-brand-1);
      transform: rotate(45deg);
      transition: transform 0.3s;
      margin-left: 0.5rem;
      flex-shrink: 0;
    }

    .news-display:not(.is-collapsed) .news-header::after {
      transform: rotate(-135deg);
    }

    .news-display.is-collapsed .news-header {
      border-radius: 12px;
    }

    .news-display:not(.is-collapsed) .news-header {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    .news-display.is-collapsed .news-list {
      display: none !important;
    }

    .news-display:not(.is-collapsed) .news-list {
