<script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/echarts-wordcloud@2/dist/echarts-wordcloud.min.js"></script>

<script>
  // ── i18n strings passed from Astro ──
  const metaEl = document.querySelector('meta[name="check-i18n"]');
  const i18n = metaEl ? JSON.parse(metaEl.getAttribute('content') || '{}') : {};

  // ── Helper: get lang from URL ──
  const isEn = window.location.pathname.startsWith('/en');
  const lang = isEn ? 'en' : 'zh';

  // ── Grab URL params ──
  const params = new URLSearchParams(window.location.search);
  const code = params.get('code');
  const year = params.get('year');
  const period = params.get('period');
  const preview = params.get('preview');

  let shouldRun = true;
  // 1. No parameters -> Redirect to search
  if (!code && !year && !period && !preview) {
    window.location.href = lang === 'zh' ? '/search/' : '/en/search/';
    shouldRun = false;
  }

  // 2. Auth check if not preview
  if (shouldRun && preview !== 'true') {
    const cookies = document.cookie || '';
    const hasSession = cookies.includes('sb-msufgvqofnihylcnxyac-auth-token');
    
    if (!hasSession) {
      const storedAff = localStorage.getItem('ezer_aff');
      let loginUrl;
      if (storedAff) {
        loginUrl = `https://account.ezer.cc/${lang === 'en' ? 'en/' : ''}login/?aff=${storedAff}&step=register&redirect=${encodeURIComponent(window.location.href)}`;
      } else {
        loginUrl = `https://account.ezer.cc/${lang === 'en' ? 'en/' : ''}login/?redirect=${encodeURIComponent(window.location.href)}`;
      }
      window.location.href = loginUrl;
      shouldRun = false;
    } else {
      localStorage.removeItem('ezer_aff');
    }
  }

  // DOM refs
  const loadingEl = document.getElementById('loading-container')!;
  const errorEl = document.getElementById('error-container')!;
  const resultsEl = document.getElementById('results-container')!;
  const pageTitleEl = document.getElementById('page-title')!;
  const loadingTextEl = document.getElementById('loading-text')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressLabel = document.getElementById('progress-label')!;
  const errorTextEl = document.getElementById('error-text')!;

  const thoughtContainer = document.getElementById('thought-container');
  const textB = document.getElementById('text-b') as HTMLElement;
  const textC = document.getElementById('text-c') as HTMLElement;
  const summaryText = document.getElementById('summary-text')!;
  const finalResultText = document.getElementById('final-result-text')!;

  // ── Placeholder Manager for B & C ──
  class PlaceholderManager {
    private interval: any = null;
    private messages: string[] = [];
    private currentIndex = 0;

    constructor(private element: HTMLElement, messages: string[]) {
      this.messages = messages;
    }

    start() {
      if (this.messages.length === 0) return;
      this.element.classList.add('is-placeholder');
      this.element.textContent = this.messages[0];
      this.interval = setInterval(() => {
        this.currentIndex = (this.currentIndex + 1) % this.messages.length;
        this.element.textContent = this.messages[this.currentIndex];
      }, 3000);
    }

    stop() {
      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
        this.element.textContent = '';
        this.element.classList.remove('is-placeholder');
      }
    }

    isActive() {
      return this.interval !== null;
    }
  }

  const bcMessages = lang === 'zh' ? [
    '正在多维核对财报钩稽关系...',
    '正在执行收入截止性测试...',
    '正在分析营运资金周转效率...',
    '正在评估资产减值准备计提...',
    '正在核算加权平均资本成本...',
    '正在比对历史趋势异常波动...',
    '正在检验研发投入资本化比例...',
    '正在审计关联方交易公允性...',
    '正在验证存货周转率合理性...',
    '正在解析财报附注深度内涵...',
    '正在扫描潜在表外融资风险...'
  ] : [
    'Cross-checking financial statement integrity...',
    'Performing revenue cutoff tests...',
    'Analyzing working capital efficiency...',
    'Evaluating asset impairment provisions...',
    'Calculating Weighted Average Cost of Capital...',
    'Inspecting historical trend anomalies...',
    'Verifying R&D capitalization ratios...',
    'Auditing related-party transaction fairness...',
    'Validating inventory turnover logic...',
    'Parsing deep insights from footnotes...',
    'Scanning for off-balance sheet risks...'
  ];

  const placeholderB = new PlaceholderManager(textB, bcMessages);
  const placeholderC = new PlaceholderManager(textC, bcMessages);

  // Initialize Summary Placeholder
  summaryText.textContent = lang === 'zh' ? '正在等待分析完成...' : 'Waiting for analysis to complete...';
  summaryText.classList.add('is-placeholder');

  // Toggle thought process (if present)
  const thoughtToggle = document.getElementById('thought-toggle');
  if (thoughtToggle && thoughtContainer) {
    thoughtToggle.addEventListener('click', () => {
      thoughtContainer.classList.toggle('is-collapsed');
      thoughtToggle.setAttribute('aria-expanded', String(!thoughtContainer.classList.contains('is-collapsed')));
    });
  }

  // ── Bi-Directional Linkage Manager ──
  class LinkageManager {
    private activeChartId: string | null = null;
    private activeDataIndex: number | null = null;

    highlightChartFromText(chartId: string, period?: string, comparePeriod?: string) {
      const chart = chartManager.getChart(chartId);
      if (!chart) return;

      const dataStore = chartManager.getChartData(chartId);
      if (!dataStore) return;

      let dataIndex = -1;
      if (period) {
        dataIndex = dataStore.periods.findIndex(p => p.includes(period) || period.includes(p));
      }
      if (dataIndex === -1 && dataStore.periods.length > 0) {
        dataIndex = dataStore.periods.length - 1;
      }

      let compareIndex = -1;
      if (comparePeriod) {
        compareIndex = dataStore.periods.findIndex(p => p.includes(comparePeriod) || comparePeriod.includes(p));
      }

      if (dataIndex >= 0) {
        this.activeChartId = chartId;
        this.activeDataIndex = dataIndex;

        const highlightIndices = (compareIndex >= 0 && compareIndex !== dataIndex) 
          ? [compareIndex, dataIndex] 
          : [dataIndex];

        chart.dispatchAction({
          type: 'highlight',
          seriesIndex: [0, 1],
          dataIndex: highlightIndices
        });

        chart.dispatchAction({
          type: 'showTip',
          seriesIndex: 0,
          dataIndex: dataIndex
        });
      }
    }

    clearChartHighlight(chartId: string) {
      const chart = chartManager.getChart(chartId);
      if (!chart) return;

      chart.dispatchAction({
        type: 'downplay',
        seriesIndex: [0, 1]
      });

      chart.dispatchAction({
        type: 'hideTip'
      });

      this.activeChartId = null;
      this.activeDataIndex = null;
    }

    highlightTextFromChart(chartId: string, period: string) {
      const tags = document.querySelectorAll('.chart-mention-tag');
      tags.forEach(tag => {
        const tagChart = tag.getAttribute('data-chart-id');
        const tagPeriod = tag.getAttribute('data-period');
        if (tagChart === chartId && (!tagPeriod || period.includes(tagPeriod) || tagPeriod.includes(period))) {
          tag.classList.add('is-chart-hovered');
        } else {
          tag.classList.remove('is-chart-hovered');
        }
      });
    }

    clearTextHighlights() {
      const tags = document.querySelectorAll('.chart-mention-tag.is-chart-hovered');
      tags.forEach(tag => tag.classList.remove('is-chart-hovered'));
    }
  }

  const linkageManager = new LinkageManager();

  // ── Floating Financial Micro-Card (Popover Manager) ──
  class ChartDataPopover {
    private popoverEl: HTMLElement | null = null;
    private hideTimer: any = null;
    private isPinned: boolean = false;
    private currentTargetEl: HTMLElement | null = null;

    constructor() {
      this.init();
    }

    private init() {
      let el = document.getElementById('chart-data-popover');
      if (!el) {
        el = document.createElement('div');
        el.id = 'chart-data-popover';
        el.className = 'chart-data-popover';
        document.body.appendChild(el);

        el.addEventListener('mouseenter', () => {
          if (this.hideTimer) {
            clearTimeout(this.hideTimer);
            this.hideTimer = null;
          }
        });

        el.addEventListener('mouseleave', () => {
          if (!this.isPinned) {
            this.hide();
          }
        });

        // Click outside to dismiss pinned popover
        document.addEventListener('click', (e) => {
          if (!this.popoverEl || !this.popoverEl.classList.contains('is-visible')) return;
          const target = e.target as HTMLElement;
          if (this.popoverEl.contains(target) || target.closest('.chart-mention-tag')) {
            return;
          }
          this.hide(true);
        });

        // Window scroll: only auto-hide if NOT pinned by click
        window.addEventListener('scroll', () => {
          if (!this.isPinned) {
            this.hide();
          } else if (this.currentTargetEl && this.popoverEl?.classList.contains('is-visible')) {
            this.reposition();
          }
        }, { passive: true });
      }
      this.popoverEl = el;
    }

    toggle(targetEl: HTMLElement, chartId: string, period?: string, comparePeriod?: string) {
      if (this.isPinned && this.currentTargetEl === targetEl && this.popoverEl?.classList.contains('is-visible')) {
        this.hide(true);
      } else {
        this.show(targetEl, chartId, period, comparePeriod, true);
      }
    }

    show(targetEl: HTMLElement, chartId: string, period?: string, comparePeriod?: string, pin: boolean = false) {
      if (!this.popoverEl) return;
      if (this.hideTimer) {
        clearTimeout(this.hideTimer);
        this.hideTimer = null;
      }

      this.isPinned = pin;
      this.currentTargetEl = targetEl;

      const dataStore = chartManager.getChartData(chartId);

      let metricTitle = '';
      let metricUnit = '';
      let metricIcon = 'fa-chart-column';
      const lowerChartId = (chartId || '').toLowerCase();

      if (lowerChartId.includes('revenue') || lowerChartId.includes('营收') || lowerChartId.includes('收入')) {
        metricTitle = lang === 'zh' ? '营业收入' : 'Revenue';
        metricUnit = lang === 'zh' ? '亿元' : 'B';
        metricIcon = 'fa-chart-column';
      } else if (lowerChartId.includes('profit') || lowerChartId.includes('净利润') || lowerChartId.includes('利润')) {
        metricTitle = lang === 'zh' ? '净利润' : 'Net Profit';
        metricUnit = lang === 'zh' ? '亿元' : 'B';
        metricIcon = 'fa-coins';
      } else if (lowerChartId.includes('margin') || lowerChartId.includes('毛利')) {
        metricTitle = lang === 'zh' ? '毛利率' : 'Gross Margin';
        metricUnit = '%';
        metricIcon = 'fa-percent';
      } else if (lowerChartId.includes('debt') || lowerChartId.includes('负债') || lowerChartId.includes('liability')) {
        metricTitle = lang === 'zh' ? '资产负债率' : 'Debt Ratio';
        metricUnit = '%';
        metricIcon = 'fa-scale-balanced';
      } else if (lowerChartId.includes('rd') || lowerChartId.includes('研发')) {
        metricTitle = lang === 'zh' ? '研发投入' : 'R&D Investment';
        metricUnit = lang === 'zh' ? '亿元' : 'B';
        metricIcon = 'fa-microchip';
      } else if (lowerChartId.includes('cash') || lowerChartId.includes('现金')) {
        metricTitle = lang === 'zh' ? '现金流指标' : 'Cash Flow';
        metricUnit = lang === 'zh' ? '亿元' : 'B';
        metricIcon = 'fa-money-bill-wave';
      } else {
        const rawMetric = targetEl.getAttribute('data-metric') || '';
        metricTitle = rawMetric || (lang === 'zh' ? '专题财务指标' : 'Financial Metric');
        metricUnit = '';
        metricIcon = 'fa-chart-line';
      }

      const formatVal = (val: number | null | undefined) => {
        if (val === null || val === undefined) return '-';
        if (metricUnit === '%') return Number(val).toFixed(2) + '%';
        if (Math.abs(val) >= 100000000) return (val / 100000000).toFixed(2) + (lang === 'zh' ? '亿' : 'B');
        if (Math.abs(val) >= 10000) return (val / 10000).toFixed(2) + (lang === 'zh' ? '万' : 'k');
        return Number(val).toLocaleString();
      };

      const isMobile = window.innerWidth <= 640;
      const closeBtnHtml = (this.isPinned || isMobile) ? `
        <button class="popover-close-btn" aria-label="Close" onclick="window.chartDataPopover?.hide(true)">
          <i class="fa-solid fa-xmark"></i>
        </button>
      ` : '';

      // Graceful fallback if dataStore is not available yet or metric has no direct chart
      if (!dataStore || !dataStore.data || dataStore.data.length === 0) {
        const snippetText = targetEl.textContent ? targetEl.textContent.trim() : '';
        const targetPeriod = period || (lang === 'zh' ? '披露期数据' : 'Period Data');

        this.popoverEl.innerHTML = `
          <div class="popover-header">
            <span class="popover-title">
              <i class="fa-solid ${metricIcon}"></i>
              <span>${metricTitle}</span>
            </span>
            <div style="display:flex;align-items:center;gap:4px;">
              <span class="popover-badge">${targetPeriod}</span>
              ${closeBtnHtml}
            </div>
          </div>
          <div class="popover-fallback-box">
            <div class="popover-metric-detail">
              <div class="metric-detail-row">
                <span class="metric-detail-label">${lang === 'zh' ? '核验科目' : 'Audited Metric'}</span>
                <span class="metric-detail-val">${metricTitle}</span>
              </div>
              <div class="metric-detail-row">
                <span class="metric-detail-label">${lang === 'zh' ? '报告期' : 'Period'}</span>
                <span class="metric-detail-val">${targetPeriod}</span>
              </div>
            </div>
            <div class="fallback-text-snippet">“${snippetText}”</div>
            <div class="fallback-tip">
              <i class="fa-solid fa-circle-check" style="color:#10b981;"></i>
              <span>${lang === 'zh' ? '该科目已由大模型与财报原文交叉穿透核验' : 'Verified via financial statement cross-audit'}</span>
            </div>
          </div>
        `;
        this.reposition();
        this.popoverEl.classList.add('is-visible');
        return;
      }

      const findPeriodIdx = (pQuery: string) => {
        let idx = dataStore.periods.findIndex(p => p.includes(pQuery) || pQuery.includes(p));
        if (idx !== -1) return idx;
        if (/FY|年报/i.test(pQuery)) {
          const year = pQuery.match(/\d{4}/)?.[0];
          if (year) {
            idx = dataStore.periods.findIndex(p => p.includes(`${year}Q4`) || p.startsWith(year));
          }
        }
        return idx;
      };

      const isCompareMode = !!(comparePeriod && comparePeriod !== period);
      let headerSubtitle = '';
      let summaryBarHtml = '';
      let sliceData: any[] = [];
      let idxStart = -1;
      let idxEnd = -1;
      let targetIdx = -1;
      let startIdx = 0;
      let endIdx = 0;
      let pctChange = 0;
      let isPositive = true;
      let deltaSign = '';

      if (isCompareMode) {
        idxStart = findPeriodIdx(comparePeriod!);
        idxEnd = period ? findPeriodIdx(period) : dataStore.periods.length - 1;

        if (idxStart === -1) idxStart = 0;
        if (idxEnd === -1) idxEnd = dataStore.periods.length - 1;

        const minIdx = Math.min(idxStart, idxEnd);
        const maxIdx = Math.max(idxStart, idxEnd);

        sliceData = dataStore.data.slice(minIdx, maxIdx + 1);
        const baseVal = dataStore.data[idxStart]?.value;
        const targetVal = dataStore.data[idxEnd]?.value;

        let diffVal = 0;
        if (baseVal != null && targetVal != null && baseVal !== 0) {
          diffVal = targetVal - baseVal;
          pctChange = Number((((targetVal - baseVal) / Math.abs(baseVal)) * 100).toFixed(1));
          isPositive = pctChange >= 0;
        }

        deltaSign = isPositive ? '+' : '';
        headerSubtitle = lang === 'zh' ? '跨期数据对比' : 'Period Comparison';
        const diffDisplay = metricUnit === '%' ? `${deltaSign}${diffVal.toFixed(2)}%` : `${deltaSign}${formatVal(diffVal)}`;
        summaryBarHtml = `
          <div class="popover-comparison-summary">
            <span class="summary-range">${dataStore.periods[idxStart]} → ${dataStore.periods[idxEnd]}</span>
            <span class="summary-diff">${lang === 'zh' ? '变动差额' : 'Delta'}: ${diffDisplay}</span>
          </div>
        `;
      } else {
        if (period) {
          targetIdx = findPeriodIdx(period);
        }
        if (targetIdx === -1) targetIdx = dataStore.periods.length - 1;

        // Center around targetIdx: 2 quarters before, targetIdx, 2 quarters after (total 5 quarters)
        startIdx = targetIdx - 2;
        endIdx = targetIdx + 2;

        if (startIdx < 0) {
          startIdx = 0;
          endIdx = Math.min(dataStore.data.length - 1, 4);
        } else if (endIdx >= dataStore.data.length) {
          endIdx = dataStore.data.length - 1;
          startIdx = Math.max(0, endIdx - 4);
        }

        sliceData = dataStore.data.slice(startIdx, endIdx + 1);
        headerSubtitle = lang === 'zh' ? '前后5季度数据' : '5-Quarter Range';
      }

      // Generate SVG Vertical Bar Chart
      const svgW = 292;
      const svgH = 146;
      const axisY = 112;
      const maxBarH = 65;
      const nBars = sliceData.length;

      const padLeft = 24;
      const padRight = 24;
      const availW = svgW - padLeft - padRight;
      const step = nBars > 1 ? availW / (nBars - 1) : 0;
      const barW = nBars <= 3 ? 24 : (nBars <= 5 ? 18 : Math.max(10, Math.round(step * 0.42)));

      const maxValInSlice = Math.max(...sliceData.map(d => Math.abs(d.value || 0)), 0.0001);

      let barsSvg = '';
      let baseCoord: { x: number; y: number } | null = null;
      let targetCoord: { x: number; y: number } | null = null;

      const periodStartRef = dataStore.periods[idxStart];
      const periodEndRef = dataStore.periods[idxEnd];

      sliceData.forEach((d, idx) => {
        if (!d) return;
        const cx = nBars > 1 ? padLeft + idx * step : svgW / 2;
        const val = d.value || 0;
        const barH = Math.max(5, Math.round((Math.abs(val) / maxValInSlice) * maxBarH));
        const barY = axisY - barH;

        const isBase = isCompareMode && !!(periodStartRef && d.period && (d.period.includes(periodStartRef) || periodStartRef.includes(d.period)));
        const isTarget = isCompareMode && !!(periodEndRef && d.period && (d.period.includes(periodEndRef) || periodEndRef.includes(d.period)));
        const isSingleFocus = !isCompareMode && ((startIdx + idx) === targetIdx);

        if (isBase) baseCoord = { x: cx, y: barY };
        if (isTarget) targetCoord = { x: cx, y: barY };

        let barClass = 'bar-normal';
        let valClass = 'val-normal';
        let tagText = '';
        let tagClass = '';

        if (isBase) {
          barClass = 'bar-base';
          valClass = 'val-base';
          tagText = lang === 'zh' ? '基准' : 'Base';
          tagClass = 'tag-base';
        } else if (isTarget) {
          barClass = 'bar-target';
          valClass = 'val-target';
          tagText = lang === 'zh' ? '对比' : 'Target';
          tagClass = 'tag-target';
        } else if (isSingleFocus) {
          barClass = 'bar-target';
          valClass = 'val-target';
          tagText = lang === 'zh' ? '当前' : 'Focus';
          tagClass = 'tag-target';
        }

        // Format period for display: if more than 5 quarters, abbreviate "2025Q1" -> "25Q1"
        const displayPeriod = nBars > 5 ? d.period.replace(/^20(\d{2})/, '$1') : d.period;

        barsSvg += `
          <g class="popover-bar-group">
            <text class="svg-val-text ${valClass}" x="${cx}" y="${barY - 4}" text-anchor="middle">${formatVal(d.value)}</text>
            <rect class="svg-bar ${barClass}" x="${cx - barW / 2}" y="${barY}" width="${barW}" height="${barH}" rx="3"></rect>
            <text class="svg-period-text" x="${cx}" y="${axisY + 14}" text-anchor="middle">${displayPeriod}</text>
            ${tagText ? `<text class="svg-subtag-text ${tagClass}" x="${cx}" y="${axisY + 26}" text-anchor="middle">${tagText}</text>` : ''}
          </g>
        `;
      });

      // Comparison Arc and Badge
      let arcSvg = '';
      if (isCompareMode && baseCoord && targetCoord) {
        const x1 = (baseCoord as any).x;
        const y1 = (baseCoord as any).y;
        const x2 = (targetCoord as any).x;
        const y2 = (targetCoord as any).y;

        const midX = (x1 + x2) / 2;
        // Curved peak of quadratic bezier: lift above highest bar, clamp at minimum 16 to stay inside SVG
        const midY = Math.max(16, Math.min(y1, y2) - 22);

        const arcPath = `M ${x1} ${y1 - 8} Q ${midX} ${midY} ${x2} ${y2 - 8}`;
        const badgeW = 54;
        const badgeH = 17;
        const badgeBg = isPositive ? '#7c3aed' : '#ef4444';

        arcSvg = `
          <path class="svg-compare-arc" d="${arcPath}" fill="none" stroke="#8b5cf6" stroke-width="1.8" stroke-dasharray="3,3" marker-end="url(#popover-arrow)"></path>
          <g class="svg-badge-group">
            <rect x="${midX - badgeW / 2}" y="${midY - badgeH / 2}" width="${badgeW}" height="${badgeH}" rx="8.5" fill="${badgeBg}"></rect>
            <text x="${midX}" y="${midY + 3.5}" text-anchor="middle" font-size="9.5" font-weight="700" fill="#ffffff">${deltaSign}${pctChange}%</text>
          </g>
        `;
      }

      const svgHtml = `
        <div class="popover-chart-wrapper">
          <svg class="popover-bar-svg" viewBox="0 0 ${svgW} ${svgH}" width="100%" height="${svgH}">
            <defs>
              <marker id="popover-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                <path d="M 1 1.5 L 6 4 L 1 6.5 z" fill="#8b5cf6"></path>
              </marker>
            </defs>
            <line class="svg-axis-line" x1="12" y1="${axisY}" x2="${svgW - 12}" y2="${axisY}"></line>
            ${barsSvg}
            ${arcSvg}
          </svg>
        </div>
      `;

      this.popoverEl.innerHTML = `
        <div class="popover-header">
          <span class="popover-title">
            <i class="fa-solid ${metricIcon}"></i>
            <span>${metricTitle}</span>
          </span>
          <div style="display:flex;align-items:center;gap:4px;">
            <span class="popover-badge">${headerSubtitle}</span>
            ${closeBtnHtml}
          </div>
        </div>
        ${summaryBarHtml}
        ${svgHtml}
      `;

      this.reposition();
      this.popoverEl.classList.add('is-visible');
    }

    private reposition() {
      if (!this.popoverEl || !this.currentTargetEl) return;
      if (window.innerWidth <= 640) {
        // Mobile fixed bottom-sheet layout handled via CSS
        this.popoverEl.style.left = '';
        this.popoverEl.style.top = '';
        return;
      }

      const rect = this.currentTargetEl.getBoundingClientRect();
      const popoverWidth = 320;
      const margin = 8;

      let left = rect.left;
      let top = rect.bottom + margin;

      if (left + popoverWidth > window.innerWidth - 16) {
        left = Math.max(16, window.innerWidth - popoverWidth - 16);
      }
      if (left < 16) {
        left = 16;
      }

      const estimatedHeight = this.popoverEl.offsetHeight || 230;
      if (rect.bottom + estimatedHeight > window.innerHeight - 16) {
        top = Math.max(16, rect.top - estimatedHeight - margin);
      }

      this.popoverEl.style.left = `${left}px`;
      this.popoverEl.style.top = `${top}px`;
    }

    hide(force: boolean = false) {
      if (this.isPinned && !force) return;
      if (this.hideTimer) clearTimeout(this.hideTimer);
      this.hideTimer = setTimeout(() => {
        if (this.popoverEl) {
          this.popoverEl.classList.remove('is-visible');
          if (force) {
            this.isPinned = false;
            this.currentTargetEl = null;
          }
        }
      }, 200);
    }
  }

  const chartDataPopover = new ChartDataPopover();
  (window as any).chartDataPopover = chartDataPopover;

  // ── Dual Mode Data Parser ──
  class ChartLinkageParser {
    constructor() {
      this.setupGlobalDelegation();
    }

    private normalizeMetricToChartId(metric: string): string {
      const m = (metric || '').toLowerCase().trim();
      if (m.includes('revenue') || m.includes('营收') || m.includes('收入')) return 'chart-revenue';
      if (m.includes('profit') || m.includes('净利润') || m.includes('利润')) return 'chart-profit';
      if (m.includes('margin') || m.includes('毛利')) return 'chart-margin';
      if (m.includes('debt') || m.includes('负债') || m.includes('liability')) return 'chart-debt';
      return `chart-${m}`;
    }

    private setupGlobalDelegation() {
      // Event Delegation using W3C PointerEvents: hardware-level pointerType discrimination
      document.addEventListener('pointerover', (e: PointerEvent) => {
        // Exclude touch taps completely from hover mechanics
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;

        const target = (e.target as HTMLElement).closest('.chart-mention-tag') as HTMLElement;
        if (!target) return;
        const chartId = target.getAttribute('data-chart-id');
        const period = target.getAttribute('data-period') || undefined;
        const comparePeriod = target.getAttribute('data-compare-period') || undefined;
        if (chartId) {
          linkageManager.highlightChartFromText(chartId, period, comparePeriod);
          chartDataPopover.show(target, chartId, period, comparePeriod, false);
        }
      });

      document.addEventListener('pointerout', (e: PointerEvent) => {
        if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;

        const target = (e.target as HTMLElement).closest('.chart-mention-tag') as HTMLElement;
        if (!target) return;
        const related = e.relatedTarget as HTMLElement;
        if (related && target.contains(related)) return;

        const chartId = target.getAttribute('data-chart-id');
        if (chartId) {
          linkageManager.clearChartHighlight(chartId);
        }
        chartDataPopover.hide(false);
      });

      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('.chart-mention-tag') as HTMLElement;
        if (target) {
          e.stopPropagation();
          const chartId = target.getAttribute('data-chart-id');
          const period = target.getAttribute('data-period') || undefined;
          const comparePeriod = target.getAttribute('data-compare-period') || undefined;
          if (chartId) {
            linkageManager.highlightChartFromText(chartId, period, comparePeriod);
            chartDataPopover.toggle(target, chartId, period, comparePeriod);
          }
        }
      });
    }

    // Method 1: Parse [[ref:revenue,period:2026Q1,compare_period:2025Q1,text:Revenue reached $45.2B]] syntax
    private parseTags(htmlStr: string): string {
      const tagBlockRegex = /\[\[(?:ref|chart):([^\]]+)\]\]/g;
      return htmlStr.replace(tagBlockRegex, (match, content) => {
        let metric = '';
        let period = '';
        let comparePeriod = '';
        let text = '';

        const parts = content.split(/,(?=(?:[a-zA-Z_]+:))/);
        for (let i = 0; i < parts.length; i++) {
          const part = parts[i].trim();
          if (i === 0 && !part.includes(':')) {
            metric = part;
            continue;
          }
          const colonIdx = part.indexOf(':');
          if (colonIdx === -1) {
            if (!metric) metric = part;
            continue;
          }
          const key = part.slice(0, colonIdx).trim().toLowerCase();
          const val = part.slice(colonIdx + 1).trim();
          if (key === 'ref' || key === 'chart' || key === 'metric') metric = val;
          else if (key === 'period') period = val;
          else if (key === 'compare_period' || key === 'compare') comparePeriod = val;
          else if (key === 'text') text = val;
        }

        if (!text) {
          const textMatch = content.match(/text:([^,\]]+)/);
          if (textMatch) text = textMatch[1].trim();
        }
        if (!text) text = metric || (lang === 'zh' ? '数据核验' : 'Data Audit');

        const chartId = this.normalizeMetricToChartId(metric);
        return `<span class="chart-mention-tag" data-chart-id="${chartId}" data-period="${period}" data-compare-period="${comparePeriod}" tabindex="0" role="button">${text}</span>`;
      });
    }

    // Method 2: Left-to-right stateful tokenizing parser (Proximity-based metric binding)
    private parseFallback(node: Node) {
      if (node.nodeType === Node.TEXT_NODE) {
        const text = node.nodeValue;
        if (!text || text.trim().length === 0) return;

        // Tokenize text into metric keywords, periods, and numeric value clusters
        const tokenRegex = /(营业总收入|主营业务收入|营业收入|营收|Revenue|扣除非经常性损益后归属于母公司股东的净利润|归属于母公司股东的净利润|扣非归母净利润|扣非净利润|归母净利润|净利润|Net Profit|销售毛利率|毛利率|Gross Margin|资产负债率|Debt Ratio|合同负债|研发|现金|固定资产|销量|生产量|ROA|ROE)|(20\d{2}(?:Q[1-4]|FY|一季报|二季报|三季报|年报|半年度)?)|((?:20\d{2}(?:Q[1-4]|FY|一季报|二季报|三季报|年报|半年度)?(?:的|年)?\s*)?(?:\d{1,3}(?:,\d{3})*(?:\.\d+)?|\d+(?:\.\d+)?)\s*(?:亿元|万元|亿|万|%|元))/gi;

        let activeChartId: string | null = null;
        let activePeriod: string = '';
        let lastIndex = 0;
        let newHtml = '';
        let hasTag = false;

        let match: RegExpExecArray | null;
        while ((match = tokenRegex.exec(text)) !== null) {
          const index = match.index;
          newHtml += text.substring(lastIndex, index);
          lastIndex = tokenRegex.lastIndex;

          const [fullMatch, metricToken, periodToken, valueToken] = match;

          if (metricToken) {
            const m = metricToken.toLowerCase();
            if (m.includes('revenue') || m.includes('营收') || m.includes('收入')) {
              activeChartId = 'chart-revenue';
            } else if (m.includes('profit') || m.includes('净利润') || m.includes('利润')) {
              activeChartId = 'chart-profit';
            } else if (m.includes('margin') || m.includes('毛利')) {
              activeChartId = 'chart-margin';
            } else if (m.includes('debt') || m.includes('负债') || m.includes('资产负债')) {
              activeChartId = 'chart-debt';
            } else {
              activeChartId = null; // Non-Section-A metrics reset chartId so subsequent numbers aren't tagged!
            }
            newHtml += fullMatch;
          } else if (periodToken) {
            let p = periodToken;
            if (p.includes('一季报')) p = p.replace('一季报', 'Q1');
            if (p.includes('二季报')) p = p.replace('二季报', 'Q2');
            if (p.includes('三季报')) p = p.replace('三季报', 'Q3');
            if (p.includes('年报')) p = p.replace('年报', 'FY');
            activePeriod = p;
            newHtml += fullMatch;
          } else if (valueToken) {
            if (activeChartId) {
              const itemPeriodMatch = valueToken.match(/(20\d{2}(?:Q[1-4]|FY|一季报|二季报|三季报|年报|半年度)?)/i);
              let periodAttr = itemPeriodMatch ? itemPeriodMatch[1] : activePeriod;
              if (periodAttr.includes('一季报')) periodAttr = periodAttr.replace('一季报', 'Q1');
              if (periodAttr.includes('二季报')) periodAttr = periodAttr.replace('二季报', 'Q2');
              if (periodAttr.includes('三季报')) periodAttr = periodAttr.replace('三季报', 'Q3');
              if (periodAttr.includes('年报')) periodAttr = periodAttr.replace('年报', 'FY');

              // Check for comparative phrase like "vs 2025Q1" or "compared to 2025Q1"
              const compMatch = fullMatch.match(/(?:vs|compared to|相较于|对比|较|比)\s*(20\d{2}(?:Q[1-4]|FY|一季报|二季报|三季报|年报|半年度)?)/i);
              let compareAttr = '';
              if (compMatch) {
                compareAttr = compMatch[1];
                if (compareAttr.includes('一季报')) compareAttr = compareAttr.replace('一季报', 'Q1');
                if (compareAttr.includes('二季报')) compareAttr = compareAttr.replace('二季报', 'Q2');
                if (compareAttr.includes('三季报')) compareAttr = compareAttr.replace('三季报', 'Q3');
                if (compareAttr.includes('年报')) compareAttr = compareAttr.replace('年报', 'FY');
              }

              hasTag = true;
              newHtml += `<span class="chart-mention-tag chart-mention-auto" data-chart-id="${activeChartId}" data-period="${periodAttr}" data-compare-period="${compareAttr}" tabindex="0" role="button">${fullMatch}</span>`;
            } else {
              newHtml += fullMatch;
            }
          }
        }

        newHtml += text.substring(lastIndex);

        if (hasTag && node.parentNode) {
          const spanWrapper = document.createElement('span');
          spanWrapper.innerHTML = newHtml;
          node.parentNode.replaceChild(spanWrapper, node);
        }
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        const el = node as HTMLElement;
        if (el.classList.contains('chart-mention-tag') || el.tagName === 'SCRIPT' || el.tagName === 'STYLE' || el.tagName === 'A') {
          return;
        }
        Array.from(el.childNodes).forEach(child => this.parseFallback(child));
      }
    }

    parseAndBind(container: HTMLElement) {
      if (!container) return;

      if (container.innerHTML.includes('[[ref:') || container.innerHTML.includes('[[chart:')) {
        container.innerHTML = this.parseTags(container.innerHTML);
      }
      this.parseFallback(container);
    }
  }

  const linkageParser = new ChartLinkageParser();

  // ── ECharts Chart Manager ──
  class ChartManager {
    private charts: Record<string, any> = {};
    private chartDataStore: Record<string, { periods: string[]; data: any[] }> = {};
    private timelineChart: any = null;
    private isSyncingZoom = false;
    private activePeriods: string[] = [];

    getChart(id: string) {
      return this.charts[id];
    }

    getChartData(id: string) {
      return this.chartDataStore[id];
    }

    setChartData(id: string, data: any[]) {
      this.chartDataStore[id] = {
        periods: data.map(d => d.period),
        data: data
      };
    }

    render(id: string, data: any[], label: string, suffix: string = '') {
      const el = document.getElementById(id);
      if (!el) return;

      const container = el.closest('.chart-item') as HTMLElement;
      if (container) {
        container.style.display = 'flex';
        setTimeout(() => container.classList.add('is-visible'), 10);
      }

      const sectionA = document.querySelector('.section-a');
