  function renderNews(articles: any[], keyword: string, totalCount?: number) {
    const newsPlaceholder = document.getElementById('news-placeholder');
    const newsList = document.getElementById('news-list');
    const newsHeader = document.getElementById('news-header');
    const newsDisplay = document.querySelector('.news-display');
    if (!newsPlaceholder || !newsList || !newsHeader || !newsDisplay) return;

    newsPlaceholder.classList.add('hidden');
    newsList.classList.remove('hidden');
    newsHeader.classList.remove('hidden');
    newsDisplay.classList.remove('is-collapsed');

    // Ensure collapse toggle listener is set up for mobile
    if (!newsDisplay.classList.contains('has-toggle-listener')) {
      newsDisplay.classList.add('has-toggle-listener');
      newsHeader.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          newsDisplay.classList.toggle('is-collapsed');
        }
      });
    }

    const count = totalCount !== undefined ? totalCount : articles.length;
    if (lang === 'zh') {
      newsHeader.innerHTML = `<span>共找到 <b>${count}</b> 条与 <span style="color:var(--color-brand-1);font-weight:600;">${keyword}</span> 相关的行业资讯</span>`;
    } else {
      newsHeader.innerHTML = `<span>Found <b>${count}</b> news articles related to <span style="color:var(--color-brand-1);font-weight:600;">${keyword}</span></span>`;
    }

    newsList.innerHTML = '';

    const arr = Array.isArray(articles) ? articles : [];
    arr.forEach((article, index) => {
      if (!article) return;
      
      let itemObj = article;
      if (typeof itemObj === 'string') {
        try {
          itemObj = JSON.parse(itemObj);
        } catch (e) {
          itemObj = [article, '', 'Choice金融数据库', ''];
        }
      }
      
      const title = Array.isArray(itemObj) ? itemObj[0] : (itemObj.title || '');
      const rawDate = Array.isArray(itemObj) ? itemObj[1] : (itemObj.date || itemObj.generated_at || '');
      const source = Array.isArray(itemObj) ? itemObj[2] : (itemObj.source || '');
      const url = Array.isArray(itemObj) ? itemObj[3] : (itemObj.source_url || itemObj.url || '');
      
      // Format date: 2024-05-01 12:00 -> 24/05/01
      const formattedDate = String(rawDate).substring(2, 10).replace(/-/g, '/');
      
      const isUrlValid = url && url.trim();
      const sourceDisplay = (!source || source === 'UNKNOWN') ? (lang === 'zh' ? '行业资讯' : 'Industry News') : source;
      
      const item = document.createElement('div');
      item.className = 'news-item';
      item.style.animationDelay = `${index * 0.05}s`;

      const linkHtml = isUrlValid
        ? `<a href="${url.trim()}" target="_blank" rel="noreferrer" class="meta-pill source">${sourceDisplay}</a>`
        : `<span class="meta-pill source" style="cursor: not-allowed; opacity: 0.6;">${lang === 'zh' ? '行业资讯' : 'Industry News'}</span>`;

      item.innerHTML = `
        <span class="news-bullet">•</span>
        <div class="news-title-wrapper">
          <span class="news-title">${title}</span>
          <span class="news-date">${formattedDate}</span>
          ${linkHtml}
        </div>
      `;
      newsList.appendChild(item);
    });
    
    // Scroll to top of list
    newsList.parentElement?.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /**
   * Helper to handle stream decoding and line processing
   * Supports both NDR-JSON and SSE (with data: prefix and \n\n separator)
   */
  async function handleResponseStream(
    response: Response, 
    onEachItem?: (item: any) => void, 
    isSSE = false,
    onChunk?: () => void
  ) {
    if (preview === 'true') {
      // Hijack and speed up to 99%
      const startPct = parseInt(progressLabel.textContent || '50');
      const duration = 3000;
      const startTime = Date.now();
      
      const previewTimer = setInterval(() => {
        const elapsed = Date.now() - startTime;
        const p = Math.min(1, elapsed / duration);
        const currentPct = Math.floor(startPct + (99 - startPct) * p);
        
        const labels = lang === 'zh' 
          ? ['Link verified...', 'Building AI model...', 'Executing cross-audit...', 'Generating report...']
          : ['Link verified...', 'Building AI model...', 'Executing cross-audit...', 'Generating report...'];
        const labelIdx = Math.min(labels.length - 1, Math.floor(p * labels.length));
        
        setProgress(currentPct, labels[labelIdx]);
        if (p >= 1) clearInterval(previewTimer);
      }, 50);

      await new Promise(r => setTimeout(r, duration));
      clearInterval(previewTimer);
    }

    loadingEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    placeholderB.start();
    placeholderC.start();

    if (!response.body) throw new Error('Response body is empty');
    
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      if (onChunk) onChunk();

      buffer += decoder.decode(value, { stream: true });

      if (isSSE) {
        // SSE Logic (Uses \n\n as boundary)
        while (true) {
          const boundary = buffer.indexOf('\n\n');
          if (boundary === -1) break;

          const rawEvent = buffer.slice(0, boundary);
          buffer = buffer.slice(boundary + 2);

          for (const line of rawEvent.split('\n')) {
            if (!line.startsWith('data: ')) continue;
            const dataStr = line.slice(6).trim();
            if (!dataStr || dataStr === '[DONE]') continue;

            try {
              const item = JSON.parse(dataStr);
              if (onEachItem) onEachItem(item);
              await processEvent(item);
            } catch (e) {
              console.error('SSE Line parse error:', dataStr, e);
            }
          }
        }
      } else {
        // Standard NDR-JSON Logic (Uses \n as boundary)
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || trimmed.startsWith(':')) continue;
          let dataStr = trimmed;
          if (dataStr.startsWith('data: ')) dataStr = dataStr.substring(6).trim();
          if (!dataStr || dataStr === '[DONE]') continue;

          try {
            const item = JSON.parse(dataStr);
            if (onEachItem) onEachItem(item);
            await processEvent(item);
          } catch (e) { 
            console.error('NDR JSON Line parse error:', dataStr, e); 
          }
        }
      }
    }

    // Process leftover buffer
    if (buffer.trim()) {
        const trimmed = buffer.trim();
        let dataStr = trimmed;
        if (dataStr.startsWith('data: ')) dataStr = dataStr.substring(6).trim();
        if (dataStr && dataStr !== '[DONE]') {
            try {
                const item = JSON.parse(dataStr);
                if (onEachItem) onEachItem(item);
                await processEvent(item);
            } catch (e) {}
        }
    }
    window.dispatchEvent(new CustomEvent('analysis-complete'));
  }

  // ── Scroll Behavior for Area B/C (Desktop) ──
  const setupAreaScroll = () => {
    const wrappers = document.querySelectorAll('.scroll-wrapper-b, .news-display');
    wrappers.forEach(wrapper => {
      wrapper.addEventListener('wheel', (e: any) => {
        if (window.innerWidth > 640) {
          const el = e.currentTarget as HTMLElement;
          const isScrollable = el.scrollHeight > el.clientHeight;
          
          if (!isScrollable) return;

          const isAtTop = el.scrollTop <= 0;
          const isAtBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 1;
          
          // If scrolling down at the bottom or up at the top, let the page scroll
          if (e.deltaY > 0 && isAtBottom) return;
          if (e.deltaY < 0 && isAtTop) return;

          // Otherwise, stop propagation to isolate scroll to the panel
          e.stopPropagation();
        }
      }, { passive: true });
    });
  };
  setupAreaScroll();

