        left: 'center',
        top: 'center',
        width: '95%',
        height: '95%',
        sizeRange: [14, 80],
        rotationRange: [0, 0],
        gridSize: 10,
        drawOutOfBound: false,
        layoutAnimation: true,
        textStyle: {
