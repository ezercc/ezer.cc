  function showError(msg?: string) {
    if (msg) console.error('[Analysis Error Detail]:', msg);
    loadingEl.classList.add('hidden');
    errorEl.classList.remove('hidden');

    const backLink = document.getElementById('back-link');
    const upgradeLink = document.getElementById('upgrade-link');

    // If it's a quota error, swap buttons
    if (msg && msg.toLowerCase().includes('quota exceeded')) {
      errorTextEl.innerHTML = i18n['quota.limit_reached'];
      if (backLink) backLink.classList.add('hidden');
      if (upgradeLink) upgradeLink.classList.remove('hidden');
    } else if (msg && (msg.toLowerCase().includes('unauthorized') || msg.toLowerCase().includes('401'))) {
      errorTextEl.innerHTML = i18n['auth.unauthorized'];
      if (backLink) backLink.classList.remove('hidden');
      if (upgradeLink) upgradeLink.classList.add('hidden');
    } else {
      // Normal error
      if (backLink) backLink.classList.remove('hidden');
      if (upgradeLink) upgradeLink.classList.add('hidden');
    }
  }

  async function typeText(el: HTMLElement, text: string, _legacySpeed?: number) {
    if (!el || !text) return;
    const len = text.length;
    let chunkSize = 1;
    let delay = 14;

    if (len < 100) {
      chunkSize = 1;
      delay = 14;
    } else if (len <= 300) {
      chunkSize = 2;
      delay = 10;
    } else {
      chunkSize = 4;
      delay = 10;
    }

    const scrollParent = el.closest('.scroll-wrapper-b') || el.closest('.text-output');
    let i = 0;
    while (i < len) {
      const chunk = text.slice(i, i + chunkSize);
      el.textContent += chunk;
      i += chunkSize;

      if (chunk.includes('\n') || chunk.includes('。') || chunk.includes('.')) {
        if (scrollParent) {
          scrollParent.scrollTo({ top: scrollParent.scrollHeight, behavior: 'smooth' });
        }
      }
      await new Promise(r => setTimeout(r, delay));
    }

    if (scrollParent) {
      scrollParent.scrollTo({ top: scrollParent.scrollHeight, behavior: 'smooth' });
    }

    linkageParser.parseAndBind(el);
  }

  function setProgress(pct: number, label?: string) {
    progressBar.style.width = pct + '%';
    progressLabel.textContent = pct + '%';
    if (label) loadingTextEl.textContent = label;
  }

  function formatDetailValue(value: unknown): string {
    if (typeof value === 'string') return value.trim();

    if (Array.isArray(value)) {
      return value
        .map(formatDetailValue)
        .filter(Boolean)
        .join(', ');
    }

    if (value && typeof value === 'object') {
      const record = value as Record<string, unknown>;
      for (const key of ['text', 'content', 'detail', 'summary', 'message', 'description']) {
        const text = formatDetailValue(record[key]);
        if (text) return text;
      }

      try {
        return JSON.stringify(value);
      } catch {
        return '';
      }
    }

    if (typeof value === 'number') return Number.isFinite(value) ? String(value) : '';
    if (typeof value === 'boolean') return String(value);
    return '';
  }

  /**
   * Process a single event from the stream
   */
  async function processEvent(item: any) {
    if (!item) return;
    console.log('[Stream Event]', item);
    const { producer, event, data } = item;
    const value = item.value || data; // Handle alternate field names

    if (event === 'a_data') {
      const { label, data: chartData, type, suffix } = value;
      if (label && chartData) {
        const idMap: Record<string, string> = {
          'Revenue': 'chart-revenue',
          '营业收入': 'chart-revenue',
          'Net Profit': 'chart-profit',
          '净利润': 'chart-profit',
          'Gross Margin': 'chart-margin',
          '毛利率': 'chart-margin',
          'Debt Ratio': 'chart-debt',
          '资产负债率': 'chart-debt'
        };
        const id = idMap[label] || `chart-${label.toLowerCase()}`;
        chartManager.render(id, chartData.map((d:any) => typeof d === 'object' ? d : {period: '', value: d}), label, suffix || '');
        await new Promise(r => setTimeout(r, 400));
      }
      return;
    }

    // Normalize producer name (A, B, C or normalizer, analyzer, auditor)
    const p = (producer || '').toUpperCase();

    // Industry News Event (Section I)
    if (event === 'i_industry_wordsea' || event === 'industry_wordsea' || event === 'i_industry_word_cloud' || (p === 'I' && (event === 'data' || event === 'wordsea' || event === 'i_industry_wordsea'))) {
      const industryGrid = document.querySelector('.industry-grid');
      if (industryGrid) industryGrid.classList.remove('hidden');
      
      let d = data || item.data || item;
      if (typeof d === 'string') {
        try {
          d = JSON.parse(d);
        } catch (e) {}
      }
      
      const rows = d && (d.rows || d.items || d.list || (Array.isArray(d) ? d : null));
      if (rows && Array.isArray(rows)) {
        const keywords = rows.map((row: any) => {
          const keyword = Array.isArray(row) ? row[0] : (row.keyword || row.word || '');
          const count = Array.isArray(row) ? row[1] : (row.count || row.weight || 1);
          return [keyword, count];
        });
        const newsMap = new Map();
        rows.forEach((row: any) => {
          const keyword = Array.isArray(row) ? row[0] : (row.keyword || row.word || '');
          const count = Array.isArray(row) ? row[1] : (row.count || row.weight || 1);
          const articles = Array.isArray(row) ? row[2] : (row.links || row.articles || []);
          newsMap.set(keyword, { articles, totalCount: count });
        });
        renderWordCloud(keywords, newsMap);
      }
      return;
    }

    if ((p === 'A' || p === 'NORMALIZER') && (event === 'a_normalized' || event === 'data')) {
      const d = data || item.data; // Handle if data is directly in item or nested
      if (!d) return;
      
      const { company, report, income_statement, balance_sheet, key_ratios, history_12q } = d;
      
      if (history_12q) {
        await renderCharts(history_12q);
      }

      if (company) {
        // Update Page Title dynamically
        const companyName = company.name || '';
        let periodText = company.reporting_period || '';
        // Localize 'FY' to '年度' for Chinese
        if (lang === 'zh' && periodText.toLowerCase().includes('fy')) {
          periodText = periodText.replace(/fy/i, '年度');
        }

        if (companyName) {
            const titleSuffix = lang === 'zh' ? '财报分析' : 'Financial Report Analysis';
            pageTitleEl.textContent = `${companyName} (${periodText}) ${titleSuffix}`;
            document.title = `${companyName} (${periodText}) ${titleSuffix} - Ezer`;
        }
      }
    }

    if ((p === 'B' || p === 'ANALYZER')) {
      if (placeholderB.isActive()) placeholderB.stop();
      const d = data || item.data;
      if (!d) return;

      if (event === 'b_progress') {
        const stepPrefix = lang === 'zh' ? '正在' : 'Analyzing';
        writers.b.writeHTML(`<div class="progress-update"><i>› ${stepPrefix} ${d.task || d.step || (lang === 'zh' ? '执行分析' : 'Performing Analysis')}...</i></div>`);
        return;
      }

      if (event === 'b_card' || event === 'analysis') {
        const cardId = d.card_id || 'unknown';
        
        // Find if this card is already rendered (self-healing / merge logic)
        let card = writers.b.element.querySelector(`.analysis-card[data-card-id="${cardId}"]`) as HTMLElement;
        const isNewCard = !card;
        
        if (isNewCard) {
          card = document.createElement('div');
          card.className = 'analysis-card';
          card.dataset.cardId = cardId;
          writers.b.element.appendChild(card);
        } else {
          // Reset card content for reload
          card.innerHTML = '';
        }

        // Title fallback logic
        const CARD_TITLES: Record<string, Record<string, string>> = {
          business_outlook: {
            zh: "经营展望",
            en: "Business Outlook",
          },
        };
        const titleText = (d.title && d.title.trim())
          || CARD_TITLES[cardId]?.[lang]
          || cardId;
        
        // ── Card Header ──
        const headerEl = document.createElement('div');
        headerEl.className = 'card-header';

        const h3 = document.createElement('h3');
        h3.className = 'card-title';
        h3.textContent = titleText;
        headerEl.appendChild(h3);

        card.appendChild(headerEl);
        
        // ── 1. Executive Summary / Conclusion (Lead Paragraph) ──
        if (d.conclusion) {
          const conclusion = document.createElement('p');
          conclusion.className = 'conclusion';
          card.appendChild(conclusion);
          await typeText(conclusion, d.conclusion);
        }

        // ── 2. Editorial Fields: Evidence, Cross-Checks, Counterpoints, Implication ──
        const fieldDefs = [
          { key: 'evidence', label: lang === 'zh' ? '依据' : 'Evidence', cls: 'is-evidence' },
          { key: 'cross_checks', label: lang === 'zh' ? '交叉核验' : 'Cross-Checks', cls: 'is-crosschecks' },
          { key: 'counterpoints', label: lang === 'zh' ? '反向观点' : 'Counterpoints', cls: 'is-counterpoints' },
          { key: 'investor_implication', label: lang === 'zh' ? '投资启示' : 'Investor Implication', cls: 'is-implication' },
        ];

        for (const f of fieldDefs) {
          const valText = formatDetailValue(d[f.key]);
          if (valText) {
            const block = document.createElement('div');
            block.className = `field-block ${f.cls}`;

            const labelEl = document.createElement('div');
            labelEl.className = 'field-label';
            labelEl.textContent = f.label;
            block.appendChild(labelEl);

            const contentEl = document.createElement('div');
            contentEl.className = 'field-content';
            block.appendChild(contentEl);

            card.appendChild(block);

            await typeText(contentEl, valText);
          }
        }

        // ── 3. Source References (Clean Footnote Line) ──
        if (d.source_refs && Array.isArray(d.source_refs) && d.source_refs.length > 0) {
          const seen = new Set();
          const uniqueRefs = d.source_refs.filter((ref: any) => {
            if (!ref) return false;
            const key = `${ref.source_url || ''}_${ref.section_id || ''}`;
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });

          if (uniqueRefs.length > 0) {
            const sourcesDiv = document.createElement('div');
            sourcesDiv.className = 'card-sources';

            const labelSources = lang === 'zh' ? '数据来源:' : 'Sources:';
            const labelSpan = document.createElement('span');
            labelSpan.className = 'sources-label';
            labelSpan.textContent = labelSources;
            sourcesDiv.appendChild(labelSpan);

            uniqueRefs.forEach((ref: any, idx: number) => {
              const periodText = ref.report_period ? `[${ref.report_period}] ` : '';
              const nameText = ref.source_name || '';
              const locatorText = ref.source_locator ? ` (${ref.source_locator})` : '';
              const displayText = `${periodText}${nameText}${locatorText}`;

              if (ref.source_url && ref.source_url.trim()) {
                const a = document.createElement('a');
                a.href = ref.source_url.trim();
                a.target = '_blank';
                a.rel = 'noreferrer';
                a.className = 'source-link';
                a.textContent = displayText;
                sourcesDiv.appendChild(a);
              } else {
                const span = document.createElement('span');
                span.className = 'source-text';
                span.textContent = displayText;
                sourcesDiv.appendChild(span);
              }

              if (idx < uniqueRefs.length - 1) {
                const sep = document.createElement('span');
                sep.className = 'sources-sep';
                sep.textContent = '·';
                sourcesDiv.appendChild(sep);
              }
            });

            card.appendChild(sourcesDiv);
          }
        }
      }
    }

    if ((p === 'C' || p === 'AUDITOR')) {
      if (placeholderC.isActive()) placeholderC.stop();
      const d = data || item.data;
      if (!d) return;

      if (event === 'c_progress') {
        const stepPrefix = lang === 'zh' ? '正在' : 'Analyzing';
        writers.c.writeHTML(`<div class="progress-update"><i>› ${stepPrefix} ${d.task || d.step || (lang === 'zh' ? '执行审计' : 'Performing Audit')}...</i></div>`);
        return;
      }

      if (event === 'c_challenge') {
        const challengeKey = d.target_card_id || d.issue || '';
        let div = writers.c.element.querySelector(`.audit-item.challenge[data-challenge-key="${challengeKey}"]`) as HTMLElement;
        const isNew = !div;
        
        if (isNew) {
          div = document.createElement('div');
          div.className = 'audit-item challenge';
          div.dataset.challengeKey = challengeKey;
          writers.c.element.appendChild(div);
        } else {
          div.innerHTML = '';
        }

        const labelChallenge = lang === 'zh' ? '审计挑战' : 'Audit Challenge';
        div.innerHTML = `<div class="audit-icon-text"><i class="fa-solid fa-triangle-exclamation"></i> ${labelChallenge} (${d.severity || 'MEDIUM'})</div>`;
        const content = document.createElement('div');
        content.className = 'audit-content';
        div.appendChild(content);
        if (d.target_card_id) {
          const meta = document.createElement('div');
          meta.className = 'audit-meta';
          const labelTarget = lang === 'zh' ? '针对' : 'Target';
          meta.textContent = `${labelTarget}: ${d.target_card_id}`;
          div.appendChild(meta);
        }
        if (d.issue) await typeText(content, d.issue, 15);
      }

      if (event === 'c_resolved' || event === 'audit') {
        const resolvedKey = d.target_card_id || d.rationale || d.content || d.text || '';
        let div = writers.c.element.querySelector(`.audit-item.resolved[data-resolved-key="${resolvedKey}"]`) as HTMLElement;
        const isNew = !div;
        
        if (isNew) {
          div = document.createElement('div');
          div.className = 'audit-item resolved';
          div.dataset.resolvedKey = resolvedKey;
          writers.c.element.appendChild(div);
        } else {
          div.innerHTML = '';
        }

        const labelResolved = lang === 'zh' ? '审计通过' : 'Audit Resolved';
        div.innerHTML = `<div class="audit-icon-text"><i class="fa-solid fa-circle-check"></i> ${labelResolved}</div>`;
        const content = document.createElement('div');
        content.className = 'audit-content';
        div.appendChild(content);
        if (d.target_card_id) {
          const meta = document.createElement('div');
          meta.className = 'audit-meta';
          const labelFix = lang === 'zh' ? '解决项' : 'Fixed';
          meta.textContent = `${labelFix}: ${d.target_card_id}`;
          div.appendChild(meta);
        }
        const textToType = d.rationale || d.content || d.text || '';
        if (textToType) await typeText(content, textToType, 15);
      }
    }


    if (event === 'final_summary' || event === 'summary') {
      if (summaryText.classList.contains('is-placeholder')) {
        summaryText.textContent = '';
        summaryText.classList.remove('is-placeholder');
      }
      const d = data || item.data;
      if (d) {
        const text = d.summary || d.content || d.text || '';
        await typeText(summaryText, text, 15);
      }
    }

    if (event === 'final_result' || event === 'result') {
      const d = data || item.data;
      if (d) {
        finalResultText.classList.remove('hidden');
        const prefix = lang === 'zh' ? '最终结果：' : 'Final Result: ';
        finalResultText.textContent = prefix + (d.final_status || d.status || d.result || '');
      }
    }

    if (event === 'error' || event === 'task_failed') {
      const d = data || item.data;
      const msg = d?.message || d?.error || 'Unknown error occurred';
      showError(msg);
      return;
    }
  }

  /**
   * Main logic to handle simulated stream
   */
  async function processStream(stream: any[]) {
    loadingEl.classList.add('hidden');
    resultsEl.classList.remove('hidden');

    // Start placeholders
    placeholderB.start();
    placeholderC.start();

    for (const item of stream) {
      await processEvent(item);
      await new Promise(r => setTimeout(r, 100));
    }

    window.dispatchEvent(new CustomEvent('analysis-complete'));
  }

  // ── Main entry point ──
  async function main() {
    let collectedData: any[] = [];

    try {


      const apiParams = new URLSearchParams(window.location.search);
      apiParams.set('lang', lang);

      console.log('--- Initiating Audit (Locally checking cache first) ---');

      let currentProgress = 5;
      const startTime = Date.now();
      const progressTimer = setInterval(() => {
        const elapsed = Date.now() - startTime;
        if (elapsed < 1200) {
          currentProgress = 5 + (45 * (elapsed / 1200));
        } else if (elapsed < 10000) {
          currentProgress = 50 + (45 * ((elapsed - 1200) / 8800));
        } else {
          currentProgress = 95;
        }
        const label = currentProgress < 50 
          ? (lang === 'zh' ? 'Connecting to audit server...' : 'Connecting to audit server...')
          : (lang === 'zh' ? 'Server deeply analyzing financial data...' : 'Server deeply analyzing financial data...');
        setProgress(Math.floor(currentProgress), label);
      }, 50);

      const cleanup = () => clearInterval(progressTimer);

      try {
        const localResp = await fetch(`/api/check?${apiParams.toString()}`);
        if (localResp.status === 401) {
          cleanup();
          showError('unauthorized');
          return;
        }
        // BUG1 Fix: Explicitly intercept 403 (Quota Exceeded) for a clean UI path.
        if (localResp.status === 403) {
          cleanup();
          showError('Quota exceeded');
          return;
        }

        const contentType = localResp.headers.get('content-type');

      // (A) Cache Hit Case: Process as a stream as before
      if (contentType && contentType.includes('application/x-ndjson')) {
        console.log('Cache Hit: Streaming from local API...');
        cleanup();
        await handleResponseStream(localResp);
        return;
      }

      // (B) Cache Miss or Error Case: Handle JSON response
      const serverResult = await localResp.json();
      
      if (serverResult.error) {
        throw new Error(serverResult.error);
      }

      // (C) Direct Stream Case: Bypassing Vercel timeouts using pre-initialized task from server
      if (serverResult.action === 'direct_stream') {
        const taskId = serverResult.task_id;
        const tempToken = serverResult.token;

        const streamUrl = serverResult.stream_url;
        const resultUrl = serverResult.result_url;
        const resultBrUrl = serverResult.result_br_url;
        const resultBrRawUrl = serverResult.result_br_raw_url;

        if (!streamUrl) throw new Error('No stream_url from backend');

        // Step 2: Stream from backend with a 5-minute initial connection timeout
        const controller = new AbortController();
        let isSuccessfullyCompleted = false;
        let timeoutId = setTimeout(() => {
          controller.abort();
          showError(isEn ? 'Connection timeout, please refresh later' : '分析连接超时，请稍后刷新重试');
        }, 300000);

        console.log('Connecting to direct stream:', streamUrl);
        const streamResp = await fetch(streamUrl, {
            headers: tempToken ? { 'Authorization': `Bearer ${tempToken}`, 'Accept': 'text/event-stream' } : { 'Accept': 'text/event-stream' },
            signal: controller.signal
        });

        if (!streamResp.ok) {
            clearTimeout(timeoutId);
            throw new Error(`Stream download failed: ${streamResp.status}`);
        }
        
        cleanup();
        // Handle SSE stream using the pattern from public/examples/frontend_call_example_v1.md
        await handleResponseStream(
            streamResp, 
            (item) => {
                collectedData.push(item);
                // Check if this is a completion event
                if (item.event === 'final_result' || item.event === 'result') {
                    isSuccessfullyCompleted = true;
                }
            }, 
            true, // isSSE
            () => {
                // Each chunk extends the 5-minute inactivity timeout.
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => {
                    controller.abort();
                    showError(isEn ? 'Report generation timeout, please refresh later' : '报告生成超时，请稍后刷新重试');
                }, 300000);
            }
        );

        clearTimeout(timeoutId);
        if (!isSuccessfullyCompleted) {
            showError();
            return;
        }

        // Step 3: Fetch Final Result from auto-decoding Brotli endpoint if available, otherwise fallback to resultUrl
        const finalFetchUrl = resultBrUrl || resultUrl;
        if (finalFetchUrl && collectedData.length > 0) {
            console.log('Fetching final result for data verification from:', finalFetchUrl);
            try {
                const finalResp = await fetch(finalFetchUrl, {
                    headers: tempToken ? { 'Authorization': `Bearer ${tempToken}` } : {}
                });
                if (finalResp.ok) {
                    const finalData = await finalResp.json();
                    console.log('Final Result Data:', finalData);
                    
                    // Self-healing merge logic: Re-run all event processors from full backend stream
                    const finalStream = finalData.stream || finalData;
                    if (Array.isArray(finalStream)) {
                        console.log(`[Self-healing] Merging final stream. Total items: ${finalStream.length}`);
                        for (const item of finalStream) {
                            await processEvent(item);
                        }
                    }
                }
            } catch (e) {
                console.error('Failed to fetch final result:', e);
            }
        }

        // Step 4: Request BFF to verify and store cache securely.
        // The BFF resolves the result endpoint from the task binding; the browser
        // only needs to provide the task ID for either Brotli or JSON results.
        if (isSuccessfullyCompleted && collectedData.length > 0 && taskId) {
            console.log('Analysis complete and verified. Requesting BFF cache backfill...');
            
            const backfillCache = async () => {
              // BUG2 companion fix: Do not send token; BFF must always use its env BACKEND_TOKEN.
              const backfillPayload = {
                taskId
              };

              console.log('Sending backfill request to BFF:', backfillPayload);
              const postResp = await fetch('/api/check', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(backfillPayload)
              });
              console.log('BFF cache backfill response code:', postResp.status);
            };
            
            backfillCache().catch(err => console.error('Cache backfill failed:', err));
        }
      }
    } finally {
      cleanup();
    }
  } catch (err: any) {
    cleanup();
    if (err.name === 'AbortError') {
      // Already handled by timer above, but safety catch
    } else {
      showError(err.message);
    }
  }
}

