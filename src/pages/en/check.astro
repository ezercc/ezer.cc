---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { ui } from "../../i18n/ui";
import QuotaBanner from "../../components/QuotaBanner.astro";
import AnalysisRating from "../../components/AnalysisRating.astro";


const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translations = ui[lang];
---

<!-- Injected i18n for client-side script -->
<meta name="check-i18n" content={JSON.stringify(translations)} />

<Layout 
  title={t("check.title")}
  description="Deep red-blue adversarial financial report analysis. Analyze financial indicators, detect potential risks, and receive investment recommendations with complete evidence."
  keywords="financial deep analysis, audit report generation, investment risks, financial performance visualization"
>
  <div class="check-page">
    <div class="u-container">
      <!-- Page Header -->
      <div class="check-header">
        <h1 class="check-title" id="page-title">{t("check.title")}</h1>
      </div>



      <!-- Loading State -->
      <div class="loading-container" id="loading-container">
        <div class="financial-quantum-loader">
          <!-- Background Grid & Glow -->
          <div class="loader-backdrop"></div>
          <div class="scanning-beam"></div>
          
          <div class="loader-main">
            <!-- Central Dynamic Icon (Rotates through states) -->
            <div class="pivot-icon">
              <div class="icon-state s-shield active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div class="icon-state s-chart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
              </div>
              <div class="icon-state s-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              </div>
            </div>
            
            <!-- Candlestick Animation -->
            <div class="finance-viz">
              <div class="candle c1"></div>
              <div class="candle c2"></div>
              <div class="candle c3"></div>
              <div class="candle c4"></div>
              <div class="candle c5"></div>
            </div>

            <!-- Ticker Band -->
            <div class="ticker-tape">
              <div class="ticker-track">
                <span>REVENUE_VAL: OK</span><span>NET_PROFIT: STABLE</span><span>DEBT_RATIO: 42%</span><span>AUDIT_PROC_INIT</span><span>CROSS_CHECKED</span><span>CASH_FLOW_PULSE</span>
              </div>
            </div>

            <!-- Data Flux Particles -->
            <div class="data-flux">
              <span class="flux-item">RISK:LOW</span>
              <span class="flux-item">AUDIT:PASS</span>
              <span class="flux-item">DATA:99.9%</span>
              <span class="flux-item">ROI:12%</span>
            </div>
          </div>
          
          <!-- Outer Orbits -->
          <div class="orbit-path op-1"></div>
          <div class="orbit-path op-2"></div>
        </div>

        <div class="loading-info">
          <p class="loading-text" id="loading-text">{t("check.loading")}</p>
          <div class="progress-bar-wrapper">
            <div class="progress-bar" id="progress-bar"></div>
            <div class="progress-glow"></div>
          </div>
          <p class="progress-label" id="progress-label">0%</p>
        </div>
      </div>

      <!-- Error State -->
      <div class="error-container hidden" id="error-container">
        <div class="error-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <p class="error-text" id="error-text">{t("check.error")}</p>
        <a id="back-link" href={lang === "zh" ? "/search/" : "/en/search/"} class="back-btn">
          ← {lang === "zh" ? "返回搜索" : "Back to Search"}
        </a>
        <a id="upgrade-link" href={lang === "zh" ? "/premium/?from=exceed" : "/en/premium/?from=exceed"} class="back-btn hidden">
          {t("quota.upgrade_now")}
        </a>
      </div>

      <!-- Results -->
      <div class="results-container hidden" id="results-container">
        <!-- Stage 1: Dual-Column Stage (A & B Independent Containers) -->
        <div class="stage-analysis-grid" id="stage-analysis-grid">
          <!-- Independent Container A: Data Normalization (Sticky) -->
          <div class="analysis-panel panel-a section-a hidden" id="panel-a">
            <div class="panel-header">
              <span class="panel-badge">A</span>
              <span class="panel-title">{lang === 'zh' ? '数据归一化' : 'Data Normalization'}</span>
            </div>
            <div class="charts-grid" id="charts-a">
              <div class="chart-item">
                <div class="chart-label">{lang === 'zh' ? '营业收入' : 'Revenue'}</div>
                <div class="chart-canvas-wrapper">
                  <div id="chart-revenue" class="chart-canvas"></div>
                </div>
              </div>
              <div class="chart-item">
                <div class="chart-label">{lang === 'zh' ? '净利润' : 'Net Profit'}</div>
                <div class="chart-canvas-wrapper">
                  <div id="chart-profit" class="chart-canvas"></div>
                </div>
              </div>
              <div class="chart-item">
                <div class="chart-label">{lang === 'zh' ? '毛利率' : 'Gross Margin'}</div>
                <div class="chart-canvas-wrapper">
                  <div id="chart-margin" class="chart-canvas"></div>
                </div>
              </div>
              <div class="chart-item">
                <div class="chart-label">{lang === 'zh' ? '资产负债率' : 'Debt Ratio'}</div>
                <div class="chart-canvas-wrapper">
                  <div id="chart-debt" class="chart-canvas"></div>
                </div>
              </div>
            </div>

            <!-- Area A Bottom Unified Timeline Zoom Slider (1 slider controls all 4 charts) -->
            <div class="timeline-controller" id="timeline-controller">
              <div class="timeline-slider-wrapper">
                <div id="chart-timeline-slider" class="timeline-slider-canvas"></div>
              </div>
            </div>
          </div>
          
          <!-- Independent Container B: Analysis Cards Stream -->
          <div class="analysis-panel panel-b section-b" id="panel-b">
            <div class="panel-header">
              <span class="panel-badge">B</span>
              <span class="panel-title">{lang === 'zh' ? '深度分析' : 'Analyzer'}</span>
            </div>
            <div class="scroll-wrapper-b">
              <div class="text-output" id="text-b"></div>
            </div>
          </div>
        </div>

        <!-- Stage 2: Full-Width Industry Information (I) -->
        <div class="analysis-panel panel-i section-i" id="panel-i">
          <div class="panel-header">
            <span class="panel-badge">I</span>
            <span class="panel-title">{t("check.industry")}</span>
          </div>
          <div class="industry-grid hidden">
            <div class="wordcloud-container">
              <div id="industry-wordcloud" class="wordcloud-canvas"></div>
            </div>
            <div class="news-display">
              <div id="news-header" class="news-header hidden"></div>
              <div id="news-placeholder" class="news-placeholder">
                <div class="placeholder-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                <p>{t("check.industry_placeholder")}</p>
              </div>
              <div id="news-list" class="news-list hidden"></div>
            </div>
          </div>
        </div>

        <!-- Stage 3: Full-Width Auditor Text (C) -->
        <div class="analysis-panel panel-c section-c" id="panel-c">
          <div class="panel-header">
            <span class="panel-badge">C</span>
            <span class="panel-title">{lang === 'zh' ? '风险审计' : 'Risk Audit'}</span>
          </div>
          <div class="scroll-wrapper-b">
            <div class="text-output" id="text-c"></div>
          </div>
        </div>

        <!-- Summary Section -->
        <div class="summary-container" id="summary-section-container">
          <h2 class="col-title">{t("check.headline")}</h2>
          <div class="summary-box">
            <div id="summary-text" class="text-output"></div>
            <div class="final-result-wrapper">
              <div id="final-result-text" class="final-result-output hidden"></div>
              <AnalysisRating slug="" lang="en" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <QuotaBanner />
  </div>
</Layout>

<style>
  .check-page {
    min-height: 100vh;
    padding-top: calc(var(--survey-banner-height, 0px) + 120px);
    padding-bottom: 4rem;
    padding-left: 1rem;
    padding-right: 1rem;
    background: var(--color-bg);
    transition: padding-top 0.3s var(--ease-out-cubic);
  }

  :global(body:not(.has-survey-banner)) .check-page {
    padding-top: 115px;
  }

  :global(body.has-survey-banner) .check-page {
    padding-top: calc(var(--survey-banner-height, 44px) + 115px);
  }

  /* ── Header ── */
  .check-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }



  .check-title {
    font-family: var(--font-roboto-slab);
    font-size: clamp(1.4rem, 3.5vw, 2.4rem);
    color: var(--color-text);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ── Loading ── */
  .loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    padding: 0 1rem 4rem;
    min-height: 55vh;
  }

  .financial-quantum-loader {
    position: relative;
    width: 280px;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 24px;
    background: rgba(var(--rgb-brand-1), 0.02);
    border: 1px solid rgba(var(--rgb-brand-1), 0.1);
    box-shadow: inset 0 0 40px rgba(var(--rgb-brand-1), 0.05);
  }

  .loader-backdrop {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(var(--rgb-brand-1), 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--rgb-brand-1), 0.1) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.3;
  }

  .scanning-beam {
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(to bottom, transparent, rgba(var(--rgb-brand-1), 0.2), transparent);
    animation: beam-scan 3s ease-in-out infinite;
    z-index: 1;
  }

  @keyframes beam-scan {
    0% { top: -40%; }
    50% { top: 100%; }
    100% { top: -40%; }
  }

  .loader-main {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .pivot-icon {
    width: 60px;
    height: 60px;
    color: var(--color-brand-1);
    filter: drop-shadow(0 0 15px rgba(var(--rgb-brand-1), 0.5));
    position: relative;
    margin-bottom: 20px;
  }

  .icon-state {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(0.8) rotate(-10deg);
    transition: all 0.5s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-state.active {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .icon-state svg {
    width: 100%;
    height: 100%;
    stroke: var(--color-brand-1);
  }

  /* Auto-rotation of icons handled by animation */
  .s-shield { animation: state-cycle 9s infinite 0s; }
  .s-chart { animation: state-cycle 9s infinite 3s; }
  .s-search { animation: state-cycle 9s infinite 6s; }

  @keyframes state-cycle {
    0%, 28% { opacity: 1; transform: scale(1) rotate(0deg); }
    33.33%, 95% { opacity: 0; transform: scale(0.8) rotate(10deg); }
    100% { opacity: 0; }
  }

  /* Candlesticks */
  .finance-viz {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 60px;
    margin-bottom: 20px;
  }

  .candle {
    width: 10px;
    border-radius: 2px;
    position: relative;
  }

  .candle::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 2px;
    height: 120%;
    bottom: -10%;
    transform: translateX(-50%);
    background: inherit;
    opacity: 0.4;
  }

  .c1 { height: 30px; background: #10b981; animation: fluctu-green 2s infinite 0s; }
  .c2 { height: 45px; background: #ef4444; animation: fluctu-red 2.5s infinite 0.3s; }
  .c3 { height: 25px; background: #10b981; animation: fluctu-green 1.8s infinite 0.6s; }
  .c4 { height: 50px; background: #10b981; animation: fluctu-green 2.2s infinite 0.9s; }
  .c5 { height: 35px; background: #ef4444; animation: fluctu-red 2.1s infinite 1.2s; }

  @keyframes fluctu-green {
    0%, 100% { height: 20px; }
    50% { height: 40px; }
  }
  @keyframes fluctu-red {
    0%, 100% { height: 50px; }
    50% { height: 25px; }
  }

  /* Ticker Tape */
  .ticker-tape {
    width: 120%;
    background: rgba(0, 0, 0, 0.2);
    padding: 4px 0;
    transform: rotate(-5deg);
    border-top: 1px solid rgba(var(--rgb-brand-1), 0.2);
    border-bottom: 1px solid rgba(var(--rgb-brand-1), 0.2);
    overflow: hidden;
  }

  .ticker-track {
    display: flex;
    white-space: nowrap;
    gap: 30px;
    animation: ticker-slide 15s linear infinite;
  }

  .ticker-track span {
    font-size: 0.7rem;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    color: var(--color-text-alt);
  }

  @keyframes ticker-slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Data Flux */
  .data-flux {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .flux-item {
    position: absolute;
    font-size: 0.6rem;
    font-weight: 800;
    color: var(--color-brand-1);
    background: rgba(var(--rgb-brand-1), 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    font-family: var(--font-mono, monospace);
  }

  .flux-item:nth-child(1) { top: 15%; left: 10%; animation: float-data 4s infinite 0s; }
  .flux-item:nth-child(2) { top: 20%; right: 10%; animation: float-data 4s infinite 1s; }
  .flux-item:nth-child(3) { bottom: 25%; left: 15%; animation: float-data 4s infinite 2s; }
  .flux-item:nth-child(4) { bottom: 15%; right: 15%; animation: float-data 4s infinite 3s; }

  @keyframes float-data {
    0% { transform: translateY(10px); opacity: 0; }
    10% { opacity: 0.8; }
    90% { opacity: 0.8; }
    100% { transform: translateY(-30px); opacity: 0; }
  }

  /* Orbit Paths */
  .orbit-path {
    position: absolute;
    border: 1px dashed rgba(var(--rgb-brand-1), 0.15);
    border-radius: 50%;
  }

  .op-1 { width: 140%; height: 140%; animation: rotate 20s linear infinite; }
  .op-2 { width: 180%; height: 180%; animation: rotate 30s linear infinite reverse; }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .loading-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 440px;
  }

  .loading-text {
    font-size: 1.1rem;
    color: var(--color-text);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .progress-bar-wrapper {
    position: relative;
    width: 100%;
    height: 8px;
    background: rgba(var(--rgb-brand-1), 0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 0.5rem;
  }

  .progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-brand-1), #9333ea);
    border-radius: 999px;
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    z-index: 2;
  }

  .progress-glow {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    animation: shine 2s infinite;
  }

  @keyframes shine {
    from { transform: translateX(-100%); }
    to { transform: translateX(100%); }
  }

  .progress-label {
    font-size: 0.9rem;
    color: var(--color-text-alt);
    font-weight: 700;
    font-family: var(--font-mono, monospace);
  }

  /* ── Error ── */
  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 4rem 1rem;
  }

  .error-icon {
    font-size: 3rem;
  }

  .error-text {
    font-size: 1.1rem;
    color: var(--color-text);
    text-align: center;
  }

  .back-btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.6rem 1.6rem;
    background: var(--color-brand-1);
    color: var(--color-white);
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s var(--ease-out-expo);
  }

  .back-btn:hover {
    filter: brightness(1.1);
    transform: scale(1.04);
  }

  /* ── Full Width Results Container & Screen Utilization ── */
  .check-page .u-container {
    max-width: 1720px;
    width: min(96vw, 1720px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* ── Results Container ── */
  .results-container {
    max-width: 100%;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    overflow: visible;
  }

  /* ── Stage 1: Dual-Column Stage (A & B Independent Containers) ── */
  .stage-analysis-grid {
    display: grid;
    grid-template-columns: minmax(580px, 660px) 1fr;
    gap: 2rem;
    align-items: start;
    width: 100%;
    overflow: visible;
  }

  /* ── Independent Panel Foundation ── */
  .analysis-panel {
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    overflow: visible;
  }

  .panel-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(var(--rgb-brand-1), 0.1);
  }

  :global([data-theme="dark"]) .panel-header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .panel-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: rgba(var(--rgb-brand-1), 0.12);
    color: var(--color-brand-1);
    font-family: var(--font-mono, "SFMono-Regular", Consolas, monospace);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .panel-title {
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-alt);
  }

  /* ── Panel A: Sticky Financial Normalization Card ── */
  .panel-a {
    background: var(--color-surface, #ffffff);
    border: 1px solid rgba(var(--rgb-brand-1), 0.14);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    padding: 1rem 1rem 0.75rem;
    gap: 0.75rem;
    position: sticky;
    top: 160px;
    align-self: start;
    z-index: 5;
    transition: top 0.25s ease;
  }

  :global(body:not(.has-survey-banner)) .panel-a {
    top: 110px;
  }

  :global(body.has-survey-banner.is-nav-small) .panel-a {
    top: 125px;
  }

  :global(body:not(.has-survey-banner).is-nav-small) .panel-a {
    top: 80px;
  }

  :global(body.is-nav-hidden) .panel-a {
    top: 20px;
  }

  :global(body.has-survey-banner.is-nav-hidden) .panel-a {
    top: 64px;
  }

  :global([data-theme="dark"]) .panel-a {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: none;
  }

  /* ── Panel A Timeline Controller (Unified 4-Chart Zoom Slider) ── */
  .timeline-controller {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(var(--rgb-brand-1), 0.1);
  }

  :global([data-theme="dark"]) .timeline-controller {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .timeline-slider-wrapper {
    position: relative;
    width: 100%;
    height: 36px;
  }

  .timeline-slider-canvas {
    width: 100%;
    height: 100%;
  }

  /* ── Panel B: Discrete Cards Column ── */
  .panel-b {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .panel-b .panel-header {
    margin-bottom: 0.6rem;
  }

  .scroll-wrapper-b {
    flex: 1;
    overflow-y: visible;
  }

  /* ── Panel I & Panel C (Full-Width Stages) ── */
  .panel-i, .panel-c {
    background: var(--color-surface, #ffffff);
    border: 1px solid rgba(var(--rgb-brand-1), 0.14);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    padding: 1.5rem;
  }

  :global([data-theme="dark"]) .panel-i,
  :global([data-theme="dark"]) .panel-c {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: none;
  }

  .hidden {
    display: none !important;
  }

  /* ── Section I (Industry) ── */
  .section-i {
    grid-column: 1 / 3;
    border-top: 1px solid rgba(var(--rgb-brand-1), 0.15);
    padding-top: 1.2rem;
    margin-top: 0.5rem;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    min-height: 500px;
    margin-top: 0.5rem;
  }

  .wordcloud-container {
    background: rgba(var(--rgb-brand-1), 0.02);
    border: 1px solid rgba(var(--rgb-brand-1), 0.05);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    height: 500px;
    padding: 0;
    cursor: pointer;
    box-sizing: border-box;
  }

  #industry-wordcloud {
