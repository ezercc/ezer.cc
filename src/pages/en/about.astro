---
import Layout from "../../layouts/Layout.astro";
import TextMarquee from "../../components/TextMarquee.astro";
import Button from "../../components/Button.astro";

const values = [
  {
    title: "Red-Blue Adversarial",
    text: "Industry-first adversarial verification logic: the Red Team uncovers risks while the Blue Team provides counter-proofs, effectively mitigating AI hallucinations and misjudgments.",
  },
  {
    title: "Traceable Evidence",
    text: "We reject 'black box' outputs. We prioritize certainty and traceability, ensuring every conclusion is supported by a complete and rigorous chain of evidence.",
  },
  {
    title: "Democratizing Expertise",
    text: "We are committed to bridging the gap between professional auditing and individual investors by standardizing and productizing elite research workflows.",
  },
  {
    title: "High-Efficiency Synergy",
    text: "Our proprietary orchestration hub drives multi-agent clusters for parallel processing, covering every financial dimension with a massive leap in analysis speed.",
  },
];
---

<Layout 
  title="About Ezer - Redefining Financial Analysis"
  description="Discover the technology and mission behind Ezer. We use AI-driven red-blue adversarial mechanisms to bring transparency and professional-grade research to every investor."
  keywords="Ezer mission, financial audit technology, team vision, financial analysis revolution, transparent research"
>
  <section class="intro">
    <div class="u-container">
      <h1 class="u-heading large-title" data-sy-reveal="blurIn">
        Redefining the Future of <span class="brand-color">Financial Research.</span>
      </h1>
      <p class="u-text intro-text" data-sy-reveal="slideUp">
        We are a sharp, innovative FinTech collective. By introducing red-blue adversarial mechanisms to financial auditing, we empower 150 million investors with expert-level vision to reconstruct financial analysis and uncover true value.
      </p>
    </div>
  </section>

  <section class="story">
    <div id="story-canvas" class="story-canvas"></div>
    <div class="u-container">
      <div class="u-row align-items-center">
        <div class="u-col-6 u-col-md-12 story-content">
          <h2 class="u-heading section-title" data-sy-reveal="words">Our Mission</h2>
          <div class="u-text story-text" data-sy-reveal="fade">
            <p>
              Faced with tedious jargon and data of uncertain authenticity, everyday investors have long been at a disadvantage. Ezer’s mission is to eliminate these barriers so that truth is no longer obscured by bloated information.
            </p>
            <p>
              Through a closed-loop logic, we have transitioned from "information extraction" to "deep auditing." Ezer goes beyond superficial summaries, using rigorous adversarial verification to turn investment risks into tangible, evidence-based insights.
            </p>
          </div>
        </div>
        <div class="u-col-6 u-col-md-12" data-sy-reveal="scaleUp">
          <div class="image-placeholder">
            <img src="/image-4.jpg" alt="Ezer Intelligent Analysis Scenario" class="story-image" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="data-source">
    <div class="u-container">
      <div class="data-grid">
        <div class="data-title">
          <h2 class="u-heading section-title" data-sy-reveal="words">Data Sources & Compliance</h2>
        </div>
        <div class="data-cards" data-sy-reveal="scaleUp">
          <div class="data-badge-container">
            <div class="data-badge-item">
              <span class="icon"><i class="fa-solid fa-chart-simple"></i></span>
              <div>
                <h4>Financial Terminals</h4>
                <p>Fully integrated with leading financial terminals like Choice to ensure source data accuracy.</p>
              </div>
            </div>
            <div class="data-badge-item">
              <span class="icon"><i class="fa-solid fa-file-invoice"></i></span>
              <div>
                <h4>Public Regulatory Filings</h4>
                <p>Directly parsed from official prospectuses, annual/quarterly reports, and regulatory announcements.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="data-text" data-sy-reveal="fade">
          <div class="u-text">
            <p>
              Ezer’s data sources are strictly curated from official periodic financial reports (such as annual and quarterly reports) publicly disclosed by listed companies under legal regulatory frameworks.
            </p><br/>
            <p>
              To ensure data integrity, we perform multi-channel cross-comparisons with authoritative third-party financial data providers. We maintain absolute independence and neutrality: all generated analyses are based purely on historical records with zero subjective predictions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="values">
    <div class="u-container">
      <h2 class="u-heading section-title center" data-sy-reveal="blurIn">Core Technical Philosophy</h2>
      <div class="u-row">
        {values.map((value, i) => (
          <div class="u-col-3 u-col-md-6 u-col-sm-12">
            <div class="value-card" data-sy-reveal="slideUp" style={`--d: ${i * 0.1}s`}>
              <h3 class="u-heading card-title">{value.title}</h3>
              <p class="u-text card-text">{value.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="marquee-section">
    <TextMarquee
      class="about-marquee"
      texts={[
        "Adversarial Verification",
        "Zero Hallucination",
        "Evidence-Based",
        "Empowering Investors",
      ]}
    />
  </section>


</Layout>

<style>
  section {
    padding: 8rem 0;
  }

  .align-items-center {
    align-items: center;
  }

  /* Intro Section */
  .intro {
    padding-top: 12rem;
    text-align: center;
  }

  .large-title {
    --fs: 5rem;
    --lh: 1.1;
    max-width: 15em;
    margin: 0 auto 2rem;

    @media (--mq-phone) {
      --fs: 3rem;
    }
  }

  .brand-color {
    color: var(--color-brand-1);
  }

  .intro-text {
    --fs: 1.5rem;
    max-width: 35em;
    margin: 0 auto;
    opacity: 0.8;

    @media (--mq-phone) {
      --fs: 1.2rem;
    }
  }

  /* Story Section */
  .story {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .story-canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .story-content {
    @media (--mq-tablet) {
      margin-bottom: 3rem;
      text-align: center;
    }
  }

  .section-title {
    --fs: 3rem;
    margin-bottom: 2rem;

    @media (--mq-phone) {
      --fs: 2.25rem;
    }
  }

  .center {
    text-align: center;
    margin-bottom: 4rem;
  }

  .story-text p {
    margin-bottom: 1.5rem;
  }

  .image-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--color-brand-3);
    border-radius: 2rem;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .story-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.5s var(--ease-out-expo);

    &:hover {
      transform: scale(1.02);
    }
  }

  .image-placeholder::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(var(--rgb-brand-1), 0.1), transparent);
  }

  /* Values Section */
  .values .u-row {
    @media (--mq-tablet) {
      row-gap: 1.5rem;
    }
  }

  .value-card {
    height: 100%;
    padding: 3rem;
    background: rgba(var(--rgb-white), 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(var(--rgb-brand-1), 0.1);
    border-radius: 1.5rem;
    transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    animation-delay: var(--d);

    @media (--mq-tablet) {
      padding: 1.5rem;
    }

    :global([data-theme="dark"]) & {
      background: rgba(30, 30, 36, 0.5);
      border-color: rgba(var(--rgb-brand-1), 0.2);
    }

    &:hover {
      transform: translateY(-0.5rem);
      border-color: var(--color-brand-1);
    }
  }

  .card-title {
    --fs: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-brand-1);
  }

  .card-text {
    --fs: var(--font-size-sm);
  }

  /* Marquee Section */
  .marquee-section {
    padding: 4rem 0;
    background: var(--color-brand-1);
    color: var(--color-brand-3);
  }

  .about-marquee {
    --c: var(--color-brand-3);
  }

  /* Data Source Section */
  .data-source {
    position: relative;
    overflow: hidden;
  }

  .data-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "cards title"
      "cards text";
    gap: 2rem 0.5rem;
    align-items: center;

    @media (--mq-tablet) {
      grid-template-columns: 1fr;
      grid-template-areas:
        "title"
        "cards"
        "text";
      gap: 1.5rem;
      text-align: center;
    }
  }

  .data-title {
    grid-area: title;
    align-self: end;

    @media (--mq-tablet) {
      align-self: center;
    }

    h2 {
      margin-bottom: 0;
    }
  }

  .data-cards {
    grid-area: cards;
  }

  .data-text {
    grid-area: text;
    align-self: start;

    @media (--mq-tablet) {
      align-self: center;
    }
  }

  .data-badge-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-right: 3rem;

    @media (--mq-tablet) {
      padding-right: 0;
    }
  }

  .data-badge-item {
    display: flex;
    gap: 1.5rem;
    padding: 2rem;
    background: rgba(var(--rgb-white), 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(var(--rgb-brand-1), 0.1);
    border-radius: 1.5rem;
    transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;

    :global([data-theme="dark"]) & {
      background: rgba(30, 30, 36, 0.5);
      border-color: rgba(var(--rgb-brand-1), 0.2);
    }

    &:hover {
      transform: translateY(-0.25rem);
      border-color: var(--color-brand-1);
    }

    .icon {
      font-size: 2.5rem;
      flex-shrink: 0;
    }

    h4 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--color-text-title);
    }

    p {
      font-size: 0.95rem;
      line-height: 1.5;
      opacity: 0.8;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  function initStoryBackground() {
    const container = document.getElementById('story-canvas');
    if (!container) return;

    container.innerHTML = '';

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight || 1, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const group = new THREE.Group();
    scene.add(group);

    const geometry = new THREE.IcosahedronGeometry(1, 15);
    const material = new THREE.MeshPhysicalMaterial({
      color: 0x8d73f5,
      metalness: 0,
      roughness: 0.2,
      transmission: 0.8,
      thickness: 0.5,
      transparent: true,
      opacity: 0.3,
    });

    const particles = [];
    for (let i = 0; i < 4; i++) {
      const mesh = new THREE.Mesh(geometry, material.clone());
      const scale = 0.5 + Math.random() * 1.5;
      mesh.scale.set(scale, scale, scale);
      mesh.position.set(
        (Math.random() - 0.5) * 10,
        (Math.random() - 0.5) * 6,
        (Math.random() - 0.5) * 4
      );
      
      const colors = [0x8d73f5, 0xec77fd, 0x8caf31];
      mesh.material.color.set(colors[Math.floor(Math.random() * colors.length)]);
      
      group.add(mesh);
      particles.push(mesh);
    }

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);

    const pointLight = new THREE.PointLight(0xffffff, 1);
    pointLight.position.set(5, 5, 5);
    scene.add(pointLight);

    camera.position.z = 8;

    function animate() {
      requestAnimationFrame(animate);
      
      particles.forEach((p, i) => {
        p.rotation.x += 0.0005 * (i % 2 === 0 ? 1 : -1);
        p.rotation.y += 0.0008 * (i % 3 === 0 ? 1 : -1);
        p.position.y += Math.sin(Date.now() * 0.0005 + i) * 0.001;
        p.position.x += Math.cos(Date.now() * 0.0005 + i) * 0.001;
      });

      group.rotation.y = Math.sin(Date.now() * 0.0001) * 0.03;
      group.rotation.x = Math.cos(Date.now() * 0.0001) * 0.03;

      renderer.render(scene, camera);
    }

    animate();

    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight || 1;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }

  function init() {
    setTimeout(() => {
      initStoryBackground();
    }, 100);
  }

  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', init);
  }

  document.addEventListener('astro:page-load', init);
</script>

