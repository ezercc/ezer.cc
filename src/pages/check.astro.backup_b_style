  @media (max-width: 768px) {
    .industry-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .wordcloud-container {
      height: 380px;
    }

    #industry-wordcloud {
      height: 350px;
    }

    .news-display {
      height: auto;
      min-height: 0;
      overflow: visible;
      background: transparent;
      border: none;
      padding: 0;
      margin-top: 1rem;
    }

    .news-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      position: sticky;
      top: 60px;
      z-index: 9;
      background: var(--color-surface);
      border: 1px solid rgba(var(--rgb-brand-1), 0.15);
      border-radius: 12px;
      margin: 0;
      padding: 0.8rem 1rem;
      box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.08);
      backdrop-filter: blur(12px);
      transition: top 0.3s ease;
    }

    :global(body.is-nav-hidden) .news-header {
      top: 10px;
    }

    .news-header::after {
      content: "";
      width: 8px;
      height: 8px;
      border-right: 2px solid var(--color-brand-1);
      border-bottom: 2px solid var(--color-brand-1);
      transform: rotate(45deg);
      transition: transform 0.3s;
      margin-left: 0.5rem;
      flex-shrink: 0;
    }

    .news-display:not(.is-collapsed) .news-header::after {
      transform: rotate(-135deg);
    }

    .news-display.is-collapsed .news-header {
      border-radius: 12px;
    }

    .news-display:not(.is-collapsed) .news-header {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    .news-display.is-collapsed .news-list {
      display: none !important;
    }

    .news-display:not(.is-collapsed) .news-list {
      display: flex !important;
      background: var(--color-bg-alt);
      border: 1px solid rgba(var(--rgb-brand-1), 0.08);
      border-top: none;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
      padding: 1rem;
    }
  }

  @media (max-width: 640px) {
    .check-page {
      padding-top: 60px;
      padding-left: 0 !important;
      padding-right: 0 !important;
      overflow-x: hidden;
    }
    .u-container {
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
    }
    .results-container {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      gap: 1rem;
    }
    .thought-container {
      border-radius: 0;
      border-left: none;
      border-right: none;
      width: 100vw !important;
    }
    .thought-content {
      padding: 0.75rem;
      width: 100%;
      box-sizing: border-box;
    }
    .thought-grid {
      grid-template-columns: 1fr;
      width: 100%;
    }
    .section-a, .section-b, .section-c {
      grid-column: 1 / 2;
      border-right: none;
      padding-right: 0;
      padding-left: 0;
      width: 100%;
      min-width: 0;
    }
    .section-b {
      border-top: 1px solid rgba(var(--rgb-brand-1), 0.12);
      padding-top: 1.2rem;
      max-height: none;
      min-height: auto;
    }
    .scroll-wrapper-b {
      overflow-y: visible;
      padding-right: 0;
    }
    .section-c {
      max-height: none;
    }
    .col-title {
      margin-left: 0.8rem;
      margin-right: 0.8rem;
    }
    .summary-box {
      margin-left: 0.5rem;
      margin-right: 0.5rem;
      padding: 1.2rem;
    }
  }

  /* ── Chart Styles ── */
  .mini-table {
    margin-bottom: 1.5rem;
