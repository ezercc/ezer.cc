            }
            
            if (idx > 0) {
              sourceListSpan.appendChild(document.createTextNode(', '));
            }
            sourceListSpan.appendChild(refSpan);
          });
          
          sourceContainer.appendChild(sourceListSpan);
          card.appendChild(sourceContainer);
        }
      }
    }

    if ((p === 'C' || p === 'AUDITOR')) {
      if (placeholderC.isActive()) placeholderC.stop();
      const d = data || item.data;
      if (!d) return;

      if (event === 'c_progress') {
        const stepPrefix = lang === 'zh' ? '正在' : 'Analyzing';
        writers.c.writeHTML(`<div class="progress-update"><i>› ${stepPrefix} ${d.task || d.step || (lang === 'zh' ? '执行审计' : 'Performing Audit')}...</i></div>`);
