<script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
<script>
(() => {
  const rows = [{"reporting_period":"2023Q3","revenue":3026309127.2900004,"net_profit":682115099.5700002,"operating_cashflow":287094488.53999996},{"reporting_period":"2023Q4","revenue":3687694099.4300003,"net_profit":877659868.1399999,"operating_cashflow":454406344.48},{"reporting_period":"2024Q1","revenue":4842546924.23,"net_profit":1009266297.74,"operating_cashflow":650503647.23},{"reporting_period":"2024Q2","revenue":5956047261.52,"net_profit":1349154753.68,"operating_cashflow":317597872.72},{"reporting_period":"2024Q3","revenue":6514007634.400002,"net_profit":1394238118.73,"operating_cashflow":347764773.70000005},{"reporting_period":"2024Q4","revenue":6549557918.219997,"net_profit":1418826797.7000003,"operating_cashflow":1848716664.1999998},{"reporting_period":"2025Q1","revenue":6674176487.23,"net_profit":1582876128.67,"operating_cashflow":2164459570.16},{"reporting_period":"2025Q2","revenue":8114898350.57,"net_profit":2412239256.0299997,"operating_cashflow":1054003717.1400003},{"reporting_period":"2025Q3","revenue":10215726013.52,"net_profit":3136817052,"operating_cashflow":2236357940.13},{"reporting_period":"2025Q4","revenue":13235134789.349998,"net_profit":3665321863.750001,"operating_cashflow":5441304932.6},{"reporting_period":"2026Q1","revenue":19496398083.95,"net_profit":5734501526.83,"operating_cashflow":3367573676.62}];
  const toYi = (value) => Number(value || 0) / 100000000;
  const periods = rows.map((row) => row.reporting_period);
  const labels = { revenue: '营业收入', net_profit: '净利润', operating_cashflow: '经营现金流' };
  const palette = { revenue: '#6657c8', net_profit: '#c17843', operating_cashflow: '#8276d4' };
  const axisLabel = { color: '#8190a0', fontFamily: 'IBM Plex Mono, Consolas, monospace', fontSize: 10 };
  const commonGrid = { left: 55, right: 22, top: 42, bottom: 38, containLabel: false };
  const charts = [];
  const tooltip = {
    trigger: 'axis',
    backgroundColor: '#101d31',
    borderWidth: 0,
    textStyle: { color: '#fff', fontSize: 12 },
    axisPointer: { type: 'line', lineStyle: { color: '#9a91e8', width: 1 } },
    formatter(params) {
      const title = params[0]?.axisValue || '';
      return [title].concat(params.map((item) => item.marker + item.seriesName + '：' + Number(item.value).toFixed(2) + ' 亿元')).join('<br/>');
    },
  };
  const lineEl = document.getElementById('financial-trend-chart');
  const line = echarts.init(lineEl, null, { renderer: 'svg' });
  line.setOption({
    animation: false,
    color: [palette.revenue, palette.net_profit],
    grid: commonGrid,
    legend: { top: 4, right: 10, itemWidth: 18, itemHeight: 3, textStyle: { color: '#526274', fontSize: 11 } },
    tooltip,
    xAxis: { type: 'category', data: periods, boundaryGap: false, axisLine: { lineStyle: { color: '#cbd3dc' } }, axisTick: { show: false }, axisLabel: { ...axisLabel, interval: (index) => index % 2 === 0 || index === periods.length - 1 } },
    yAxis: { type: 'value', scale: true, splitNumber: 4, axisLine: { show: false }, axisTick: { show: false }, axisLabel: { ...axisLabel, formatter: (value) => Number(value).toFixed(0) }, splitLine: { lineStyle: { color: '#e5e9ee', type: 'dashed' } } },
    series: [
      { name: labels.revenue, type: 'line', smooth: 0.25, showSymbol: false, data: rows.map((row) => toYi(row.revenue)), lineStyle: { width: 3 }, areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: '#6657c830' }, { offset: 1, color: '#6657c802' }]) }, markPoint: { symbol: 'circle', symbolSize: 9, itemStyle: { color: palette.revenue, borderColor: '#fff', borderWidth: 2 }, label: { show: true, position: 'top', color: '#1b2638', fontSize: 11, formatter: (params) => Number(params.value).toFixed(2) }, data: [{ coord: [periods.at(-1), toYi(rows.at(-1).revenue)], value: toYi(rows.at(-1).revenue) }] } },
      { name: labels.net_profit, type: 'line', smooth: 0.25, showSymbol: false, data: rows.map((row) => toYi(row.net_profit)), lineStyle: { width: 2.5 }, markPoint: { symbol: 'circle', symbolSize: 8, itemStyle: { color: palette.net_profit, borderColor: '#fff', borderWidth: 2 }, label: { show: true, position: 'bottom', color: '#1b2638', fontSize: 11, formatter: (params) => Number(params.value).toFixed(2) }, data: [{ coord: [periods.at(-1), toYi(rows.at(-1).net_profit)], value: toYi(rows.at(-1).net_profit) }] } },
    ],
  });
  charts.push(line);
  const cashEl = document.getElementById('cashflow-chart');
  const cash = echarts.init(cashEl, null, { renderer: 'svg' });
  cash.setOption({
    animation: false,
    grid: { ...commonGrid, top: 25 },
    tooltip: { ...tooltip, trigger: 'axis' },
    xAxis: { type: 'category', data: periods, axisLine: { lineStyle: { color: '#cbd3dc' } }, axisTick: { show: false }, axisLabel: { ...axisLabel, interval: (index) => index % 2 === 0 || index === periods.length - 1 } },
    yAxis: { type: 'value', min: 0, splitNumber: 3, axisLine: { show: false }, axisTick: { show: false }, axisLabel: { ...axisLabel, formatter: (value) => Number(value).toFixed(0) }, splitLine: { lineStyle: { color: '#e5e9ee', type: 'dashed' } } },
    series: [{ name: labels.operating_cashflow, type: 'bar', barMaxWidth: 28, data: rows.map((row) => toYi(row.operating_cashflow)), itemStyle: { color: palette.operating_cashflow, borderRadius: [3, 3, 0, 0] }, emphasis: { itemStyle: { color: '#6657c8' } } }],
  });
  charts.push(cash);
  const resize = () => charts.forEach((chart) => chart.resize());
  window.addEventListener('resize', resize);
  window.addEventListener('beforeprint', () => { resize(); });
})();
</script>
