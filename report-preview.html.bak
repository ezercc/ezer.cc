  <section class="report-page metrics-page">
    <header class="running-head"><span>中际旭创 · 300308.SZ</span><span>2026Q1</span></header>
    <div class="section-index">00 / 财务数据概览</div>
    <h2>归一化财务数据</h2>
    <table class="metric-table"><thead><tr><th>项目</th><th>金额</th></tr></thead><tbody>
      <tr><td>营业收入</td><td>¥19,496,398,083.95</td></tr><tr><td>净利润</td><td>¥5,734,501,526.83</td></tr><tr><td>期末现金及现金等价物</td><td>¥12,176,254,035.58</td></tr><tr><td>经营现金流</td><td>¥3,367,573,676.62</td></tr><tr><td>投资活动产生的现金流量净额</td><td>-¥1,947,791,652.29</td></tr><tr><td>总资产</td><td>¥56,580,677,310.74</td></tr><tr><td>总负债</td><td>¥18,465,774,898.96</td></tr>
    </tbody></table>
