<title>中际旭创 2026Q1</title>
<style>
  :root {
    --navy:#101d31; --ink:#1b2638; --slate:#526274; --faint:#8d9aaa;
    --line:#dce2e9; --paper:#fff; --ground:#e9edf2; --accent:#6657c8;
    --accent-soft:#f0effb; --wash:#f7f8fa; --serif:"Noto Serif SC","Source Han Serif SC",Georgia,serif;
    --sans:"Noto Sans SC","Source Han Sans SC","Microsoft YaHei",sans-serif;
    --mono:"IBM Plex Mono","SFMono-Regular",Consolas,monospace;
  }
  * { box-sizing:border-box; }
  html { background:var(--ground); }
  body { margin:0; color:var(--ink); background:var(--ground); font-family:var(--sans); }
  .viewer { position:sticky; top:0; z-index:5; display:flex; align-items:center; justify-content:space-between; padding:11px 18px; color:#fff; background:var(--navy); box-shadow:0 2px 12px #101d3140; font:600 11px var(--mono); letter-spacing:.08em; }
  .viewer button { padding:7px 11px; border:1px solid #ffffff40; border-radius:3px; color:#fff; background:transparent; font:inherit; cursor:pointer; }
  .viewer button:hover { background:#ffffff14; }
  main { display:grid; gap:24px; padding:30px 16px 56px; }
  .report-page { position:relative; width:min(100%,840px); min-height:1188px; margin:auto; padding:64px 70px 62px; overflow:hidden; background:var(--paper); box-shadow:0 14px 44px #24364a1c; break-after:page; }
  .cover { display:flex; flex-direction:column; justify-content:space-between; padding:72px 70px 64px; color:#fff; background:var(--navy); }
  .cover::before { content:""; position:absolute; width:500px; height:500px; top:135px; right:-250px; border:1px solid #bdb7ff70; border-radius:50%; box-shadow:0 0 0 42px #bdb7ff0c,0 0 0 96px #bdb7ff09; }
  .cover::after { content:""; position:absolute; right:0; bottom:0; left:0; height:190px; background:linear-gradient(115deg,#6657c8b3,#6657c800 68%); clip-path:polygon(0 55%,100% 0,100% 100%,0 100%); }
  .cover-top,.cover-body,.cover-bottom { position:relative; z-index:1; }
  .cover-top { display:flex; justify-content:space-between; align-items:center; font:700 11px var(--mono); letter-spacing:.14em; text-transform:uppercase; }
  .cover-series { color:#bfb9ff; }
  .cover-body { margin-top:135px; }
  .cover-body h1 { max-width:610px; margin:0; font:700 70px/1.08 var(--serif); letter-spacing:-.07em; }
  .cover-body h1 span { display:block; color:#c9c4ff; }
  .cover-ticker { margin:29px 0 0; color:#c8d0db; font:600 16px var(--mono); letter-spacing:.1em; }
  .cover-meta { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; max-width:610px; margin-top:76px; padding-top:17px; border-top:1px solid #ffffff31; }
  .cover-meta span { display:block; color:#aebbc9; font:600 10px var(--mono); letter-spacing:.09em; text-transform:uppercase; }
  .cover-meta strong { display:block; margin-top:7px; color:#fff; font-size:15px; }
  .cover-bottom { display:flex; justify-content:space-between; align-items:end; gap:32px; padding-top:20px; border-top:1px solid #ffffff31; }
  .cover-bottom p { max-width:470px; margin:0; color:#c5ced8; font-size:12px; line-height:1.75; }
  .cover-mark { color:#fff; font:800 17px var(--mono); letter-spacing:.1em; }
  .cover-mark b { color:#c9c4ff; }
  .running-head { display:flex; justify-content:space-between; padding-bottom:15px; border-bottom:1px solid var(--line); color:var(--faint); font:600 10px var(--mono); letter-spacing:.07em; }
  .running-foot { position:absolute; right:70px; bottom:28px; left:70px; display:flex; justify-content:space-between; color:var(--faint); font:10px var(--mono); }
  .section-index { margin-top:49px; color:var(--accent); font:800 11px var(--mono); letter-spacing:.12em; }
  h2 { max-width:650px; margin:11px 0 0; font:700 37px/1.25 var(--serif); letter-spacing:-.05em; }
  .title-rule { width:44px; height:3px; margin:24px 0 0; background:var(--accent); }
  .field { margin-top:20px; padding:16px 18px 17px; border:1px solid var(--line); background:var(--wash); }
  .field--lead { margin-top:29px; padding:21px 23px 22px; border-color:#d8d3fa; border-left:4px solid var(--accent); background:var(--accent-soft); }
  .field-label { color:var(--slate); font:800 10px var(--mono); letter-spacing:.12em; }
  .field p { margin:8px 0 0; font-size:14px; line-height:1.78; }
  .field--lead p { margin-top:10px; font-family:var(--serif); font-size:19px; line-height:1.62; }
  .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px; }
  .detail-grid .field { height:100%; margin:0; }
  .contents-page { padding-top:64px; }
  .contents-title { margin-top:90px; font:700 42px/1.2 var(--serif); letter-spacing:-.05em; }
  .toc { margin-top:43px; border-top:2px solid var(--ink); }
  .toc-row { display:grid; grid-template-columns:34px auto 1fr 30px; gap:13px; align-items:center; padding:16px 0; border-bottom:1px solid var(--line); color:var(--slate); font:12px var(--mono); }
  .toc-row strong { color:var(--ink); font:600 16px var(--sans); }
  .toc-row i { height:1px; background:repeating-linear-gradient(90deg,var(--line) 0 2px,transparent 2px 6px); }
  .metrics-page .section-index { margin-top:48px; }
  .metrics-note { max-width:650px; margin:16px 0 0; color:var(--slate); font-size:13px; line-height:1.75; }
  .metric-table { width:100%; margin-top:30px; border-collapse:collapse; }
  .metric-table th { padding:10px 0; color:var(--faint); border-bottom:1px solid var(--line); text-align:left; font:700 10px var(--mono); letter-spacing:.09em; }
  .metric-table th:last-child,.metric-table td:last-child { text-align:right; }
  .metric-table td { padding:16px 0; border-bottom:1px solid var(--line); font-size:14px; }
  .metric-table td:last-child { font:700 15px var(--mono); }
  .gap-box { margin-top:28px; padding:17px 19px; border-top:3px solid var(--accent); background:var(--wash); }
  .gap-box h3 { margin:0; font-size:13px; }
  .gap-box ul { margin:9px 0 0; padding-left:18px; color:var(--slate); font-size:13px; line-height:1.7; }
  .charts-page h2 { margin-top:11px; }
  .chart-stack { display:grid; gap:25px; margin-top:30px; }
  .echart-figure { margin:0; padding:0 0 12px; border-top:2px solid var(--ink); border-bottom:1px solid var(--line); }
  .echart-head { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:13px 0 0; }
  .echart-head strong { color:var(--ink); font:700 14px var(--sans); }
  .echart-number { margin-right:10px; color:var(--accent); font:800 10px var(--mono); }
  .echart-unit { color:var(--faint); font:10px var(--mono); }
  .echart { width:100%; height:270px; }
  .echart--cashflow { height:235px; }
  .chart-box { padding:0 0 12px; border-top:2px solid var(--ink); border-bottom:1px solid var(--line); background:#fff; }
  .chart-head { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:13px 0 0; color:var(--slate); font:700 10px var(--mono); letter-spacing:.07em; }
  .chart-head > div { display:flex; align-items:center; gap:10px; }
  .chart-head strong { color:var(--ink); font:700 14px var(--sans); letter-spacing:0; }
  .chart-number { color:var(--accent); font:800 10px var(--mono); }
  .chart-legend { display:flex; gap:13px; }
  .chart-legend span { display:flex; align-items:center; gap:5px; color:var(--slate); font:600 11px var(--sans); letter-spacing:0; }
  .chart-legend i { width:8px; height:8px; border-radius:50%; }
  .chart-unit,.chart-note { color:var(--faint); font:10px var(--mono); letter-spacing:.04em; }
  .chart-note { padding-left:58px; }
  .line-chart,.bar-chart { display:block; width:100%; height:auto; margin-top:8px; overflow:visible; }
  .chart-grid-lines line { stroke:#e4e8ed; stroke-width:1; }
  .chart-grid-lines text,.chart-labels text,.chart-bars text { fill:#8190a0; font:9px var(--mono); }
  .chart-end-label { fill:var(--ink); font:700 10px var(--sans); }
  .revenue-area { fill:#6657c8; fill-opacity:.10; }
  .chart-bars rect { fill:#8276d4; }
  .audit-page h2 { margin-top:11px; }
  .audit-page .field--lead { margin-top:29px; }
  @media (max-width:700px) {
    .report-page,.cover { min-height:auto; padding:42px 24px 56px; }
    .cover-body { margin-top:90px; }
    .cover-body h1 { font-size:51px; }
    .cover-meta,.detail-grid { grid-template-columns:1fr; }
    .cover-bottom { display:block; }
    .cover-mark { margin-top:18px; }
    .running-foot { right:24px; left:24px; }
    h2 { font-size:30px; }
    .contents-title { margin-top:55px; }
  }
  @media print {
    @page { size:A4; margin:0; }
    html,body { background:#fff; }
    .viewer { display:none; }
    main { display:block; padding:0; }
    .report-page { width:210mm; min-height:297mm; margin:0; padding:17mm 18mm 16mm; box-shadow:none; }
    .cover { padding:19mm 18mm 17mm; }
    .running-foot { right:18mm; bottom:8mm; left:18mm; }
    .report-page:last-child { break-after:auto; }
  }
</style>
