import { readFile, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';

const root = process.cwd();
const sourcePath = resolve(root, 'src/data/innolight_300308_sz_2026q1_stream_with_i.frontend.json');
const outputPath = resolve(root, process.argv[2] ?? 'report-preview.html');
const source = JSON.parse(await readFile(sourcePath, 'utf8'));

const normalized = source.stream.find((item) => item.event === 'a_normalized')?.data;
const cards = source.stream.filter((item) => item.event === 'b_card').map((item) => item.data);
const challenges = source.stream.filter((item) => item.event === 'c_challenge').map((item) => item.data);
const resolutions = source.stream.filter((item) => item.event === 'c_resolved').map((item) => item.data);

if (!normalized || cards.length === 0) {
  throw new Error('Preview JSON does not contain normalized data or analysis cards.');
}

const escapeHtml = (value) => String(value ?? '')
  .replaceAll('&', '&amp;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;')
  .replaceAll('"', '&quot;')
  .replaceAll("'", '&#039;');

const formatCny = (value) => new Intl.NumberFormat('zh-CN', {
  style: 'currency',
  currency: 'CNY',
  maximumFractionDigits: 2,
}).format(value);

const company = normalized.company;
const fieldLabels = {
  revenue: '营业收入',
  net_profit: '净利润',
  operating_cashflow: '经营现金流',
  total_assets: '总资产',
  total_liabilities: '总负债',
  cash_equivalents: '期末现金及现金等价物',
};
const financialRows = [
  [fieldLabels.revenue, normalized.income_statement.revenue],
  [fieldLabels.net_profit, normalized.income_statement.net_profit],
  [fieldLabels.cash_equivalents, normalized.balance_sheet.cash_equivalents],
  [fieldLabels.operating_cashflow, normalized.cashflow_statement.operating_cashflow],
  ['投资活动产生的现金流量净额', normalized.cashflow_statement.investing_cashflow],
  [fieldLabels.total_assets, normalized.balance_sheet.total_assets],
  [fieldLabels.total_liabilities, normalized.balance_sheet.total_liabilities],
];
const history = [...(normalized.history_12q ?? [])]
  .sort((a, b) => String(a.reporting_period).localeCompare(String(b.reporting_period)));

const chartScale = (values) => {
  const max = Math.max(...values, 0);
  const min = Math.min(...values, 0);
  const span = Math.max(max - min, 1);
  return { min: min - span * 0.08, max: max + span * 0.08 };
};

const renderLineChart = (series) => {
  const width = 690;
  const height = 270;
  const pad = { top: 24, right: 22, bottom: 46, left: 58 };
  const values = series.flatMap((item) => item.values);
  const scale = chartScale(values);
  const x = (index) => pad.left + (index * (width - pad.left - pad.right)) / Math.max(history.length - 1, 1);
  const y = (value) => pad.top + ((scale.max - value) / (scale.max - scale.min)) * (height - pad.top - pad.bottom);
  const ticks = [scale.max, scale.max - (scale.max - scale.min) / 2, scale.min];
  const grid = ticks.map((tick) => `<line x1="${pad.left}" x2="${width - pad.right}" y1="${y(tick).toFixed(1)}" y2="${y(tick).toFixed(1)}"/><text x="${pad.left - 10}" y="${(y(tick) + 4).toFixed(1)}" text-anchor="end">${(tick / 100000000).toFixed(0)}</text>`).join('');
  const labels = history.map((item, index) => (index % 2 === 0 || index === history.length - 1)
    ? `<text x="${x(index).toFixed(1)}" y="${height - 15}" text-anchor="middle">${escapeHtml(item.reporting_period)}</text>`
    : '').join('');
  const area = series[0] ? `<path d="M${x(0).toFixed(1)},${height - pad.bottom} L${series[0].values.map((value, index) => `${x(index).toFixed(1)},${y(value).toFixed(1)}`).join(' L')} L${x(history.length - 1).toFixed(1)},${height - pad.bottom} Z" class="revenue-area"/>` : '';
  const lines = series.map((item) => {
    const points = item.values.map((value, index) => `${x(index).toFixed(1)},${y(value).toFixed(1)}`).join(' ');
    const dots = item.values.map((value, index) => `<circle cx="${x(index).toFixed(1)}" cy="${y(value).toFixed(1)}" r="3.2" fill="${item.color}"><title>${escapeHtml(history[index].reporting_period)} · ${escapeHtml(item.label)}：${escapeHtml((value / 100000000).toFixed(2))}亿元</title></circle>`).join('');
    return `<polyline points="${points}" fill="none" stroke="${item.color}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>${dots}`;
  }).join('');
  const lastLabels = series.map((item, index) => {
    const value = item.values.at(-1);
    return `<text class="chart-end-label" x="${(x(history.length - 1) - 5).toFixed(1)}" y="${(y(value) + (index === 0 ? -10 : 15)).toFixed(1)}" text-anchor="end">${escapeHtml(item.label)} ${escapeHtml((value / 100000000).toFixed(2))}</text>`;
  }).join('');
  const legend = series.map((item) => `<span><i style="background:${item.color}"></i>${escapeHtml(item.label)}</span>`).join('');
  return `<figure class="chart-box"><figcaption class="chart-head"><div><span class="chart-number">图 1</span><strong>营业收入与净利润趋势</strong></div><div class="chart-legend">${legend}</div></figcaption><svg class="line-chart" viewBox="0 0 ${width} ${height}" role="img" aria-label="营业收入与净利润趋势，单位亿元"><g class="chart-grid-lines">${grid}</g>${area}${lines}<g class="chart-labels">${labels}</g>${lastLabels}</svg><div class="chart-note">单位：亿元</div></figure>`;
};

const renderBarChart = () => {
  const width = 690;
  const height = 250;
  const pad = { top: 24, right: 22, bottom: 48, left: 58 };
  const values = history.map((item) => item.operating_cashflow ?? 0);
  const max = Math.max(...values, 0);
  const xStep = (width - pad.left - pad.right) / Math.max(values.length, 1);
  const barWidth = xStep * 0.58;
  const y = (value) => pad.top + ((max - value) / Math.max(max, 1)) * (height - pad.top - pad.bottom);
  const bars = history.map((item, index) => {
    const value = item.operating_cashflow ?? 0;
    const barX = pad.left + index * xStep + (xStep - barWidth) / 2;
    const barY = y(Math.max(value, 0));
    const barH = y(0) - barY;
    const label = index % 2 === 0 || index === history.length - 1
      ? `<text x="${(barX + barWidth / 2).toFixed(1)}" y="${height - 16}" text-anchor="middle">${escapeHtml(item.reporting_period)}</text>`
      : '';
    return `<rect x="${barX.toFixed(1)}" y="${barY.toFixed(1)}" width="${barWidth.toFixed(1)}" height="${Math.max(barH, 0).toFixed(1)}" rx="2"><title>${escapeHtml(item.reporting_period)} · ${fieldLabels.operating_cashflow}：${escapeHtml((value / 100000000).toFixed(2))}亿元</title></rect>${label}`;
  }).join('');
  const grid = [max, max / 2, 0].map((tick) => `<line x1="${pad.left}" x2="${width - pad.right}" y1="${y(tick).toFixed(1)}" y2="${y(tick).toFixed(1)}"/><text x="${pad.left - 10}" y="${(y(tick) + 4).toFixed(1)}" text-anchor="end">${(tick / 100000000).toFixed(0)}</text>`).join('');
  return `<figure class="chart-box"><figcaption class="chart-head"><div><span class="chart-number">图 2</span><strong>经营现金流趋势</strong></div><span class="chart-unit">单位：亿元</span></figcaption><svg class="bar-chart" viewBox="0 0 ${width} ${height}" role="img" aria-label="经营现金流趋势，单位亿元"><g class="chart-grid-lines">${grid}</g><g class="chart-bars">${bars}</g></svg></figure>`;
};

const lineChart = renderLineChart([
  { label: fieldLabels.revenue, color: '#6657c8', values: history.map((item) => item.revenue ?? 0) },
  { label: fieldLabels.net_profit, color: '#c17843', values: history.map((item) => item.net_profit ?? 0) },
]);
const barChart = renderBarChart();
const chartData = JSON.stringify(history.map((item) => ({
  reporting_period: item.reporting_period,
  revenue: item.revenue,
  net_profit: item.net_profit,
  operating_cashflow: item.operating_cashflow,
}))).replaceAll('<', '\\u003c');
const renderField = (label, value, emphasis = false) => value
  ? `<section class="field${emphasis ? ' field--lead' : ''}">
      <div class="field-label">${escapeHtml(label)}</div>
      <p>${escapeHtml(value)}</p>
    </section>`
  : '';

const renderCardPage = (card, index) => `
  <section class="report-page analysis-page" data-page="${String(index + 5).padStart(2, '0')}">
    <header class="running-head"><span>${escapeHtml(company.name)} · ${escapeHtml(company.ticker)}</span><span>${escapeHtml(company.reporting_period)}</span></header>
    <div class="section-index">${String(index + 1).padStart(2, '0')}</div>
    <h2>${escapeHtml(card.title)}</h2>
    <div class="title-rule"></div>
    ${renderField('结论', card.conclusion, true)}
    <div class="detail-grid">
      ${renderField('依据', card.evidence)}
      ${renderField('交叉验证', card.cross_checks)}
      ${renderField('反向观点', card.counterpoints)}
      ${renderField('投资启示', card.investor_implication)}
    </div>
    <footer class="running-foot"><span>预览数据 · 分析卡片</span><span>${String(index + 5).padStart(2, '0')}</span></footer>
  </section>`;

const contents = cards.map((card, index) => `
  <div class="toc-row"><span>${String(index + 1).padStart(2, '0')}</span><strong>${escapeHtml(card.title)}</strong><i></i><span>${String(index + 5).padStart(2, '0')}</span></div>`).join('');

const auditFields = [
  ...challenges.map((item) => renderField(`审计挑战 · ${item.target_card_id} · ${item.severity}`, item.issue, true)),
  ...resolutions.map((item) => renderField(`复核结论 · ${item.target_card_id}`, item.rationale)),
].join('');

const report = `<title>${escapeHtml(company.name)} ${escapeHtml(company.reporting_period)}</title>
<style>
  :root {
    --navy:#101d31; --ink:#1b2638; --slate:#526274; --faint:#8d9aaa;
    --line:#dce2e9; --paper:#fff; --ground:#e9edf2; --accent:#6657c8;
    --accent-soft:#f0effb; --wash:#f7f8fa; --serif:"Noto Serif SC","Source Han Serif SC",Georgia,serif;
    --sans:"Noto Sans SC","Source Han Sans SC","Microsoft YaHei",sans-serif;
    --mono:"IBM Plex Mono","SFMono-Regular",Consolas,monospace;
  }
  * { box-sizing:border-box; }
  html { background:var(--ground); }
  body { margin:0; color:var(--ink); background:var(--ground); font-family:var(--sans); }
  .viewer { position:sticky; top:0; z-index:5; display:flex; align-items:center; justify-content:space-between; padding:11px 18px; color:#fff; background:var(--navy); box-shadow:0 2px 12px #101d3140; font:600 11px var(--mono); letter-spacing:.08em; }
  .viewer button { padding:7px 11px; border:1px solid #ffffff40; border-radius:3px; color:#fff; background:transparent; font:inherit; cursor:pointer; }
  .viewer button:hover { background:#ffffff14; }
  main { display:grid; gap:24px; padding:30px 16px 56px; }
  .report-page { position:relative; width:min(100%,840px); min-height:1188px; margin:auto; padding:64px 70px 62px; overflow:hidden; background:var(--paper); box-shadow:0 14px 44px #24364a1c; break-after:page; }
  .cover { display:flex; flex-direction:column; justify-content:space-between; padding:72px 70px 64px; color:#fff; background:var(--navy); }
  .cover::before { content:""; position:absolute; width:500px; height:500px; top:135px; right:-250px; border:1px solid #bdb7ff70; border-radius:50%; box-shadow:0 0 0 42px #bdb7ff0c,0 0 0 96px #bdb7ff09; }
  .cover::after { content:""; position:absolute; right:0; bottom:0; left:0; height:190px; background:linear-gradient(115deg,#6657c8b3,#6657c800 68%); clip-path:polygon(0 55%,100% 0,100% 100%,0 100%); }
  .cover-top,.cover-body,.cover-bottom { position:relative; z-index:1; }
  .cover-top { display:flex; justify-content:space-between; align-items:center; font:700 11px var(--mono); letter-spacing:.14em; text-transform:uppercase; }
  .cover-series { color:#bfb9ff; }
  .cover-body { margin-top:135px; }
  .cover-body h1 { max-width:610px; margin:0; font:700 70px/1.08 var(--serif); letter-spacing:-.07em; }
  .cover-body h1 span { display:block; color:#c9c4ff; }
  .cover-ticker { margin:29px 0 0; color:#c8d0db; font:600 16px var(--mono); letter-spacing:.1em; }
  .cover-meta { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; max-width:610px; margin-top:76px; padding-top:17px; border-top:1px solid #ffffff31; }
  .cover-meta span { display:block; color:#aebbc9; font:600 10px var(--mono); letter-spacing:.09em; text-transform:uppercase; }
  .cover-meta strong { display:block; margin-top:7px; color:#fff; font-size:15px; }
  .cover-bottom { display:flex; justify-content:space-between; align-items:end; gap:32px; padding-top:20px; border-top:1px solid #ffffff31; }
  .cover-bottom p { max-width:470px; margin:0; color:#c5ced8; font-size:12px; line-height:1.75; }
  .cover-mark { color:#fff; font:800 17px var(--mono); letter-spacing:.1em; }
  .cover-mark b { color:#c9c4ff; }
  .running-head { display:flex; justify-content:space-between; padding-bottom:15px; border-bottom:1px solid var(--line); color:var(--faint); font:600 10px var(--mono); letter-spacing:.07em; }
  .running-foot { position:absolute; right:70px; bottom:28px; left:70px; display:flex; justify-content:space-between; color:var(--faint); font:10px var(--mono); }
  .section-index { margin-top:49px; color:var(--accent); font:800 11px var(--mono); letter-spacing:.12em; }
  h2 { max-width:650px; margin:11px 0 0; font:700 37px/1.25 var(--serif); letter-spacing:-.05em; }
  .title-rule { width:44px; height:3px; margin:24px 0 0; background:var(--accent); }
  .field { margin-top:20px; padding:16px 18px 17px; border:1px solid var(--line); background:var(--wash); }
  .field--lead { margin-top:29px; padding:21px 23px 22px; border-color:#d8d3fa; border-left:4px solid var(--accent); background:var(--accent-soft); }
  .field-label { color:var(--slate); font:800 10px var(--mono); letter-spacing:.12em; }
  .field p { margin:8px 0 0; font-size:14px; line-height:1.78; }
  .field--lead p { margin-top:10px; font-family:var(--serif); font-size:19px; line-height:1.62; }
  .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px; }
  .detail-grid .field { height:100%; margin:0; }
  .contents-page { padding-top:64px; }
  .contents-title { margin-top:90px; font:700 42px/1.2 var(--serif); letter-spacing:-.05em; }
  .toc { margin-top:43px; border-top:2px solid var(--ink); }
  .toc-row { display:grid; grid-template-columns:34px auto 1fr 30px; gap:13px; align-items:center; padding:16px 0; border-bottom:1px solid var(--line); color:var(--slate); font:12px var(--mono); }
  .toc-row strong { color:var(--ink); font:600 16px var(--sans); }
  .toc-row i { height:1px; background:repeating-linear-gradient(90deg,var(--line) 0 2px,transparent 2px 6px); }
  .metrics-page .section-index { margin-top:48px; }
  .metrics-note { max-width:650px; margin:16px 0 0; color:var(--slate); font-size:13px; line-height:1.75; }
  .metric-table { width:100%; margin-top:30px; border-collapse:collapse; }
  .metric-table th { padding:10px 0; color:var(--faint); border-bottom:1px solid var(--line); text-align:left; font:700 10px var(--mono); letter-spacing:.09em; }
  .metric-table th:last-child,.metric-table td:last-child { text-align:right; }
  .metric-table td { padding:16px 0; border-bottom:1px solid var(--line); font-size:14px; }
  .metric-table td:last-child { font:700 15px var(--mono); }
  .gap-box { margin-top:28px; padding:17px 19px; border-top:3px solid var(--accent); background:var(--wash); }
  .gap-box h3 { margin:0; font-size:13px; }
  .gap-box ul { margin:9px 0 0; padding-left:18px; color:var(--slate); font-size:13px; line-height:1.7; }
  .charts-page h2 { margin-top:11px; }
  .chart-stack { display:grid; gap:25px; margin-top:30px; }
  .echart-figure { margin:0; padding:0 0 12px; border-top:2px solid var(--ink); border-bottom:1px solid var(--line); }
  .echart-head { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:13px 0 0; }
  .echart-head strong { color:var(--ink); font:700 14px var(--sans); }
  .echart-number { margin-right:10px; color:var(--accent); font:800 10px var(--mono); }
  .echart-unit { color:var(--faint); font:10px var(--mono); }
  .echart { width:100%; height:270px; }
  .echart--cashflow { height:235px; }
  .chart-box { padding:0 0 12px; border-top:2px solid var(--ink); border-bottom:1px solid var(--line); background:#fff; }
  .chart-head { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:13px 0 0; color:var(--slate); font:700 10px var(--mono); letter-spacing:.07em; }
  .chart-head > div { display:flex; align-items:center; gap:10px; }
  .chart-head strong { color:var(--ink); font:700 14px var(--sans); letter-spacing:0; }
  .chart-number { color:var(--accent); font:800 10px var(--mono); }
  .chart-legend { display:flex; gap:13px; }
  .chart-legend span { display:flex; align-items:center; gap:5px; color:var(--slate); font:600 11px var(--sans); letter-spacing:0; }
  .chart-legend i { width:8px; height:8px; border-radius:50%; }
  .chart-unit,.chart-note { color:var(--faint); font:10px var(--mono); letter-spacing:.04em; }
  .chart-note { padding-left:58px; }
  .line-chart,.bar-chart { display:block; width:100%; height:auto; margin-top:8px; overflow:visible; }
  .chart-grid-lines line { stroke:#e4e8ed; stroke-width:1; }
  .chart-grid-lines text,.chart-labels text,.chart-bars text { fill:#8190a0; font:9px var(--mono); }
  .chart-end-label { fill:var(--ink); font:700 10px var(--sans); }
  .revenue-area { fill:#6657c8; fill-opacity:.10; }
  .chart-bars rect { fill:#8276d4; }
  .audit-page h2 { margin-top:11px; }
  .audit-page .field--lead { margin-top:29px; }
  @media (max-width:700px) {
    .report-page,.cover { min-height:auto; padding:42px 24px 56px; }
    .cover-body { margin-top:90px; }
    .cover-body h1 { font-size:51px; }
    .cover-meta,.detail-grid { grid-template-columns:1fr; }
    .cover-bottom { display:block; }
    .cover-mark { margin-top:18px; }
    .running-foot { right:24px; left:24px; }
    h2 { font-size:30px; }
    .contents-title { margin-top:55px; }
  }
  @media print {
    @page { size:A4; margin:0; }
    html,body { background:#fff; }
    .viewer { display:none; }
    main { display:block; padding:0; }
    .report-page { width:210mm; min-height:297mm; margin:0; padding:17mm 18mm 16mm; box-shadow:none; }
    .cover { padding:19mm 18mm 17mm; }
    .running-foot { right:18mm; bottom:8mm; left:18mm; }
    .report-page:last-child { break-after:auto; }
  }
</style>
<div class="viewer"><span>REPORT PREVIEW</span><button type="button" onclick="window.print()">打印 / 保存 PDF</button></div>
<main>
  <section class="report-page cover">
    <div class="cover-top"><span class="cover-series">Financial Research</span><span>${escapeHtml(company.reporting_period)}</span></div>
    <div class="cover-body">
      <h1>${escapeHtml(company.name)}<span>财务研究报告</span></h1>
      <p class="cover-ticker">${escapeHtml(company.ticker)}</p>
      <div class="cover-meta">
        <div><span>Company</span><strong>${escapeHtml(company.name)}</strong></div>
        <div><span>Ticker</span><strong>${escapeHtml(company.ticker)}</strong></div>
        <div><span>Reporting period</span><strong>${escapeHtml(company.reporting_period)}</strong></div>
      </div>
    </div>
    <div class="cover-bottom"><p>${escapeHtml(company.name)} · ${escapeHtml(company.ticker)} · ${escapeHtml(company.reporting_period)}</p><div class="cover-mark"><b>·</b> EZER</div></div>
  </section>

  <section class="report-page contents-page">
    <header class="running-head"><span>${escapeHtml(company.name)} · ${escapeHtml(company.ticker)}</span><span>${escapeHtml(company.reporting_period)}</span></header>
    <div class="contents-title">目录</div>
    <div class="toc">
      <div class="toc-row"><span>00</span><strong>财务数据概览</strong><i></i><span>03</span></div>
      <div class="toc-row"><span>00</span><strong>历史财务趋势</strong><i></i><span>04</span></div>
      ${contents}
      <div class="toc-row"><span>08</span><strong>审计复核记录</strong><i></i><span>${String(cards.length + 5).padStart(2, '0')}</span></div>
    </div>
    <footer class="running-foot"><span>预览数据</span><span>02</span></footer>
  </section>

  <section class="report-page metrics-page">
    <header class="running-head"><span>${escapeHtml(company.name)} · ${escapeHtml(company.ticker)}</span><span>${escapeHtml(company.reporting_period)}</span></header>
    <div class="section-index">00 / 财务数据概览</div>
    <h2>归一化财务数据</h2>
    <table class="metric-table"><thead><tr><th>项目</th><th>金额</th></tr></thead><tbody>
      ${financialRows.map(([label, value]) => `<tr><td>${escapeHtml(label)}</td><td>${escapeHtml(formatCny(value))}</td></tr>`).join('')}
    </tbody></table>
    <div class="gap-box"><h3>数据缺口</h3><ul>${(normalized.data_gaps ?? []).map((item) => `<li>${escapeHtml(item)}</li>`).join('')}</ul></div>
    <footer class="running-foot"><span>预览数据 · 财务数据</span><span>03</span></footer>
  </section>

  <section class="report-page charts-page">
    <header class="running-head"><span>${escapeHtml(company.name)} · ${escapeHtml(company.ticker)}</span><span>${escapeHtml(company.reporting_period)}</span></header>
    <div class="section-index">00 / 历史财务趋势</div>
    <h2>历史财务趋势</h2>
    <div class="chart-stack">
      <figure class="echart-figure"><figcaption class="echart-head"><div><span class="echart-number">图 1</span><strong>营业收入与净利润趋势</strong></div><span class="echart-unit">单位：亿元</span></figcaption><div id="financial-trend-chart" class="echart" role="img" aria-label="营业收入与净利润趋势图"></div></figure>
      <figure class="echart-figure"><figcaption class="echart-head"><div><span class="echart-number">图 2</span><strong>经营现金流趋势</strong></div><span class="echart-unit">单位：亿元</span></figcaption><div id="cashflow-chart" class="echart echart--cashflow" role="img" aria-label="经营现金流趋势图"></div></figure>
    </div>
    <footer class="running-foot"><span>预览数据 · 历史财务序列</span><span>04</span></footer>
  </section>

  ${cards.map(renderCardPage).join('')}

  <section class="report-page audit-page" data-page="${String(cards.length + 5).padStart(2, '0')}">
    <header class="running-head"><span>${escapeHtml(company.name)} · ${escapeHtml(company.ticker)}</span><span>${escapeHtml(company.reporting_period)}</span></header>
    <div class="section-index">08 / 审计复核记录</div>
    <h2>审计挑战与复核结论</h2>
    <div class="title-rule"></div>
    ${auditFields}
    <footer class="running-foot"><span>预览数据 · 审计复核</span><span>${String(cards.length + 5).padStart(2, '0')}</span></footer>
  </section>
</main>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"></script>
<script>
(() => {
  const rows = ${chartData};
  const toYi = (value) => Number(value || 0) / 100000000;
  const periods = rows.map((row) => row.reporting_period);
  const labels = { revenue: '营业收入', net_profit: '净利润', operating_cashflow: '经营现金流' };
  const palette = { revenue: '#6657c8', net_profit: '#c17843', operating_cashflow: '#8276d4' };
  const axisLabel = { color: '#8190a0', fontFamily: 'IBM Plex Mono, Consolas, monospace', fontSize: 10 };
  const commonGrid = { left: 55, right: 22, top: 42, bottom: 38, containLabel: false };
  const charts = [];
  const tooltip = {
    trigger: 'axis',
    backgroundColor: '#101d31',
    borderWidth: 0,
    textStyle: { color: '#fff', fontSize: 12 },
    axisPointer: { type: 'line', lineStyle: { color: '#9a91e8', width: 1 } },
    formatter(params) {
      const title = params[0]?.axisValue || '';
      return [title].concat(params.map((item) => item.marker + item.seriesName + '：' + Number(item.value).toFixed(2) + ' 亿元')).join('<br/>');
    },
  };
  const lineEl = document.getElementById('financial-trend-chart');
  const line = echarts.init(lineEl, null, { renderer: 'svg' });
  line.setOption({
    animation: false,
    color: [palette.revenue, palette.net_profit],
    grid: commonGrid,
    legend: { top: 4, right: 10, itemWidth: 18, itemHeight: 3, textStyle: { color: '#526274', fontSize: 11 } },
    tooltip,
    xAxis: { type: 'category', data: periods, boundaryGap: false, axisLine: { lineStyle: { color: '#cbd3dc' } }, axisTick: { show: false }, axisLabel: { ...axisLabel, interval: (index) => index % 2 === 0 || index === periods.length - 1 } },
    yAxis: { type: 'value', scale: true, splitNumber: 4, axisLine: { show: false }, axisTick: { show: false }, axisLabel: { ...axisLabel, formatter: (value) => Number(value).toFixed(0) }, splitLine: { lineStyle: { color: '#e5e9ee', type: 'dashed' } } },
    series: [
      { name: labels.revenue, type: 'line', smooth: 0.25, showSymbol: false, data: rows.map((row) => toYi(row.revenue)), lineStyle: { width: 3 }, areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{ offset: 0, color: '#6657c830' }, { offset: 1, color: '#6657c802' }]) }, markPoint: { symbol: 'circle', symbolSize: 9, itemStyle: { color: palette.revenue, borderColor: '#fff', borderWidth: 2 }, label: { show: true, position: 'top', color: '#1b2638', fontSize: 11, formatter: (params) => Number(params.value).toFixed(2) }, data: [{ coord: [periods.at(-1), toYi(rows.at(-1).revenue)], value: toYi(rows.at(-1).revenue) }] } },
      { name: labels.net_profit, type: 'line', smooth: 0.25, showSymbol: false, data: rows.map((row) => toYi(row.net_profit)), lineStyle: { width: 2.5 }, markPoint: { symbol: 'circle', symbolSize: 8, itemStyle: { color: palette.net_profit, borderColor: '#fff', borderWidth: 2 }, label: { show: true, position: 'bottom', color: '#1b2638', fontSize: 11, formatter: (params) => Number(params.value).toFixed(2) }, data: [{ coord: [periods.at(-1), toYi(rows.at(-1).net_profit)], value: toYi(rows.at(-1).net_profit) }] } },
    ],
  });
  charts.push(line);
  const cashEl = document.getElementById('cashflow-chart');
  const cash = echarts.init(cashEl, null, { renderer: 'svg' });
  cash.setOption({
    animation: false,
    grid: { ...commonGrid, top: 25 },
    tooltip: { ...tooltip, trigger: 'axis' },
    xAxis: { type: 'category', data: periods, axisLine: { lineStyle: { color: '#cbd3dc' } }, axisTick: { show: false }, axisLabel: { ...axisLabel, interval: (index) => index % 2 === 0 || index === periods.length - 1 } },
    yAxis: { type: 'value', min: 0, splitNumber: 3, axisLine: { show: false }, axisTick: { show: false }, axisLabel: { ...axisLabel, formatter: (value) => Number(value).toFixed(0) }, splitLine: { lineStyle: { color: '#e5e9ee', type: 'dashed' } } },
    series: [{ name: labels.operating_cashflow, type: 'bar', barMaxWidth: 28, data: rows.map((row) => toYi(row.operating_cashflow)), itemStyle: { color: palette.operating_cashflow, borderRadius: [3, 3, 0, 0] }, emphasis: { itemStyle: { color: '#6657c8' } } }],
  });
  charts.push(cash);
  const resize = () => charts.forEach((chart) => chart.resize());
  window.addEventListener('resize', resize);
  window.addEventListener('beforeprint', () => { resize(); });
})();
</script>
`;

await writeFile(outputPath, report, 'utf8');
console.log(`Generated ${outputPath} from ${sourcePath}: ${cards.length} cards, ${challenges.length} challenges, ${resolutions.length} resolutions.`);
